+    /// <summary>
+    /// True when an external-assembly method's AOT stub is KNOWN to throw the
+    /// same managed exception as its managed peer (so [UNVERIFIED] skip is
+    /// unnecessary — Assert.Throws will catch it at runtime).
+    /// </summary>
+    /// <remarks>
+    /// D (json-xml-production-readiness): The codegen catch-all in
+    /// ExternalRuntimeHelpers.cs now emits RaiseManagedException for
+    /// JsonMetadataServices.Create*Info, matching the managed NotSupportedException.
+    /// Add other families here as the catch-all is extended.
+    /// </remarks>
+    private static bool ExternalStubRaisesManagedException(MethodSignature method)
+    {
+        var dt = method.DeclaringTypeFullName;
+        if (dt?.Contains("System.Text.Json.Serialization.Metadata.JsonMetadataServices") == true
+            && method.Name is "CreateArrayInfo" or "CreateListInfo"
+               or "CreateDictionaryInfo" or "CreateImmutableDictionaryInfo"
+               or "CreateIDictionaryInfo" or "CreateIReadOnlyDictionaryInfo"
+               or "CreateICollectionInfo" or "CreateIListInfo" or "CreateISetInfo"
+               or "CreateIAsyncEnumerableInfo")
+            return true;
+        return false;
+    }
