          "AOT vs JIT 对比": "dev-il2cpp-foundation-dll-optimizer"
        },
        "execution_order": [
          "foundation-dll-optimizer 先量化数据，gc-expert 随后做针对性优化"
        ],
        "mixed_domain": [
          "GC + 优化 → optimizer 先出数据，gc-expert 后优化"
        ]
      }
    },
