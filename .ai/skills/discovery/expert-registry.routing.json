      ],
      "domains": [
        4,
        5,
        6,
        7,
        8,
        9,
        10,
        11
      ],
      "routing_strategy": {
        "task_type": {
          "IL 翻译路径设计/Planner/Emission": "dev-il2cpp-translation-expert",
