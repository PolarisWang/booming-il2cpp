          "PatchLoader/patchdata/HotpatchDispatch": "dev-il2cpp-hotupdate-expert",
          "跨平台 PAL/CMakePresets": "dev-il2cpp-platform-expert",
          "ABI 类型映射/调用约定": "dev-il2cpp-abi-expert",
          "extern stub/ShapeRegistry": "dev-il2cpp-external-runtime-expert",
          "缓存策略/SDK 路径": "dev-il2cpp-pipeline-expert",
          "SIMD/Intrinsics": "dev-il2cpp-simd-expert",
          "codegen 能力矩阵/特性列表": "dev-il2cpp-codegen-capabilities",
          "测试管线治理/验证 gate": "dev-il2cpp-verification-pipeline",
          "AutoTestGenerator/ATG/AutoTest/subject 生成": "dev-il2cpp-atg-expert"
        },
        "execution_order": [
          "translation-expert 在前，codegen-expert 在后（两者都涉及 Planner/Emission 文件）"
        ],
        "mixed_domain": [
          "翻译+CodeGen → translation-expert 先做路径设计，codegen-expert 后做代码生成",
          "构建+CodeGen → build-fixer 先诊断分层，如问题在 CodeGen 层则转 codegen-expert",
          "测试+CodeGen → fact-verification-expert 审查 codegen 输出",
          "热更新+CodeGen → hotupdate-expert 改完 PatchLoader，codegen-expert 更新 PatchDataExtractor"
        ]
      }
