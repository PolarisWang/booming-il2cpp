diff --git a/src/native/runtime-core/runtime_stubs/math_stubs.cpp b/src/native/runtime-core/runtime_stubs/math_stubs.cpp
index 13a05a772..aa99cab47 100644
--- a/src/native/runtime-core/runtime_stubs/math_stubs.cpp
