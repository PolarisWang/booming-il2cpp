{
  "group": "quick-start",
  "commands": [
    {
      "id": "menu",
      "title": "Show the interactive menu",
      "group": "Quick Start",
      "handler": "inspect.menu",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["menu"],
      "show_in_menu": false,
      "examples": ["run menu"]
    },
    {
      "id": "list",
      "title": "List available capabilities",
      "group": "Quick Start",
      "handler": "inspect.list",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["list"],
      "show_in_menu": true,
      "examples": ["run list", "run list --json"]
    },
    {
      "id": "doctor",
      "title": "Check the currently available local toolchain",
      "group": "Quick Start",
      "handler": "doctor.dispatch",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["doctor"],
      "show_in_menu": true,
      "examples": ["run doctor", "run doctor --json"]
    },
    {
      "id": "convert-subject",
      "title": "Convert a subject's C# source to native code",
      "group": "Quick Start",
      "handler": "project.dispatch",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["convert", "subject"],
      "kind": "il2cpp-convert",
      "syntax": "convert subject --id <SubjectId> [--output <dir>]",
      "show_in_menu": true,
      "examples": ["run convert subject --id HelloWorldObject"]
    },
    {
      "id": "generate-all",
      "title": "Generate all project workspaces",
      "group": "Quick Start",
      "handler": "project.dispatch",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["generate", "project", "all"],
      "kind": "all-workspaces",
      "show_in_menu": true,
      "examples": ["run generate project all"]
    }
  ]
}
