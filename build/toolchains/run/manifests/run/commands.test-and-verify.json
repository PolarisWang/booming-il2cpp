{
  "group": "test-and-verify",
  "commands": [
    {
      "id": "benchmark-record",
      "title": "Run benchmark and record result",
      "group": "Test And Verify",
      "handler": "benchmark.dispatch",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["benchmark"],
      "syntax": "benchmark [--subject <id>] [--all] [--mode <mode>] [--record] [--dashboard] [--open]",
      "show_in_menu": true,
      "examples": [
        "run benchmark --subject SolutionCorePack --mode native --record",
        "run benchmark --all --record",
        "run benchmark --dashboard --open",
        "run benchmark status --all"
      ]
    },
    {
      "id": "test-suite",
      "title": "Run a suite by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "suite"
      ],
      "syntax": "test suite (--id <family/suite> | --family <family> --suite <suite>)",
      "show_in_menu": true,
      "examples": [
        "run test suite --id smoke/managed-entry-basic",
        "run test suite --family smoke --suite managed-entry-basic"
      ]
    },
    {
      "id": "test-subject",
      "title": "Run a subject by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "test",
        "subject"
      ],
      "syntax": "test subject --id subject/<subject>",
      "show_in_menu": true,
      "examples": [
        "run test subject --id subject/<subject-id>"
      ]
    },
