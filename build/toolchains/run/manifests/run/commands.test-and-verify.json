{
  "group": "test-and-verify",
  "commands": [
    {
      "id": "benchmark-record",
      "title": "Run benchmark and record result",
      "group": "Test And Verify",
      "handler": "benchmark.dispatch",
      "platforms": ["windows", "macos", "linux"],
      "tokens": ["benchmark"],
      "syntax": "benchmark [--subject <id>] [--all] [--mode <mode>] [--record] [--dashboard] [--open]",
      "show_in_menu": true,
      "examples": [
        "run benchmark --subject SolutionCorePack --mode native --record",
        "run benchmark --all --record",
        "run benchmark --dashboard --open",
        "run benchmark status --all"
      ]
    },
    {
      "id": "stress-test",
      "title": "Run pressure/stress tests with history, comparison, and regression detection",
      "group": "Test And Verify",
      "handler": "stress.dispatch",
      "platforms": ["windows"],
      "pass_through": true,
      "tokens": ["stress"],
      "syntax": "stress <test-name> [--quick] [--record] [--json] [--build]",
      "show_in_menu": true,
      "examples": [
        "run stress gc-stress --quick --record --json",
        "run stress gc-stress-mode --mode 1 --record",
        "run stress list",
        "run stress status",
        "run stress history gc-stress"
      ]
    },
    {
      "id": "test-suite",
      "title": "Run a suite by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "suite"
      ],
      "syntax": "test suite (--id <family/suite> | --family <family> --suite <suite>)",
      "show_in_menu": true,
      "examples": [
        "run test suite --id smoke/managed-entry-basic",
        "run test suite --family smoke --suite managed-entry-basic"
      ]
    },
    {
      "id": "test-subject",
      "title": "Run a subject by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "test",
        "subject"
      ],
      "syntax": "test subject --id subject/<subject>",
      "show_in_menu": true,
      "examples": [
        "run test subject --id subject/<subject-id>"
      ]
    },
    {
      "id": "test-engineering-validation",
      "title": "Run a subject engineering validation by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "test",
        "engineering-validation"
      ],
      "syntax": "test engineering-validation (--id engineering-validation/<subject>/<kind> | --subject <subject> --kind <kind>)",
      "show_in_menu": true,
      "examples": [
        "run test engineering-validation --id engineering-validation/SolutionCorePack/project-graph",
        "run test engineering-validation --subject SolutionCorePack --kind project-graph"
      ]
    },
    {
      "id": "test-engineering-workload",
      "title": "Run a subject engineering workload by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "test",
        "engineering-workload"
      ],
      "syntax": "test engineering-workload (--id engineering-workload/<subject>/<kind> | --subject <subject> --kind <kind>)",
      "show_in_menu": true,
      "examples": [
        "run test engineering-workload --id engineering-workload/SolutionCorePack/codegen",
        "run test engineering-workload --subject SolutionCorePack --kind codegen"
      ]
    },
    {
      "id": "test-declared-unit-test",
      "title": "Run a declared unit test by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "test",
        "declared-unit-test"
      ],
      "syntax": "test declared-unit-test --id declared-unit-test/<stable-id>",
      "show_in_menu": true,
      "examples": [
        "run test declared-unit-test --id declared-unit-test/SolutionCorePack::CoreRuntimeFeatures::CoreRuntimeFeatures.ArrayOpsProofEntry::Run()"
      ]
    },
    {
      "id": "test-declared-benchmark",
      "title": "Run a declared benchmark by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "test",
        "declared-benchmark"
      ],
      "syntax": "test declared-benchmark --id declared-benchmark/<stable-id>",
      "show_in_menu": true,
      "examples": [
        "run test declared-benchmark --id declared-benchmark/SolutionCorePack::CoreRuntimeBenchmarks::CoreRuntimeBenchmarks.GenericBenchmarkEntry::RunWorkload()"
      ]
    },
    {
      "id": "test-module",
      "title": "Run a module verification by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "module"
      ],
      "syntax": "test module (--id module/<module>/<profile> | --module <module> --profile <profile>)",
      "show_in_menu": true,
      "examples": [
        "run test module --id module/managed-smoke/basic",
        "run test module --module managed-smoke --profile basic"
      ]
    },
    {
      "id": "test-system",
      "title": "Run a system validation scenario by selector or object id",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "system"
      ],
      "syntax": "test system (--id system/<scenario> | --scenario <scenario>)",
      "show_in_menu": true,
      "examples": [
        "run test system --id system/hosted-runtime-smoke",
        "run test system --scenario hosted-runtime-smoke"
      ]
    },
    {
      "id": "test-inventory",
      "title": "Generate the unified testing inventory authority reports",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "public": false,
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "inventory"
      ],
      "syntax": "test inventory [--output <dir>]",
      "show_in_menu": false,
      "examples": [
        "run test inventory",
        "run test inventory --output verification/projections/testing-inventory"
      ]
    },
    {
      "id": "verify-verification-v1",
      "title": "Refresh and validate verification-v1 formal outputs",
      "group": "Test And Verify",
      "handler": "verify.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "verify",
        "verification-v1"
      ],
      "target": "verification-v1",
      "syntax": "verify verification-v1 [--output <dir>]",
      "show_in_menu": true,
      "examples": [
        "run verify verification-v1",
        "run verify verification-v1 --output verification/projections/testing-inventory"
      ]
    },
    {
      "id": "foundation-dll-derive",
      "title": "Derive a candidate foundation DLL denominator ledger",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "derive"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll derive [--scope <all|assembly>]",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll derive",
        "run foundation-dll derive --scope System.Text.Json"
      ]
    },
    {
      "id": "foundation-dll-analyze-gaps",
      "title": "Analyze capability-family test-code gaps",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "analyze-gaps"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll analyze-gaps [--scope <all|assembly|family-id>] [--update-ledger true]",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll analyze-gaps",
        "run foundation-dll analyze-gaps --scope System.Private.CoreLib --update-ledger true"
      ]
    },
    {
      "id": "foundation-dll-check-family",
      "title": "Check test-code gap state for a single capability family",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "check-family"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll check-family --family <family-id>",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll check-family --family family/System.Private.CoreLib/convert/char"
      ]
    },
    {
      "id": "foundation-dll-execute",
      "title": "Execute a generated foundation-dll family entry",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "execute"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll execute --assembly <assembly> --family <family-id> --kind <test|native|benchmark|host|patch>",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll execute --assembly System.Private.CoreLib --family family/System.Private.CoreLib/convert/char --kind test"
      ]
    },
    {
      "id": "foundation-dll-promote",
      "title": "Promote candidate denominator ledger to formal authority",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "promote"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll promote [--scope <all|assembly>] --promote-approved true",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll promote --scope System.Text.Json --promote-approved true",
        "run foundation-dll promote --scope all --promote-approved true"
      ]
    },
    {
      "id": "foundation-dll-onboard",
      "title": "Onboard a DLL into the foundation-dll denominator and refresh reports",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "onboard"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll onboard --scope <assembly> --promote-approved true [--mode <quick|full>]",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll onboard --scope System.Text.Json --promote-approved true",
        "run foundation-dll onboard --scope System.Collections.Immutable --promote-approved true --mode full"
      ]
    },
    {
      "id": "foundation-dll-refresh",
      "title": "Refresh foundation DLL projections and docs from the formal ledger",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "refresh"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll refresh",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll refresh"
      ]
    },
    {
      "id": "foundation-dll-verify-consistency",
      "title": "Verify foundation DLL projection/docs consistency",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "verify-consistency"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll verify-consistency [--mode <quick|full>]",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll verify-consistency",
        "run foundation-dll verify-consistency --mode full"
      ]
    },
    {
      "id": "foundation-dll-full",
      "title": "Run derive, promote, refresh and consistency for foundation DLL reporting",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "foundation-dll",
        "full"
      ],
      "target": "foundation-dll",
      "syntax": "foundation-dll full [--scope <all|assembly>] --promote-approved true [--mode <quick|full>]",
      "show_in_menu": false,
      "examples": [
        "run foundation-dll full --scope all --promote-approved true --mode full"
      ]
    },
    {
      "id": "foundation-dll-verify-family",
      "title": "Run full 7-stage verification pipeline for a foundation DLL family",
      "group": "Test And Verify",
      "handler": "foundation_dll.dispatch",
      "platforms": ["windows"],
      "tokens": ["foundation-dll", "verify-family"],
      "target": "foundation-dll",
      "syntax": "foundation-dll verify-family --family <family-slug> [--assembly <assembly>] [--mode <standard|strict>] [--skip <stages>]",
      "show_in_menu": true,
      "examples": [
        "run foundation-dll verify-family convert-char",
        "run foundation-dll verify-family convert-char --mode strict",
        "run foundation-dll verify-family buffer-memory --skip benchmark hotupdate"
      ]
    },
