    {
      "id": "test-smoke-helloworld",
      "title": "Run the HelloWorld managed smoke test",
      "group": "Test And Verify",
      "handler": "test.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "smoke",
        "HelloWorld"
      ],
      "kind": "smoke-run",
      "target": "HelloWorld",
      "project_path": "subjects/HelloWorld/source/HelloWorld.csproj",
      "dll_path": "artifacts/smoke/bin/HelloWorld/Release/net8.0/HelloWorld.dll",
      "expected_patterns": [
        "HelloWorld smoke entry reached.",
        "register:Main"
      ],
      "show_in_menu": false,
      "public": false,
      "replacement_syntax": "test smoke HelloWorld",
      "examples": [
        "run test smoke HelloWorld"
      ]
    },
