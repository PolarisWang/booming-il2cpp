        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "test",
        "suite"
      ],
      "syntax": "test suite (--id <family/suite> | --family <family> --suite <suite>)",
      "show_in_menu": true,
      "examples": [
        "run test suite --id smoke/HelloWorld",
        "run test suite --family smoke --suite HelloWorld"
      ]
    },
