{
  "group": "project-and-ide",
  "commands": [
    {
      "id": "generate-project-all",
      "title": "Generate all solutions for the current host",
      "group": "Project And IDE",
      "handler": "project.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "generate",
        "project",
        "all"
      ],
      "syntax": "generate project all [--host windows|macos|linux] [--refresh-generated]",
      "kind": "all-workspaces",
      "show_in_menu": true,
      "examples": [
        "run generate project all --host windows --refresh-generated"
      ]
    },
    {
      "id": "generate-project-subject",
      "title": "Generate a subject debug workspace",
      "group": "Project And IDE",
      "handler": "project.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "generate",
        "project",
        "subject"
      ],
      "syntax": "generate project subject --id subject/<subject-id> [--matrix <matrix-id>] [--all-targets] [--variant CHECK|PROFILE|SHIP] [--refresh-generated] [--open-native-target generated|proof]",
      "kind": "subject-workspace",
      "show_in_menu": true,
      "examples": [
        "run generate project subject --id subject/SolutionCorePack"
      ]
    },
    {
      "id": "generate-project-core",
      "title": "Generate a core debug workspace",
      "group": "Project And IDE",
      "handler": "project.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "generate",
        "project",
        "core"
      ],
      "syntax": "generate project core [--host windows|macos|linux] [--target <target-id>] [--all-targets]",
      "kind": "core-workspace",
      "show_in_menu": true,
      "examples": [
        "run generate project core --host windows --all-targets"
      ]
    },
    {
      "id": "build-project-subject",
      "title": "Build a generated subject workspace",
      "group": "Project And IDE",
      "handler": "build.dispatch",
      "platforms": [
        "windows"
      ],
      "tokens": [
        "build",
        "project",
        "subject"
      ],
      "syntax": "build project subject --id subject/<subject-id> [--matrix <matrix-id>] [--all-targets] [--native-target generated|proof]",
      "kind": "project-workspace",
      "project_kind": "subject",
      "show_in_menu": true,
      "examples": [
        "run build project subject --id subject/SolutionCorePack"
      ]
    },
    {
      "id": "build-project-core",
      "title": "Build a generated core workspace",
      "group": "Project And IDE",
      "handler": "build.dispatch",
      "platforms": [
        "windows",
        "macos",
        "linux"
      ],
      "tokens": [
        "build",
        "project",
        "core"
      ],
      "syntax": "build project core [--host windows|macos|linux] [--target <target-id>] [--all-targets]",
      "kind": "project-workspace",
      "project_kind": "core",
      "show_in_menu": true,
      "examples": [
        "run build project core --host windows --target windows-x64-reference"
      ]
    }
  ]
}
