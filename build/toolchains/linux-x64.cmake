set(ROADMAP0_TARGET_NAME "linux-x64" CACHE STRING "Roadmap 0 target id")
if(ROADMAP0_TOOLCHAIN_VALIDATE_ONLY)
  set(ROADMAP0_TOOLCHAIN_VALIDATE_ONLY ON CACHE BOOL "Validate preset routing without real Linux sysroot")
  return()
endif()

set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(ROADMAP0_PLATFORM_GATE "linux-packaging" CACHE STRING "Roadmap 0 gate id")

if(DEFINED ENV{ROADMAP0_LINUX_SYSROOT} AND NOT DEFINED CMAKE_SYSROOT)
  file(TO_CMAKE_PATH "$ENV{ROADMAP0_LINUX_SYSROOT}" ROADMAP0_LINUX_SYSROOT)
  set(CMAKE_SYSROOT "${ROADMAP0_LINUX_SYSROOT}" CACHE PATH "Linux sysroot")
endif()
