	cd /home/debian/agent/booming-il2cpp/testing/foundation-dll && $(MAKE) $(MAKESILENT) -f src/native/hot-update/CMakeFiles/test_method_replacement_smoke.dir/build.make src/native/hot-update/CMakeFiles/test_method_replacement_smoke.dir/method_replacement_smoke_test.cpp.s
.PHONY : method_replacement_smoke_test.cpp.s

