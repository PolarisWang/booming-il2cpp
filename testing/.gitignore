# Build outputs
build/
bin/
obj/

# Managed build output (prebuilt assemblies, regenerated by pipeline)
foundation-dll/**/build-output/

# Codegen input prebuilt DLLs (managed assemblies fed into codegen)
foundation-dll/**/codegen/_subjects_input/

# Pipeline-generated reports (regenerated on every run)
foundation-dll/**/reports_generated/

# Native test binaries (regenerated by pipeline)
foundation-dll/**/*.exe

# CTest auto-generated outputs
Testing/Temporary/

# Test results
results/

# Shell redirect artifacts (e.g. D:test_out.txt from cmd > redirect)
D:test_out.txt

# CLI argument parsing artifacts (e.g. --assembly interpreted as path)
--assembly/

# Verification catalog (migrated to artifact/ — leftover from move)
verification-catalog/

# IDE
.vs/
*.suo
*.user
*.sln.docstates

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
