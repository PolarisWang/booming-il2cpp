#!/bin/sh
# Chaos IL2CPP — Pre-commit hook: architecture compliance + foundation DLL pipeline + trace check
#
# Runs:
#   1. build/check_arch.py on staged native C++ files
#   2. tests/e2e/verification/preflight/check_layer_boundaries.py on staged Python (4-layer compliance)
#   3. CHAOS_IL2CPP_LOG_TRACE() / CHAOS_IL2CPP_LOG_*() coverage check on staged .cpp files (advisory)
#
# To install: git config core.hooksPath .githooks
# You can skip this check with: git commit --no-verify

# Audit log (NOT committed to the repo): each hook invocation is recorded with a
# timestamp + result to .git/chaos-hooks.log so you can audit which runs happened.
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo .git)
HOOK_LOG="$GIT_DIR/chaos-hooks.log"
PRE_COMMIT_RC=0
hook_log() { printf '%s  pre-commit  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$HOOK_LOG" 2>/dev/null || true; }
trap 'hook_log "exit=$?"' 0

hook_log "start: $(git log -1 --format=%h 2>/dev/null || echo none)"
echo "=== [check_arch] Checking native architecture compliance ==="

STAGED_CPP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/native/.*\.(cpp|h)$' || true)

if [ -z "$STAGED_CPP" ]; then
    echo "=== [check_arch] No native C++ files staged, skipping ==="
else
    HAS_ERROR=0
    for FILE in $STAGED_CPP; do
        OUTPUT=$(python build/check_arch.py --file "$FILE" 2>&1)
        if echo "$OUTPUT" | grep -q "architecture issue"; then
            echo "$OUTPUT"
            HAS_ERROR=1
        fi
    done
    if [ "$HAS_ERROR" -ne 0 ]; then
        echo ""
        echo "ERROR: Architecture check failed for staged native files."
        echo "Fix the issues above or use 'git commit --no-verify' to bypass."
        exit 1
    fi
    echo "=== [check_arch] All staged native files pass architecture checks ==="
fi

echo "=== [trace] Checking trace point coverage in staged C++ files ==="

STAGED_CPP_TRACE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/native/.*\.cpp' || true)

if [ -z "$STAGED_CPP_TRACE" ]; then
    echo "=== [trace] No staged .cpp files, skipping ==="
else
    MISSING_TRACE=0
    for FILE in $STAGED_CPP_TRACE; do
        HAS_TRACE=$(grep -cE "(CHAOS_IL2CPP_LOG_TRACE|CHAOS_IL2CPP_LOG_(ERROR|WARN|INFO|DEBUG))" "$FILE" || true)
        if [ "$HAS_TRACE" -eq 0 ]; then
            echo "WARNING: $FILE has no CHAOS_IL2CPP_LOG_TRACE/LOG_*() calls — add trace points or confirm they are not needed"
            MISSING_TRACE=1
        fi
    done
    if [ "$MISSING_TRACE" -ne 0 ]; then
        echo "=== [trace] Trace coverage advisory issued ==="
    else
        echo "=== [trace] All staged .cpp files have CHAOS_IL2CPP_LOG_TRACE/LOG_*() ==="
    fi
fi

echo "=== [layer-boundary] Checking 4-layer architecture compliance ==="

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)

if [ -z "$STAGED_PY" ]; then
    echo "=== [layer-boundary] No Python files staged, skipping ==="
else
    # Run the boundary check script
    BOUNDARY_OUTPUT=$(python tests/e2e/verification/preflight/check_layer_boundaries.py 2>&1 | cat)
    echo "$BOUNDARY_OUTPUT"
    if echo "$BOUNDARY_OUTPUT" | grep -q "FAIL"; then
        echo ""
        echo "ERROR: Layer boundary check FAILED. Fix violations or add BOUNDARY_OVERRIDE."
        echo "Use 'git commit --no-verify' to bypass (not recommended)."
        exit 1
    fi
    echo "=== [layer-boundary] All staged files pass layer boundary checks ==="
fi

echo "=== [workaround-gate] Checking workaround / override bans (方案 B) ==="
WRO_OUTPUT=$(python tests/e2e/verification/preflight/check_workarounds.py 2>&1 | cat)
echo "$WRO_OUTPUT"
if echo "$WRO_OUTPUT" | grep -q "FAIL"; then
    echo ""
    echo "ERROR: workaround/override gate FAILED. Root-fix the masked workaround, or"
    echo "annotate a harmless robustness fallback (# FALLBACK_KIND: robust) or a"
    echo "temporary capped workaround (# FALLBACK_KIND: workaround + # WRO: EXPIRES)."
    echo "Permanent workarounds and masked-success returns are banned."
    echo "Use 'git commit --no-verify' to bypass (not recommended)."
    exit 1
fi
echo "=== [workaround-gate] All staged files pass workaround/override checks ==="

echo "=== [gate] Deterministic severe-issue gates (secrets / artifacts / large files) ==="

GATE_FAILED=0

# (a) secrets / credentials accidentally staged
SECRET_HITS=$(git diff --cached | grep -iE \
    'AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36,}|BEGIN (RSA|OPENSSH|EC) PRIVATE KEY|password[[:space:]]*[=:][[:space:]]*["'"'"'][^"'"'"']{6,}' | head -5)
if [ -n "$SECRET_HITS" ]; then
    echo "ERROR: possible secret/credential staged:"
    echo "$SECRET_HITS"
    GATE_FAILED=1
fi

# (b) build artifacts accidentally staged (4-layer redline: only legit referenced
#     .dll under src/dll, crypto-refs, third_party/mono.cecil are allowed)
ARTIFACTS=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(dll|o|obj|a|lib|pdb|so|ilk|exe)$' \
    | grep -vE '^src/dll/|^tests/e2e/translation/crypto-refs/|^third_party/mono\.cecil/' || true)
if [ -n "$ARTIFACTS" ]; then
    echo "ERROR: build artifacts staged (4-layer redline):"
    echo "$ARTIFACTS"
    GATE_FAILED=1
fi

# (c) large file (>5MB) staged — likely accidental binary
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
    size=$(git cat-file -s :"$f" 2>/dev/null || echo 0)
    if [ "$size" -gt 5242880 ]; then
        echo "ERROR: $f is $((size/1048576))MB (>5MB) — likely shouldn't be committed"
        GATE_FAILED=1
    fi
done

if [ "$GATE_FAILED" -ne 0 ]; then
    echo ""
    echo "ERROR: severe-issue gate failed. Fix the above or use 'git commit --no-verify' to bypass (not recommended)."
    exit 1
fi
echo "=== [gate] Deterministic gates passed ==="

echo "=== [repo-clean] Checking repo-root cleanliness (build artifacts / stray files) ==="
if ! python scripts/cleanliness/check_repo_clean.py --hard; then
    echo ""
    echo "ERROR: repo-root cleanliness guard FAILED. Keep the repo root for source."
    echo "Move/ignore/commit stray files before committing."
    echo "Use 'git commit --no-verify' to bypass (not recommended)."
    exit 1
fi
echo "=== [repo-clean] Repo root is clean ==="

echo "=== [generated-drift] Checking committed generated artifacts match their generators (hermetic) ==="
if python scripts/cleanliness/check_generated_up_to_date.py; then
    echo "=== [generated-drift] Ok ==="
else
    echo "=== [generated-drift] Generated-file drift flagged above (pre-existing drift is warn-only; CI --fail-fast enforces) ==="
fi

exit 0
