#!/bin/sh
# Chaos IL2CPP — Pre-commit hook: architecture compliance + foundation DLL pipeline + trace check
#
# Runs:
#   1. build/check_arch.py on staged native C++ files
#   2. testing/.../preflight/check_layer_boundaries.py on staged Python (4-layer compliance)
#   3. CHAOS_IL2CPP_LOG_TRACE() / CHAOS_IL2CPP_LOG_*() coverage check on staged .cpp files (advisory)
#
# To install: git config core.hooksPath .githooks
# You can skip this check with: git commit --no-verify

echo "=== [check_arch] Checking native architecture compliance ==="

STAGED_CPP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/native/.*\.(cpp|h)$' || true)

if [ -z "$STAGED_CPP" ]; then
    echo "=== [check_arch] No native C++ files staged, skipping ==="
else
    HAS_ERROR=0
    for FILE in $STAGED_CPP; do
        OUTPUT=$(python build/check_arch.py --file "$FILE" 2>&1)
        if echo "$OUTPUT" | grep -q "architecture issue"; then
            echo "$OUTPUT"
            HAS_ERROR=1
        fi
    done
    if [ "$HAS_ERROR" -ne 0 ]; then
        echo ""
        echo "ERROR: Architecture check failed for staged native files."
        echo "Fix the issues above or use 'git commit --no-verify' to bypass."
        exit 1
    fi
    echo "=== [check_arch] All staged native files pass architecture checks ==="
fi

echo "=== [trace] Checking trace point coverage in staged C++ files ==="

STAGED_CPP_TRACE=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^src/native/.*\.cpp' || true)

if [ -z "$STAGED_CPP_TRACE" ]; then
    echo "=== [trace] No staged .cpp files, skipping ==="
else
    MISSING_TRACE=0
    for FILE in $STAGED_CPP_TRACE; do
        HAS_TRACE=$(grep -cE "(CHAOS_IL2CPP_LOG_TRACE|CHAOS_IL2CPP_LOG_(ERROR|WARN|INFO|DEBUG))" "$FILE" || true)
        if [ "$HAS_TRACE" -eq 0 ]; then
            echo "WARNING: $FILE has no CHAOS_IL2CPP_LOG_TRACE/LOG_*() calls — add trace points or confirm they are not needed"
            MISSING_TRACE=1
        fi
    done
    if [ "$MISSING_TRACE" -ne 0 ]; then
        echo "=== [trace] Trace coverage advisory issued ==="
    else
        echo "=== [trace] All staged .cpp files have CHAOS_IL2CPP_LOG_TRACE/LOG_*() ==="
    fi
fi

echo "=== [layer-boundary] Checking 4-layer architecture compliance ==="

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)

if [ -z "$STAGED_PY" ]; then
    echo "=== [layer-boundary] No Python files staged, skipping ==="
else
    # Run the boundary check script
    BOUNDARY_OUTPUT=$(python testing/foundation-dll/verification/preflight/check_layer_boundaries.py 2>&1 | cat)
    echo "$BOUNDARY_OUTPUT"
    if echo "$BOUNDARY_OUTPUT" | grep -q "FAIL"; then
        echo ""
        echo "ERROR: Layer boundary check FAILED. Fix violations or add BOUNDARY_OVERRIDE."
        echo "Use 'git commit --no-verify' to bypass (not recommended)."
        exit 1
    fi
    echo "=== [layer-boundary] All staged files pass layer boundary checks ==="
fi

exit 0
