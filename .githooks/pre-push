#!/bin/sh
# Chaos IL2CPP — Pre-push hook: deep LLM review of outgoing changes.
#
# Runs review_runner.py with the diff of the commits being pushed (range
# origin/<default>..HEAD). Blocks the push when the review verdict is "block"
# (≥1 L1/L2 severe issue in review_rubric.md).
#
# - Requires `claude` CLI; if absent, review_runner degrades to allow+warning
#   (deterministic pre-commit gates still guard objective P0/P1).
# - Bypass: git push --no-verify  (NOT recommended — the review is mandatory in
#   spirit; --no-verify opts out and should be deliberate).
#
# Install: git config core.hooksPath .githooks

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
# Audit log (NOT committed to the repo): each push gate run is recorded to
# .git/chaos-hooks.log so you can audit triggers + verdicts.
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo "$REPO_ROOT/.git")
HOOK_LOG="$GIT_DIR/chaos-hooks.log"
hook_log() { printf '%s  pre-push    %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$HOOK_LOG" 2>/dev/null || true; }
trap 'hook_log "exit=$?"' 0

# Determine remote default branch robustly, falling back to origin/main.
if git symbolic-ref -q refs/remotes/origin/HEAD >/dev/null 2>&1; then
    REMOTE_DEFAULT=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    REMOTE_DEFAULT=${REMOTE_DEFAULT#origin/}
else
    REMOTE_DEFAULT="main"
fi

# Parse the actual target branch from stdin (git push sends refs line by line).
# Format: <local-ref> <local-oid> <remote-ref> <remote-oid>
# We read the first line only — a single push all goes to one remote branch.
TARGET_BRANCH=""
while read local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/*)
            TARGET_BRANCH="${remote_ref#refs/heads/}"
            break
            ;;
    esac
done
# Fallback: if stdin parsing yielded nothing (e.g. tag push), use the default.
: "${TARGET_BRANCH:=$REMOTE_DEFAULT}"

hook_log "start: range=origin/$REMOTE_DEFAULT..HEAD target=$TARGET_BRANCH"

echo "=== [review] Deep review of outgoing changes (L1/L2 blocks) ==="

OUTGOING_RANGE="origin/$REMOTE_DEFAULT..HEAD"

DIFF=$(git diff "$OUTGOING_RANGE" 2>/dev/null || git diff "origin/main..HEAD" 2>/dev/null || true)

if [ -z "$DIFF" ] || [ "$(printf '%s' "$DIFF" | wc -c)" -eq 0 ]; then
    echo "=== [review] No outgoing changes against $OUTGOING_RANGE, skipping ==="
    hook_log "result=skip (no outgoing changes)"
    exit 0
fi

RESULT=$(printf '%s' "$DIFF" | python "$REPO_ROOT/.githooks/review_runner.py" 2>&1)
RC=$?
printf '%s\n' "$RESULT"   # echo the review output to the terminal
hook_log "result=${RC}-ok verdict=$(printf '%s' "$RESULT" | grep -oE '\[review\] [A-Z]+' | head -1 || true)"

# Determine whether this is a protected branch (main/release/*/master).
# Uses the ACTUAL target branch parsed from stdin, NOT the default branch,
# so feature-branch pushes are correctly treated as advisory.
HARD_GATE=0
case "$TARGET_BRANCH" in
    main|release/*|master) HARD_GATE=1 ;;
esac

if [ "$RC" -ne 0 ]; then
    if [ "$HARD_GATE" -eq 1 ]; then
        echo ""
        echo "NOTICE: Deep review reported L1/L2 (severe) issues on ${TARGET_BRANCH}."
        echo "This is a BLOCK on protected branch — resolve the issues before pushing."
        echo "(To bypass deliberately: git push --no-verify — NOT recommended.)"
        hook_log "result=BLOCK (protected branch: ${TARGET_BRANCH})"
        exit 1
    fi
    echo ""
    echo "NOTICE: Deep review reported L1/L2 (severe) issues above — treated as advisory (non-blocking)."
    echo "Review the reported issues and fix them in a follow-up; the push proceeds regardless."
    hook_log "result=ADVISORY (non-protected branch: ${TARGET_BRANCH})"
    # Soft mode: do NOT block the push.  The review output above remains visible
    # as an advisory for the developer to act on.
    exit 0
fi

exit 0