# Editor configuration for Chaos IL2CPP project

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,cc,cxx}]
indent_style = space
indent_size = 4

[*.{cs,csproj}]
indent_style = space
indent_size = 4

# ── C# coding style (CHAOS_IL2CPP managed pipeline) ─────────────────────
# Enforced by `dotnet format style --verify-no-changes` in CI (ubuntu runner,
# where git normalizes LF so no line-ending noise).  Scope = src/managed +
# src/tools source code; generated/ output is excluded below (regenerated, not
# hand-edited).
[src/{managed,tools}/**/*.cs]
# .NET / using directives
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace

# `var` preference
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:silent

# Modifiers / access
csharp_preferred_modifier_order = public, private, protected, internal, static, extern, new, virtual, abstract, sealed, override, readonly, unsafe, volatile, async:error
# Prefer explicit / modern constructs
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = true:silent
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_throw_expression = true:suggestion

# Language keywords vs BCL
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Braces — enforce on new code, accept existing
csharp_prefer_braces = true:silent

# Equality / null
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# Generated code — never auto-format (regenerated by Scriban/emitters)
[src/**/generated/**/*.cs]
generated_code = true

# ── CMakeLists / YAML (unchanged) ────────────────────────────────────────

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
