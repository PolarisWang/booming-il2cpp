{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "truth-contracts.schema.json",
  "title": "Foundation DLL Audit Truth Contracts",
  "description": "Truth contracts defining capability families, method subject IDs, and obligation requirements.",
  "type": "object",
  "required": ["schemaVersion", "assemblies"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "dllCapabilityManifest", "capabilityFamilyVerificationContracts"],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "dllCapabilityManifest": {
            "type": "object",
            "description": "Top-level capability family manifest for the DLL.",
            "required": [
              "assemblyName", "ownerSubjectId",
              "capabilityFamilies", "capabilityFamilyCount", "methodUniverseCount"
            ],
            "properties": {
              "assemblyName": { "type": "string" },
              "ownerSubjectId": { "type": "string" },
              "capabilityFamilies": {
                "type": "array",
                "items": { "type": "string", "pattern": "^family/" }
              },
              "capabilityFamilyCount": { "type": "integer" },
              "methodUniverseCount": { "type": "integer" }
            }
          },
          "capabilityFamilyVerificationContracts": {
            "type": "array",
            "description": "Per-family verification contracts with method subject IDs.",
            "items": {
              "type": "object",
              "required": [
                "assemblyName", "ownerSubjectId", "familyId", "displayName",
                "methodSubjectIds", "methodSubjectCount",
                "functionalObligation", "reviewBundleRequired"
              ],
              "properties": {
                "assemblyName": { "type": "string" },
                "ownerSubjectId": { "type": "string" },
                "familyId": { "type": "string", "pattern": "^family/" },
                "displayName": { "type": "string" },
                "methodSubjectIds": {
                  "type": "array",
                  "description": "Method subject IDs that define this family's scope.",
                  "items": { "type": "string" }
                },
                "methodSubjectCount": { "type": "integer" },
                "functionalObligation": {
                  "type": "object",
                  "required": ["required"],
                  "properties": {
                    "required": { "type": "boolean" }
                  }
                },
                "performanceObligation": {
                  "type": "object",
                  "properties": {
                    "required": { "type": "boolean" }
                  }
                },
                "hotupdateFunctionalObligation": {
                  "type": "object",
                  "properties": {
                    "required": { "type": "boolean" }
                  }
                },
                "hotupdatePerformanceObligation": {
                  "type": "object",
                  "properties": {
                    "required": { "type": "boolean" }
                  }
                },
                "reviewBundleRequired": { "type": "boolean" }
              }
            }
          },
          "methodCapabilityContracts": {
            "type": "array",
            "description": "Per-method capability contracts (optional, detailed view).",
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
