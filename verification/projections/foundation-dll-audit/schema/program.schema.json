{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "program.schema.json",
  "title": "Foundation DLL Audit Program Summary",
  "description": "Top-level program summary for the Foundation DLL Translation Audit dashboard.",
  "type": "object",
  "required": [
    "schemaVersion",
    "programId",
    "title",
    "summary",
    "scopeAssemblies",
    "authoritySnapshot"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "description": "Schema version number for forward compatibility.",
      "enum": [1, 2]
    },
    "programId": {
      "type": "string",
      "description": "Unique program identifier.",
      "pattern": "^foundation-dll-translation-audit$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable program title."
    },
    "roadmapPath": {
      "type": "string",
      "description": "Relative path to the roadmap markdown file."
    },
    "designPath": {
      "type": "string",
      "description": "Relative path to the design document."
    },
    "statusPath": {
      "type": "string",
      "description": "Relative path to the STATUS.md file."
    },
    "subjectEntry": {
      "type": "string",
      "description": "Path to the solution or subject entry point."
    },
    "summary": {
      "type": "object",
      "description": "Aggregated summary statistics across all DLLs.",
      "required": [
        "dllCount",
        "completedCount",
        "inProgressCount",
        "blockedCount",
        "notStartedCount",
        "progressPercent",
        "activeAssembly",
        "capabilityClosure",
        "workflowProgress",
        "dllCompletion"
      ],
      "properties": {
        "dllCount": { "type": "integer", "description": "Total number of DLLs in scope." },
        "completedCount": { "type": "integer", "description": "Number of DLLs with dllState=completed." },
        "inProgressCount": { "type": "integer", "description": "Number of DLLs with dllState=in-progress." },
        "blockedCount": { "type": "integer", "description": "Number of DLLs with dllState=blocked." },
        "notStartedCount": { "type": "integer", "description": "Number of DLLs with dllState=not-started." },
        "progressPercent": { "type": "number", "description": "Overall progress percentage (0-100)." },
        "activeAssembly": { "type": "string", "description": "Assembly name of the currently active/focused DLL." },
        "capabilityClosure": {
          "type": "object",
          "description": "Capability closure statistics across all families.",
          "required": [
            "totalFamilies", "closedFamilies", "waivedFamilies",
            "excludedFamilies", "platformBlockedFamilies",
            "inProgressFamilies", "closurePercent"
          ],
          "properties": {
            "totalFamilies": { "type": "integer" },
            "closedFamilies": { "type": "integer" },
            "waivedFamilies": { "type": "integer" },
            "excludedFamilies": { "type": "integer" },
            "platformBlockedFamilies": { "type": "integer" },
            "inProgressFamilies": { "type": "integer" },
            "closurePercent": { "type": "number" }
          }
        },
        "workflowProgress": {
          "type": "object",
          "description": "Workflow/gate progress across all DLLs.",
          "required": ["totalRequiredGates", "passedGates", "progressPercent"],
          "properties": {
            "totalRequiredGates": { "type": "integer" },
            "passedGates": { "type": "integer" },
            "progressPercent": { "type": "number" }
          }
        },
        "dllCompletion": {
          "type": "object",
          "description": "DLL-level completion breakdown.",
          "required": ["completedDllCount", "blockedDllCount", "inProgressDllCount", "notStartedDllCount"],
          "properties": {
            "completedDllCount": { "type": "integer" },
            "blockedDllCount": { "type": "integer" },
            "inProgressDllCount": { "type": "integer" },
            "notStartedDllCount": { "type": "integer" }
          }
        }
      }
    },
    "scopeAssemblies": {
      "type": "array",
      "description": "List of all DLL assembly names in scope.",
      "items": { "type": "string" }
    },
    "authoritySnapshot": {
      "type": "object",
      "description": "Snapshot metadata for the authority/denominator baseline.",
      "required": ["snapshotId", "snapshotAt", "ledgerVersion", "denominatorStrategy", "denominatorStatus"],
      "properties": {
        "snapshotId": { "type": "string" },
        "snapshotAt": { "type": "string", "format": "date-time" },
        "ledgerVersion": { "type": "string" },
        "denominatorStrategy": {
          "type": "string",
          "enum": ["capability-family"]
        },
        "denominatorStatus": {
          "type": "string",
          "enum": ["candidate-derived", "audit-confirmed", "auto-derived"]
        },
        "originalAuthorityDigest": {
          "type": "object",
          "properties": {
            "inputManifestVersion": { "type": "string" },
            "surfaceLedgerVersion": { "type": "string" },
            "semanticLedgerVersion": { "type": "string" },
            "nativeizationPlanVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
