{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "dll-matrix.schema.json",
  "title": "Foundation DLL Audit DLL Matrix",
  "description": "Per-DLL summary rows for the dashboard matrix view.",
  "type": "object",
  "required": ["schemaVersion", "rows"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2]
    },
    "rows": {
      "type": "array",
      "description": "One row per DLL in scope.",
      "items": {
        "type": "object",
        "required": [
          "assemblyName", "orderIndex", "dllState", "currentProject",
          "audit-input-and-ledger", "managed-proof", "native-proof",
          "hotupdate-proof", "benchmark", "codegen-review",
          "completion-certification", "denominatorStatus",
          "capabilityClosure", "workflowProgress"
        ],
        "properties": {
          "assemblyName": { "type": "string", "description": "DLL assembly name." },
          "orderIndex": { "type": "integer", "description": "Display order index (1-based)." },
          "dllState": {
            "type": "string",
            "description": "DLL-level completion state.",
            "enum": ["completed", "in-progress", "blocked", "not-started"]
          },
          "currentProject": {
            "type": "string",
            "description": "Currently active project code for this DLL."
          },
          "riskTags": {
            "type": "array",
            "description": "Risk classification tags.",
            "items": { "type": "string" }
          },
          "audit-input-and-ledger": {
            "type": "string",
            "description": "Gate state for Audit Input and Ledger.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "managed-proof": {
            "type": "string",
            "description": "Gate state for Managed Proof.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "native-proof": {
            "type": "string",
            "description": "Gate state for Native Proof.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "hotupdate-proof": {
            "type": "string",
            "description": "Gate state for HotUpdate Proof.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "benchmark": {
            "type": "string",
            "description": "Gate state for Benchmark.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "codegen-review": {
            "type": "string",
            "description": "Gate state for Codegen Review.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "completion-certification": {
            "type": "string",
            "description": "Gate state for Completion Certification.",
            "enum": ["passed", "pending", "blocked", "not-required", "in-progress", "missing-evidence"]
          },
          "denominatorStatus": {
            "type": "string",
            "description": "Denominator derivation audit status.",
            "enum": ["candidate-derived", "audit-confirmed", "auto-derived"]
          },
          "capabilityClosure": {
            "type": "object",
            "description": "Capability closure stats per DLL.",
            "required": [
              "totalFamilies", "closedFamilies", "waivedFamilies",
              "excludedFamilies", "platformBlockedFamilies",
              "inProgressFamilies", "closurePercent"
            ],
            "properties": {
              "totalFamilies": { "type": "integer" },
              "closedFamilies": { "type": "integer" },
              "waivedFamilies": { "type": "integer" },
              "excludedFamilies": { "type": "integer" },
              "platformBlockedFamilies": { "type": "integer" },
              "inProgressFamilies": { "type": "integer" },
              "closurePercent": { "type": "number" }
            }
          },
          "workflowProgress": {
            "type": "object",
            "description": "Gate workflow progress per DLL.",
            "required": ["totalRequiredGates", "passedGates", "progressPercent"],
            "properties": {
              "totalRequiredGates": { "type": "integer" },
              "passedGates": { "type": "integer" },
              "progressPercent": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
