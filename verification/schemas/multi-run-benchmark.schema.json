{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "multi-run-benchmark.schema.json",
  "title": "Multi-Runtime Benchmark Report",
  "description": "Aggregate benchmark report comparing a capability family across multiple .NET runtimes and compilation modes.",
  "type": "object",
  "required": [
    "family", "assembly", "timestamp", "config",
    "runtimes_available", "methods", "summaries", "ratios"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "family": { "type": "string", "description": "Capability family slug" },
    "assembly": { "type": "string", "description": "Assembly name" },
    "timestamp": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer" },

    "config": {
      "type": "object",
      "description": "Run configuration.",
      "properties": {
        "requested_runtimes": { "type": "array", "items": { "type": "string" } },
        "available_runtimes": { "type": "array", "items": { "type": "string" } },
        "unavailable_runtimes": { "type": "array", "items": { "type": "string" } },
        "iterations": { "type": "integer" }
      },
      "required": ["available_runtimes"]
    },

    "runtimes_available": {
      "type": "array",
      "description": "Runtime aliases that were actually run.",
      "items": {
        "type": "string",
        "enum": [
          "net8-jit", "net10-jit", "mono",
          "net8-aot", "net10-aot",
          "chaos-aot", "chaos-jit",
          "chaos-hu-aot", "chaos-hu-jit"
        ]
      }
    },

    "runtimes_unavailable": {
      "type": "array",
      "items": { "type": "string" }
    },

    "methods": {
      "type": "array",
      "description": "Per-method benchmark data across all runtimes.",
      "items": {
        "$ref": "#/definitions/MethodBenchResult"
      }
    },

    "summaries": {
      "type": "array",
      "description": "Per-runtime aggregate metrics.",
      "items": {
        "$ref": "#/definitions/RuntimeSummary"
      }
    },

    "ratios": {
      "type": "array",
      "description": "Pairwise ratio comparisons between runtimes.",
      "items": {
        "$ref": "#/definitions/RatioSummary"
      }
    },

    "chaos_classification_breakdown": {
      "type": "object",
      "description": "Classification of chaos-aot performance vs net8-jit baseline.",
      "properties": {
        "chaos_faster_than_all":  { "type": "integer" },
        "chaos_faster_than_jit":  { "type": "integer" },
        "chaos_midfield":         { "type": "integer" },
        "chaos_slower_than_jit":  { "type": "integer" },
        "not_benchmarked":        { "type": "integer" }
      }
    },

    "regression_alerts": {
      "type": "array",
      "description": "Regressions detected against previous baseline run.",
      "items": {
        "$ref": "#/definitions/RegressionAlert"
      }
    }
  },

  "definitions": {
    "PerfSample": {
      "type": "object",
      "required": ["runtime", "mean_ns", "samples", "status"],
      "properties": {
        "runtime":   { "type": "string", "description": "Runtime alias" },
        "mean_ns":   { "type": "number", "description": "Mean ns/op" },
        "stddev_ns": { "type": "number", "description": "Standard deviation" },
        "samples":   { "type": "integer", "description": "Number of iterations" },
        "status":    { "type": "string", "enum": ["ok", "stub", "throws", "unsupported", "error"] },
        "error":     { "type": "string" }
      }
    },

    "MethodBenchResult": {
      "type": "object",
      "required": ["subject_id", "method_index"],
      "properties": {
        "subject_id":   { "type": "string" },
        "method_index": { "type": "integer" },
        "label":        { "type": "string" },
        "samples": {
          "type": "object",
          "description": "Map of runtime_alias -> PerfSample",
          "additionalProperties": {
            "$ref": "#/definitions/PerfSample"
          }
        }
      }
    },

    "RuntimeSummary": {
      "type": "object",
      "required": ["runtime", "geometric_mean_ns", "ok_count", "method_count"],
      "properties": {
        "runtime":           { "type": "string" },
        "geometric_mean_ns": { "type": "number" },
        "min_ns":            { "type": "number" },
        "max_ns":            { "type": "number" },
        "median_ns":         { "type": "number" },
        "method_count":      { "type": "integer" },
        "ok_count":          { "type": "integer" },
        "stub_count":        { "type": "integer" },
        "throws_count":      { "type": "integer" },
        "unsupported_count": { "type": "integer" }
      }
    },

    "RatioSummary": {
      "type": "object",
      "required": ["label", "numerator", "denominator", "geometric_mean_ratio"],
      "properties": {
        "label":              { "type": "string" },
        "numerator":          { "type": "string" },
        "denominator":        { "type": "string" },
        "geometric_mean_ratio": { "type": "number" },
        "min_ratio":          { "type": "number" },
        "max_ratio":          { "type": "number" },
        "faster_count":       { "type": "integer" },
        "slower_count":       { "type": "integer" },
        "equal_count":        { "type": "integer" },
        "chaos_classification": { "type": "string" }
      }
    },

    "RegressionAlert": {
      "type": "object",
      "required": ["method_index", "runtime", "delta_pct", "alert"],
      "properties": {
        "method_index":  { "type": "integer" },
        "subject_id":    { "type": "string" },
        "runtime":       { "type": "string" },
        "metric":        { "type": "string" },
        "before_value":  { "type": "number" },
        "after_value":   { "type": "number" },
        "delta_pct":     { "type": "number" },
        "threshold_pct": { "type": "number" },
        "alert":         { "type": "boolean" }
      }
    }
  }
}
