    // ═══════════════════════════════════════════════════════════════════
    //  Common epilogue — backedge detection, then dispatch next opcode
    // ═══════════════════════════════════════════════════════════════════

    kOp_Epilogue: {
        // OSR: detect hot-loop backward branch via frame.last_pc (set by branch handlers).
        if (frame.pc < frame.last_pc) {
            uint32_t threshold = kFastOsrLoopThreshold;
            if (frame.osr_reenable) {
                auto* pm = static_cast<chaos::il2cpp::runtime_core::PatchMethod*>(frame.patch_method);
                threshold = (pm != nullptr && pm->deopt_count > 0)
                    ? (kFastOsrLoopThreshold << std::min(pm->deopt_count, 5u))
                    : 1u;
                frame.osr_reenable = false;
            }
            if (++frame.loop_counter >= threshold) {
                if (TryFastOsrPromotion(frame)) goto kOp_Next;
                frame.loop_counter = 0;
            }
        }
        frame.last_pc = 0;  // reset to prevent re-trigger for non-branch opcodes
        goto kOp_Next;
    }

    kOp_Terminate: {
        AccumulatePgoCounters(frame);
        frame.CleanupTracked();
        return frame.threw_exception ? false : true;
    }

    kOp_Next: {
        // Termination sentinels.
        if (frame.pc == 0xFFffFFffu) { AccumulatePgoCounters(frame); frame.CleanupTracked(); return true; }
        if (frame.pc == 9999 || frame.threw_exception) { AccumulatePgoCounters(frame); frame.CleanupTracked(); return false; }
        if (frame.pc >= instr_count) { AccumulatePgoCounters(frame); frame.CleanupTracked(); return true; }

        // Decimated interrupt check — every 64 instructions.
        if ((++check_counter & kCheckMask) == 0 && thread != nullptr) {
            if (CHAOS_IL2CPP_UNLIKELY(
                    thread->pending_abort.load(std::memory_order_relaxed) ||
                    thread->pending_interrupt.load(std::memory_order_relaxed))) {
                frame.threw_exception = true;
                AccumulatePgoCounters(frame);
                frame.CleanupTracked();
                return false;
            }
        }

        // Debugger breakpoint check (hoisted: g_dbg_any_breakpoints loaded once at entry).
        if (CHAOS_IL2CPP_UNLIKELY(dbg_active))
        {
            uint32_t method_token = 0;
            auto* pm = static_cast<PatchMethod*>(frame.patch_method);
            if (pm) method_token = pm->token;
            if (diagnostics::DbgShouldPause(method_token, frame.pc, 0)) {
                diagnostics::DbgClearFrameSnapshot();
                auto& snap = diagnostics::DbgGetFrameSnapshot();
                int fi = 0;
                const runtime_core::FastFrame* walk = &frame;
                while (walk && fi < diagnostics::kDbgMaxCapturedFrames) {
                    uint32_t tk = 0;
                    auto* wpm = static_cast<PatchMethod*>(walk->patch_method);
                    if (wpm) tk = wpm->token;
                    snap.frames[fi].method_token = tk;
                    snap.frames[fi].il_offset   = walk->pc;
                    ++fi;
                    walk = static_cast<const runtime_core::FastFrame*>(walk->prev_frame);
                }
                snap.frame_count = fi;
                int li = 0;
                uint32_t max_locals = frame.local_count < diagnostics::kDbgMaxCapturedLocals
                    ? frame.local_count : diagnostics::kDbgMaxCapturedLocals;
                for (uint32_t i = 0; i < max_locals; ++i) {
                    snap.locals[li].index = i;
                    snap.locals[li].value = frame.locals[i];
                    snap.locals[li].tag   = frame.local_tags[i];
                    ++li;
                }
                snap.local_count = li;
                diagnostics::DbgNotifyPaused(method_token, frame.pc);
            }
        }

        // Dispatch the next instruction.
        uint32_t _op = static_cast<uint32_t>(instrs[frame.pc].op_code);
        if (_op > 127) { AccumulatePgoCounters(frame); frame.threw_exception = true; return false; }
#if CHAOS_IL2CPP_PROFILE_ENABLED
        ++g_fast_op_freq[_op];
#endif
        goto *kOpTable[_op];
    }

    // Unreachable — satisfy compiler.
    AccumulatePgoCounters(frame);
    frame.CleanupTracked();
    return true;

#else   // !(__GNUC__ || __clang__) — MSVC fallback

#define DISPATCH_CASE(n, name) case n: Handle_##name(frame, instrs[frame.pc]); break

    while (frame.pc < instr_count) {
        uint32_t op_val = static_cast<uint32_t>(instrs[frame.pc].op_code);
        if (op_val > 127) {
            frame.threw_exception = true;
            return false;
        }
#if CHAOS_IL2CPP_PROFILE_ENABLED
        ++g_fast_op_freq[op_val];
#endif

        // Debugger breakpoint check (hoisted: g_dbg_any_breakpoints loaded once at entry).
        if (CHAOS_IL2CPP_UNLIKELY(dbg_active))
        {
            uint32_t method_token = 0;
            auto* pm = static_cast<PatchMethod*>(frame.patch_method);
            if (pm) method_token = pm->token;
            if (diagnostics::DbgShouldPause(method_token, frame.pc, 0)) {
                diagnostics::DbgClearFrameSnapshot();
                auto& snap = diagnostics::DbgGetFrameSnapshot();
                int fi = 0;
                const runtime_core::FastFrame* walk = &frame;
                while (walk && fi < diagnostics::kDbgMaxCapturedFrames) {
                    uint32_t tk = 0;
                    auto* wpm = static_cast<PatchMethod*>(walk->patch_method);
                    if (wpm) tk = wpm->token;
                    snap.frames[fi].method_token = tk;
                    snap.frames[fi].il_offset   = walk->pc;
                    ++fi;
                    walk = static_cast<const runtime_core::FastFrame*>(walk->prev_frame);
                }
                snap.frame_count = fi;
                int li = 0;
                uint32_t max_locals = frame.local_count < diagnostics::kDbgMaxCapturedLocals
                    ? frame.local_count : diagnostics::kDbgMaxCapturedLocals;
                for (uint32_t i = 0; i < max_locals; ++i) {
                    snap.locals[li].index = i;
                    snap.locals[li].value = frame.locals[i];
                    snap.locals[li].tag   = frame.local_tags[i];
                    ++li;
                }
                snap.local_count = li;
                diagnostics::DbgNotifyPaused(method_token, frame.pc);
            }
        }

        switch (op_val) {
            DISPATCH_CASE( 0, LdcI4); DISPATCH_CASE( 1, LdcI8);
            DISPATCH_CASE( 2, LdcR4); DISPATCH_CASE( 3, LdcR8);
            DISPATCH_CASE( 4, LdStr); DISPATCH_CASE( 5, LdNull);
            DISPATCH_CASE( 6, LdArg); DISPATCH_CASE( 7, LdLoc);
            DISPATCH_CASE( 8, StLoc); DISPATCH_CASE( 9, StArg);
            DISPATCH_CASE(10, LdFld); DISPATCH_CASE(11, StFld);
            DISPATCH_CASE(12, LdSFld); DISPATCH_CASE(13, StSFld);
            DISPATCH_CASE(14, Call);  DISPATCH_CASE(15, CallVirt);
            DISPATCH_CASE(16, CallBridge); DISPATCH_CASE(17, Br);
            DISPATCH_CASE(18, BrTrue); DISPATCH_CASE(19, BrFalse);
            DISPATCH_CASE(20, Beq);   DISPATCH_CASE(21, Blt);
            DISPATCH_CASE(22, Bgt);   DISPATCH_CASE(23, Ble);
            DISPATCH_CASE(24, Bge);   DISPATCH_CASE(25, Add);
            DISPATCH_CASE(26, Sub);   DISPATCH_CASE(27, Mul);
            DISPATCH_CASE(28, Div);   DISPATCH_CASE(29, Rem);
            DISPATCH_CASE(30, Neg);   DISPATCH_CASE(31, Ceq);
            DISPATCH_CASE(32, Clt);   DISPATCH_CASE(33, Cgt);
            DISPATCH_CASE(34, NewObj); DISPATCH_CASE(35, Box);
            DISPATCH_CASE(36, Unbox); DISPATCH_CASE(37, CastClass);
            DISPATCH_CASE(38, IsInst); DISPATCH_CASE(39, Conv_I4);
            DISPATCH_CASE(40, Conv_I8); DISPATCH_CASE(41, Conv_R4);
            DISPATCH_CASE(42, Conv_R8); DISPATCH_CASE(43, NewArr);
            DISPATCH_CASE(44, LdElem); DISPATCH_CASE(45, StElem);
            DISPATCH_CASE(46, LdLen); DISPATCH_CASE(47, Pop);
            DISPATCH_CASE(48, Throw); DISPATCH_CASE(49, Rethrow);
            DISPATCH_CASE(50, Leave); DISPATCH_CASE(51, EndFinally);
            DISPATCH_CASE(52, EndFilter); DISPATCH_CASE(53, Ret);
            DISPATCH_CASE(54, Dup);   DISPATCH_CASE(55, DivUn);
            DISPATCH_CASE(56, RemUn); DISPATCH_CASE(57, And);
            DISPATCH_CASE(58, Or);    DISPATCH_CASE(59, Xor);
            DISPATCH_CASE(60, Not);   DISPATCH_CASE(61, Shl);
            DISPATCH_CASE(62, Shr);   DISPATCH_CASE(63, ShrUn);
            DISPATCH_CASE(64, ConvRUn); DISPATCH_CASE(65, ConvI);
            DISPATCH_CASE(66, ConvU); DISPATCH_CASE(67, LdInd);
            DISPATCH_CASE(68, StInd); DISPATCH_CASE(69, Switch);
            DISPATCH_CASE(70, LdToken); DISPATCH_CASE(71, InitObj);
            DISPATCH_CASE(72, SizeOf); DISPATCH_CASE(73, LdFtn);
            DISPATCH_CASE(74, LdVirtFtn); DISPATCH_CASE(75, LdArgA);
            DISPATCH_CASE(76, LdLocA); DISPATCH_CASE(77, LocAlloc);
            DISPATCH_CASE(78, Break); DISPATCH_CASE(79, BneUn);
            DISPATCH_CASE(80, BgeUn); DISPATCH_CASE(81, BgtUn);
            DISPATCH_CASE(82, BleUn); DISPATCH_CASE(83, BltUn);
            DISPATCH_CASE(84, AddOvf); DISPATCH_CASE(85, SubOvf);
            DISPATCH_CASE(86, MulOvf); DISPATCH_CASE(87, ConvOvfI);
            DISPATCH_CASE(88, ConvOvfI4); DISPATCH_CASE(89, ConvOvfI8);
            DISPATCH_CASE(90, ConvOvfU); DISPATCH_CASE(91, ConvOvfU4);
            DISPATCH_CASE(92, ConvOvfU8); DISPATCH_CASE(93, LdObj);
            DISPATCH_CASE(94, StObj); DISPATCH_CASE(95, LdElemA);
            DISPATCH_CASE(96, Cpblk); DISPATCH_CASE(97, InitBlk);
            DISPATCH_CASE(98, CallVirtConstrained); DISPATCH_CASE(99, Calli);
            DISPATCH_CASE(104, LdElemNoChk); DISPATCH_CASE(105, StElemNoChk);
            DISPATCH_CASE(106, LdElemANoChk);
            DISPATCH_CASE(100, Unsupported); DISPATCH_CASE(101, Unsupported);
            DISPATCH_CASE(102, Unsupported); DISPATCH_CASE(103, StFldBarrier);
            DISPATCH_CASE(107, Unsupported); DISPATCH_CASE(108, Unsupported);
            DISPATCH_CASE(109, Unsupported); DISPATCH_CASE(110, Unsupported);
            default:
                Handle_Unsupported(frame, instrs[frame.pc]);
                break;
        }

        if (frame.pc < frame.last_pc) {
            uint32_t threshold = kFastOsrLoopThreshold;
            if (frame.osr_reenable) {
                auto* pm = static_cast<chaos::il2cpp::runtime_core::PatchMethod*>(frame.patch_method);
                threshold = (pm != nullptr && pm->deopt_count > 0)
                    ? (kFastOsrLoopThreshold << std::min(pm->deopt_count, 5u))
                    : 1u;
                frame.osr_reenable = false;
            }
            if (++frame.loop_counter >= threshold) {
                if (TryFastOsrPromotion(frame)) continue;
                frame.loop_counter = 0;
            }
        }
        frame.last_pc = 0;

        if (frame.pc != 0xFFffFFffu && frame.pc != 9999) {
            if ((++check_counter & kCheckMask) == 0) {
                if (thread != nullptr) {
                    if (thread->pending_abort.load(std::memory_order_relaxed)) {
                        frame.threw_exception = true; frame.pc = 9999;
                    } else if (thread->pending_interrupt.load(std::memory_order_relaxed)) {
                        frame.threw_exception = true; frame.pc = 9999;
                    }
                }
            }
        }
        if (frame.threw_exception && frame.pc == 9999) {
            AccumulatePgoCounters(frame); frame.CleanupTracked(); return false;
        }
        if (frame.pc == 0xFFffFFffu) {
            AccumulatePgoCounters(frame); frame.CleanupTracked(); return true;
        }
    }

    AccumulatePgoCounters(frame);
    frame.CleanupTracked();
    return true;
#endif  // __GNUC__ || __clang__
}

