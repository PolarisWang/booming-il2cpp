    // Debugger breakpoints cannot be added during FastExecute (thread is in
    // managed code), so a single relaxed load is sufficient for the lifetime
    // of this call.  Keeps the hot dispatch path register-local.
    bool dbg_active = diagnostics::g_dbg_any_breakpoints.load(std::memory_order_relaxed);

