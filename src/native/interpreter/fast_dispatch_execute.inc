        &&kOp_LdSFld,   &&kOp_StSFld,   &&kOp_Call,     &&kOp_CallVirt,   // 12-15
        &&kOp_CallBridge, &&kOp_Br,     &&kOp_BrTrue,   &&kOp_BrFalse,    // 16-19
        &&kOp_Beq,      &&kOp_Blt,      &&kOp_Bgt,      &&kOp_Ble,        // 20-23
        &&kOp_Bge,      &&kOp_Add,      &&kOp_Sub,      &&kOp_Mul,        // 24-27
        &&kOp_Div,      &&kOp_Rem,      &&kOp_Neg,      &&kOp_Ceq,        // 28-31
        &&kOp_Clt,      &&kOp_Cgt,      &&kOp_NewObj,   &&kOp_Box,        // 32-35
        &&kOp_Unbox,    &&kOp_CastClass,&&kOp_IsInst,   &&kOp_Conv_I4,    // 36-39
        &&kOp_Conv_I8,  &&kOp_Conv_R4,  &&kOp_Conv_R8,  &&kOp_NewArr,     // 40-43
        &&kOp_LdElem,   &&kOp_StElem,   &&kOp_LdLen,    &&kOp_Pop,        // 44-47
        &&kOp_Throw,    &&kOp_Rethrow,  &&kOp_Leave,    &&kOp_EndFinally, // 48-51
        &&kOp_EndFilter,&&kOp_Ret,      &&kOp_Dup,      &&kOp_DivUn,      // 52-55
        &&kOp_RemUn,    &&kOp_And,      &&kOp_Or,       &&kOp_Xor,        // 56-59
        &&kOp_Not,      &&kOp_Shl,      &&kOp_Shr,      &&kOp_ShrUn,      // 60-63
        &&kOp_ConvRUn,  &&kOp_ConvI,    &&kOp_ConvU,    &&kOp_LdInd,      // 64-67
        &&kOp_StInd,    &&kOp_Switch,   &&kOp_LdToken,  &&kOp_InitObj,    // 68-71
        &&kOp_SizeOf,   &&kOp_LdFtn,    &&kOp_LdVirtFtn,&&kOp_LdArgA,     // 72-75
        &&kOp_LdLocA,   &&kOp_LocAlloc, &&kOp_Break,    &&kOp_BneUn,      // 76-79
        &&kOp_BgeUn,    &&kOp_BgtUn,    &&kOp_BleUn,    &&kOp_BltUn,      // 80-83
        &&kOp_AddOvf,   &&kOp_SubOvf,   &&kOp_MulOvf,   &&kOp_ConvOvfI,   // 84-87
        &&kOp_ConvOvfI4,&&kOp_ConvOvfI8,&&kOp_ConvOvfU, &&kOp_ConvOvfU4,  // 88-91
        &&kOp_ConvOvfU8,&&kOp_LdObj,    &&kOp_StObj,    &&kOp_LdElemA,    // 92-95
        &&kOp_Cpblk,    &&kOp_InitBlk,  &&kOp_CallVirtConstrained,        // 96-98
        &&kOp_Calli,                                                     // 99
        &&kOp_Unsupported, &&kOp_Unsupported, &&kOp_Unsupported,          // 100-102
        &&kOp_StFldBarrier,                                              // 103
        &&kOp_LdElemNoChk, &&kOp_StElemNoChk, &&kOp_LdElemANoChk,        // 104-106
