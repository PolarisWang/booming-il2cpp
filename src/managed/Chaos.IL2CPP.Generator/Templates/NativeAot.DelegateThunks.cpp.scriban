// Auto-generated delegate thunk registrations
// Each delegate type that flows through Marshal.GetDelegateForFunctionPointer /
// Marshal.GetFunctionPointerForDelegate gets a per-signature dispatch thunk
// and a call to RegisterDelegateThunk.

{{~ if delegate_thunks ~}}
{{~ for dt in delegate_thunks ~}}
// Delegate type: {{ dt.type_id }}
{{~ if dt.has_custom_thunk }}
// Custom per-signature thunk for correct ABI (float/double register passing on ARM64)
extern "C" void* {{ dt.thunk_symbol }}(
    chaos::il2cpp::runtime_core::RuntimeState* rs,
    chaos::il2cpp::runtime_core::ThreadState* ts,
    void* native_fn_ptr
    {{~ for p in dt.params ~}}, {{ p.type }} chaos_thunk_arg_{{ p.index }}{{ end ~}}
) noexcept {
    using NativeFn = {{ dt.return_type }}(CHAOS_RUNTIME_ABI_CALL*)(
        {{~ for p in dt.params ~}}{{ p.type }}{{ if !forlast }}, {{ end }}{{ end ~}});
    auto fn = reinterpret_cast<NativeFn>(native_fn_ptr);
    {{~ if dt.return_type != "void" }}
    auto chaos_thunk_ret = fn({{ for p in dt.params }}chaos_thunk_arg_{{ p.index }}{{ if !forlast }}, {{ end }}{{ end }});
    return reinterpret_cast<void*>(static_cast<CHAOS_IL2CPP_INTPTR>(chaos_thunk_ret));
    {{~ else }}
    fn({{ for p in dt.params }}chaos_thunk_arg_{{ p.index }}{{ if !forlast }}, {{ end }}{{ end }});
    return nullptr;
    {{~ end }}
}

{{~ end }}

{{~ end ~}}
// ── Registration calls ──
// These populate the native-side delegate thunk registry so that
// MarshalGetFunctionPointerForDelegate and MarshalGetDelegateForFunctionPointer
// can find the correct dispatch thunk for each delegate type.

{{~ for dt in delegate_thunks ~}}
{{~ if dt.native_type_symbol }}
static CHAOS_IL2CPP_INTPTR g_thunk_target_{{ dt.native_type_symbol }} = 0;
{{~ end }}
{{~ end }}

void chaos_register_delegate_thunks() noexcept {
{{~ for dt in delegate_thunks ~}}
    RegisterDelegateThunk(
        "{{ dt.type_id }}",
        reinterpret_cast<void*>(&{{ dt.thunk_symbol }}),
        {{~ if dt.native_type_symbol }}&g_thunk_target_{{ dt.native_type_symbol }}{{ else }}nullptr{{ end }},
        {{~ if dt.has_custom_thunk }}{{ dt.params.size }}{{ else }}{{ dt.param_count }}{{ end ~}}
    );
{{~ end }}
}
{{~ end ~}}
