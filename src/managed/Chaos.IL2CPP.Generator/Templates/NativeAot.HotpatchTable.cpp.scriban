// ── Hotpatch name index + dispatch table ────────────────────
{{~ if is_empty ~}}
// No hotpatch data for this module
extern "C" const HotpatchModuleV0* chaos_il2cpp_aot_hotpatch_module
    = nullptr;
{{~ else ~}}
// Method name index entries
static constexpr HotpatchMethodEntryV0 s_hotpatch_methods[{{ total_method_count }}] = {
{{~ for type_group in type_groups ~}}
{{~ for entry in type_group.methods ~}}
    { "{{ entry.method_name_literal }}", 0x{{ entry.token_hex }}u, {{ entry.param_count }}u },  // {{ type_group.type_name }}
{{~ end ~}}
{{~ end ~}}
};

// Type name index entries (namespace, short_name)
static constexpr HotpatchTypeEntryV0 s_hotpatch_types[{{ type_group_count }}] = {
{{~ for type_group in type_groups ~}}
    { "{{ type_group.type_name_literal }}", "{{ type_group.type_namespace_literal }}", {{ type_group.first_method_index }}u, {{ type_group.method_count }}u },
{{~ end ~}}
};

// Token→Slot mapping (sorted by token for binary search)
static constexpr HotpatchSlotEntryV0 s_hotpatch_slots[{{ slot_count }}] = {
{{~ for slot in token_slots ~}}
    { 0x{{ slot.token_hex }}u, {{ slot.slot }}u },
{{~ end ~}}
};

// Dispatch table (function pointers)
// s_hotpatch_entries — external linkage for verification_dispatch
// NOTE: `static` is deliberately omitted so that the verification dispatch
// TU (verification_dispatch.generated.cpp) can access this array via
// GetHotpatchEntries(). Without external linkage, the linker cannot resolve
// the symbol across translation units.
extern "C" HotpatchEntryV0 s_hotpatch_entries[{{ total_method_count }}] = {
{{~ for entry in entries ~}}
    { reinterpret_cast<void*>(&{{ entry.native_symbol }}), reinterpret_cast<void*>(&InterpreterEntryDirect), 0ull, {{ entry.flags }} },  // {{ entry.type_name }}::{{ entry.method_name }}
{{~ end ~}}
};

// Accessor functions for verification_dispatch.generated.cpp
extern "C" const HotpatchEntryV0* GetHotpatchEntries() noexcept { return s_hotpatch_entries; }
extern "C" int32_t GetHotpatchEntryCount() noexcept { return {{ total_method_count }}; }

// Module hotpatch bundle
static constexpr HotpatchModuleV0 s_hotpatch_module = {
    "{{ assembly_name_literal }}",
    s_hotpatch_types,
    {{ type_group_count }}u,
    s_hotpatch_methods,
    {{ total_method_count }}u,
    s_hotpatch_slots,
    {{ slot_count }}u,
    s_hotpatch_entries,
    {{ total_method_count }}u,
};

// Expose hotpatch module to BootstrapRuntime
extern "C" const HotpatchModuleV0* chaos_il2cpp_aot_hotpatch_module
    = &s_hotpatch_module;

{{~ if reverse_pinvoke_count > 0 ~}}
// ── Reverse P/Invoke wrapper registration ──────────────────
static constexpr void* s_reverse_pinvoke_wrappers[{{ reverse_pinvoke_count }}] = {
{{~ for entry in reverse_pinvoke_entries ~}}
    reinterpret_cast<void*>(&{{ entry.native_symbol }}),
{{~ end ~}}
};

static const CHAOS_IL2CPP_UINT32 s_reverse_pinvoke_registered = []()
{
    ::chaos::il2cpp::runtime_core::RegisterReversePInvokeWrappers(
        s_reverse_pinvoke_wrappers, {{ reverse_pinvoke_count }}u);
    return 1u;
}();
{{~ end ~}}

{{~ if ccw_interface_count > 0 ~}}
// ── CCW interface vtable + forwarding thunks (V3) ────────
#include "com_typelib.h"
{{~ for ccw in ccw_interfaces ~}}
// {{ ccw.type_namespace }}.{{ ccw.type_name }}
static constexpr CHAOS_IL2CPP_UINT8 s_ccw_guid_{{ ccw.guid_symbol_suffix }}[16] = { {{ ccw.guid_bytes }} };

// Per-method forwarding thunks: dispatch through CcwDispatchMethod using the
// managed object's type info to find the interface implementation at runtime.
// This handles any implementing class (not known at compile time).
{{~ for method in ccw.methods ~}}
extern "C" void CcwThunk_{{ ccw.guid_symbol_suffix }}_{{ method.slot_index }}(void* self) {
    auto* entry_ccw = ::chaos::il2cpp::com_ccw::CcwFromInterface(self);
    if (entry_ccw == nullptr) return;
    ::chaos::il2cpp::com_ccw::CcwDispatchMethod(
        entry_ccw, {{ ccw.stable_id }}, {{ method.slot_index }}u);
}

{{~ end ~}}

{{~ if ccw.is_idispatch ~}}
// IDispatch vtable: 3 IUnknown + 4 IDispatch + {{ ccw.method_slot_count }} interface method slots
static void* s_ccw_vtable_{{ ccw.guid_symbol_suffix }}[{{ 7 + ccw.method_slot_count }}] = {
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwQueryInterface),
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwAddRef),
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwRelease),
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwGetTypeInfoCount),
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwGetTypeInfo),
    reinterpret_cast<void*>(&CcwThunk_{{ ccw.guid_symbol_suffix }}_GetIDsOfNames),
    reinterpret_cast<void*>(&CcwThunk_{{ ccw.guid_symbol_suffix }}_Invoke),
{{~ for method in ccw.methods ~}}
    reinterpret_cast<void*>(&CcwThunk_{{ ccw.guid_symbol_suffix }}_{{ method.slot_index }}),
{{~ end ~}}
};

// Method names array for GetIDsOfNames
static constexpr const char* s_ccw_names_{{ ccw.guid_symbol_suffix }}[] = {
{{~ for name in ccw.method_names ~}}
    "{{ name }}",
{{~ end ~}}
};

// GetIDsOfNames thunk
extern "C" CHAOS_IL2CPP_INT32 CcwThunk_{{ ccw.guid_symbol_suffix }}_GetIDsOfNames(
    void* self, const void* riid, void** rgszNames, CHAOS_IL2CPP_UINT32 cNames, CHAOS_IL2CPP_UINT32 lcid, CHAOS_IL2CPP_INT32* rgDispId)
{
    if (rgszNames == nullptr || rgDispId == nullptr) return ::chaos::il2cpp::com_ccw::kE_POINTER;
    if (cNames == 0) return ::chaos::il2cpp::com_ccw::kS_OK;
    if (cNames > 1) return ::chaos::il2cpp::com_ccw::kE_NOTIMPL;  // V1: single-name only

    auto* name = static_cast<const char16_t*>(rgszNames[0]);
    // Linear search through method names
    for (CHAOS_IL2CPP_UINT32 i = 0; i < {{ ccw.method_slot_count }}; i++) {
        const char* candidate = s_ccw_names_{{ ccw.guid_symbol_suffix }}[i];
        // Simple ASCII comparison: convert name to char and compare
        bool match = true;
        const char* s = candidate;
        const char16_t* w = name;
        while (*s && *w) {
            if (static_cast<char>(*w) != *s) { match = false; break; }
            s++; w++;
        }
        if (match && *s == 0 && *w == 0) {
            rgDispId[0] = static_cast<CHAOS_IL2CPP_INT32>(i);
            return ::chaos::il2cpp::com_ccw::kS_OK;
        }
    }
    return ::chaos::il2cpp::com_ccw::kDISP_E_MEMBERNOTFOUND;
}

// Invoke thunk
extern "C" CHAOS_IL2CPP_INT32 CcwThunk_{{ ccw.guid_symbol_suffix }}_Invoke(
    void* self, CHAOS_IL2CPP_INT32 dispIdMember, const void* riid, CHAOS_IL2CPP_UINT32 lcid,
    CHAOS_IL2CPP_UINT16 wFlags, void* pDispParams, void* pVarResult, void* pExcepInfo, CHAOS_IL2CPP_UINT32* puArgErr)
{
    auto* entry_ccw = ::chaos::il2cpp::com_ccw::CcwFromInterface(self);
    if (entry_ccw == nullptr) return ::chaos::il2cpp::com_ccw::kE_POINTER;

    return ::chaos::il2cpp::com_ccw::CcwDispatchMethodInvoke(
        entry_ccw, {{ ccw.stable_id }}, dispIdMember, pDispParams, pVarResult);
}

// Vtable: 3 IUnknown slots + {{ ccw.method_slot_count }} interface method slots
{{~ else ~}}
static void* s_ccw_vtable_{{ ccw.guid_symbol_suffix }}[{{ 3 + ccw.method_slot_count }}] = {
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwQueryInterface),
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwAddRef),
    reinterpret_cast<void*>(&::chaos::il2cpp::com_ccw::CcwRelease),
{{~ for method in ccw.methods ~}}
    reinterpret_cast<void*>(&CcwThunk_{{ ccw.guid_symbol_suffix }}_{{ method.slot_index }}),
{{~ end ~}}
};
{{~ end ~}}

{{~ if ccw.is_idispatch ~}}
// TypeLib: method descriptors for ITypeInfo/ITypeLib support
static constexpr ComMethodData s_ccw_methoddata_{{ ccw.guid_symbol_suffix }}[] = {
{{~ for method in ccw.methods ~}}
    { "{{ ccw.method_names[for.index] }}", {{ method.slot_index }}, {{ method.param_count }}, {{ 3 + method.slot_index }}, {{ method.token }}, nullptr },
{{~ end ~}}
};

// TypeLib: static TypeLib descriptor
static constexpr ComTypeLibData s_ccw_typelib_{{ ccw.guid_symbol_suffix }} = {
    s_ccw_guid_{{ ccw.guid_symbol_suffix }},
    {{ ccw.stable_id }},
    "{{ ccw.type_name }}",
    "{{ ccw.type_namespace }}",
    {{ ccw.method_slot_count }},
    1,  // is_idispatch
    s_ccw_methoddata_{{ ccw.guid_symbol_suffix }},
};
{{~ end ~}}

// Factory: create CCW and register this interface vtable
extern "C" CHAOS_IL2CPP_INTPTR CreateCcwFor_{{ ccw.guid_symbol_suffix }}(void* obj, void* state) {
    auto* ccw = reinterpret_cast<CHAOS_IL2CPP_INTPTR>(
        ::chaos::il2cpp::com_ccw::CreateCcw(obj, state));
    if (ccw) {
        ::chaos::il2cpp::com_ccw::RegisterCcwInterface(
            reinterpret_cast<void*>(ccw),
            s_ccw_guid_{{ ccw.guid_symbol_suffix }},
            const_cast<void**>(s_ccw_vtable_{{ ccw.guid_symbol_suffix }}));
{{~ if ccw.is_idispatch ~}}
        // Set TypeLib data for IDispatch support (enables ITypeInfo/ITypeLib QI)
        reinterpret_cast<::chaos::il2cpp::com_ccw::ComCcw*>(ccw)->typelib_data
            = &s_ccw_typelib_{{ ccw.guid_symbol_suffix }};
{{~ end ~}}
    }
    return ccw;
}

{{~ end ~}}
// Static factory registration: register each factory into the runtime registry.
static const CHAOS_IL2CPP_UINT32 s_ccw_factory_registered = []()
{
{{~ for ccw in ccw_interfaces ~}}
    ::chaos::il2cpp::runtime_core::RegisterCcwFactory(
        {{ ccw.stable_id }},
        CreateCcwFor_{{ ccw.guid_symbol_suffix }});
{{~ end ~}}
    return 1u;
}();
{{~ end ~}}
{{~ end ~}}