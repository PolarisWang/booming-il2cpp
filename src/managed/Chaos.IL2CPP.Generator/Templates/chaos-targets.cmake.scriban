# Generated by chaos-il2cpp convert-to-cpp --sdk-out
# chaos-targets.cmake — chaos-il2cpp SDK target definitions
# Loaded by chaos-config.cmake, not meant to be included directly.

# ── chaos::runtime (INTERFACE IMPORTED) ──────────────────────────────────
# Aggregates all prebuilt native runtime libraries + include dirs + flags.
# Consumer links against this to get the full runtime environment.
add_library(chaos::runtime INTERFACE IMPORTED)

target_include_directories(chaos::runtime INTERFACE
    "${CHAOS_SDK_ROOT}/include"
)

# Compile options required by the runtime headers
target_compile_options(chaos::runtime INTERFACE
    "$<$<CXX_COMPILER_ID:MSVC>:/utf-8>"
    "$<$<CXX_COMPILER_ID:MSVC>:/EHa>"
    "$<$<CXX_COMPILER_ID:MSVC>:/GS->"
    "$<$<CXX_COMPILER_ID:MSVC>:/DWIN32 /D_WINDOWS>"
    "$<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-fexceptions>"
    "$<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-finput-charset=utf-8>"
)

target_compile_features(chaos::runtime INTERFACE
    cxx_std_20
)

# Prebuilt native runtime libraries
# Linux: --start-group/--end-group needed for circular deps between static libs.
target_link_libraries(chaos::runtime INTERFACE
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_common.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_support.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_fmt.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_runtime_core.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_interpreter.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_bootstrap.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_hot_update.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_eventpipe.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_jit.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:${CHAOS_SDK_ROOT}/lib/chaos_debugger.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:concrt.lib>"
    "$<$<CXX_COMPILER_ID:MSVC>:msvcprt.lib>"
)

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  target_link_libraries(chaos::runtime INTERFACE
      "-Wl,--start-group"
      "${CHAOS_SDK_ROOT}/lib/libchaos_common.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_support.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_fmt.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_runtime_core.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_interpreter.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_bootstrap.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_hot_update.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_eventpipe.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_jit.a"
      "${CHAOS_SDK_ROOT}/lib/libchaos_debugger.a"
      "-Wl,--end-group"
      "-lnuma"
      "-lpthread"
      "-ldl"
  )
endif()

# ── chaos::codegen (STATIC IMPORTED) ────────────────────────────────────
# Precompiled generated C++ code (native-aot.generated.cpp → .lib).
# Consumers link this to get the AOT-compiled method bodies.
#
# Requires chaos::runtime to be linked separately.
add_library(chaos::codegen STATIC IMPORTED)

target_include_directories(chaos::codegen INTERFACE
    "${CHAOS_SDK_ROOT}/include"
)

set_target_properties(chaos::codegen PROPERTIES
    IMPORTED_LOCATION "${CHAOS_SDK_ROOT}/lib/chaos_codegen.lib"
)
