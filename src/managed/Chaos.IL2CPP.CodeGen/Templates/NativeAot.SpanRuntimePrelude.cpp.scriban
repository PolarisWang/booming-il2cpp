const std::uint8_t chaos_static_field_data_{{ entry.sanitized_field_subject_id }}[] =
{
{{~ for row in entry.byte_rows ~}}
{{ row }}
{{~ end ~}}
};

{{~ end ~}}
bool chaos_try_get_static_field_data(
    std::intptr_t chaos_field_handle,
    const std::uint8_t*& chaos_data,
    std::size_t& chaos_size)
{
{{~ for entry in field_data_entries ~}}
    if (chaos_field_handle == {{ entry.field_handle_literal }})
    {
        chaos_data = chaos_static_field_data_{{ entry.sanitized_field_subject_id }};
        chaos_size = sizeof(chaos_static_field_data_{{ entry.sanitized_field_subject_id }});
        return true;
    }
{{~ end ~}}
    chaos_data = nullptr;
    chaos_size = 0;
    return false;
}

void* chaos_resolve_block_copy_address(std::intptr_t chaos_address)
{
    if ((chaos_address & chaos_raw_int32_pointer_tag) != 0)
    {
        return reinterpret_cast<void*>(static_cast<std::uintptr_t>(chaos_address & ~chaos_raw_int32_pointer_tag));
    }
    if ((chaos_address & chaos_managed_pointer_local_slot_tag) != 0)
    {
        return reinterpret_cast<void*>(static_cast<std::uintptr_t>(chaos_address & ~chaos_managed_pointer_local_slot_tag));
    }
    return reinterpret_cast<void*>(chaos_address);
}

enum class chaos_span_storage_kind : std::uint8_t
{
    array = 1,
    rawInt32 = 2,
};

struct chaos_span_runtime_entry
{
    chaos_span_storage_kind storage_kind = chaos_span_storage_kind::array;
    std::intptr_t owner_handle = 0;
    std::intptr_t data_handle = 0;
    std::int32_t start = 0;
    std::int32_t length = 0;
    bool read_only = false;
};

struct chaos_memory_runtime_entry
{
    std::intptr_t array_handle = 0;
    std::int32_t start = 0;
    std::int32_t length = 0;
};

chaos_span_runtime_entry* chaos_require_span_runtime_entry(std::intptr_t chaos_handle)
{
    if (chaos_handle == static_cast<std::intptr_t>(0))
    {
        std::abort();
    }
    return reinterpret_cast<chaos_span_runtime_entry*>(chaos_handle);
}

chaos_memory_runtime_entry* chaos_require_memory_runtime_entry(std::intptr_t chaos_handle)
{
    if (chaos_handle == static_cast<std::intptr_t>(0))
    {
        std::abort();
    }
    return reinterpret_cast<chaos_memory_runtime_entry*>(chaos_handle);
}

std::intptr_t chaos_create_array_span_int32(std::intptr_t chaos_array_value, std::int32_t chaos_start, std::int32_t chaos_length)
{
    auto* chaos_array = reinterpret_cast<chaos_managed_array*>(chaos_array_value);
    if (chaos_array == nullptr ||
        chaos_array->element_type_shape != chaos_type_shape_value ||
        chaos_start < 0 ||
        chaos_length < 0 ||
        chaos_start > static_cast<std::int32_t>(chaos_array->length) ||
        chaos_length > static_cast<std::int32_t>(chaos_array->length) - chaos_start)
    {
        std::abort();
    }
    auto* chaos_entry = new chaos_span_runtime_entry{};
    chaos_entry->storage_kind = chaos_span_storage_kind::array;
    chaos_entry->owner_handle = chaos_array_value;
    chaos_entry->start = chaos_start;
    chaos_entry->length = chaos_length;
    return reinterpret_cast<std::intptr_t>(chaos_entry);
}

std::intptr_t chaos_create_raw_span_int32(void* chaos_data, std::int32_t chaos_length, bool chaos_read_only)
{
    if (chaos_length < 0)
    {
        std::abort();
    }
    auto* chaos_entry = new chaos_span_runtime_entry{};
    chaos_entry->storage_kind = chaos_span_storage_kind::rawInt32;
    chaos_entry->data_handle = reinterpret_cast<std::intptr_t>(chaos_data);
    chaos_entry->length = chaos_length;
    chaos_entry->read_only = chaos_read_only;
    return reinterpret_cast<std::intptr_t>(chaos_entry);
}

std::intptr_t chaos_create_array_memory_int32(std::intptr_t chaos_array_value, std::int32_t chaos_start, std::int32_t chaos_length);

std::intptr_t chaos_create_memory_int32(std::intptr_t chaos_array_value)
{
    auto* chaos_array = reinterpret_cast<chaos_managed_array*>(chaos_array_value);
    if (chaos_array == nullptr || chaos_array->element_type_shape != chaos_type_shape_value)
    {
        std::abort();
    }
    return chaos_create_array_memory_int32(chaos_array_value, 0, static_cast<std::int32_t>(chaos_array->length));
}

std::intptr_t chaos_create_array_memory_int32(std::intptr_t chaos_array_value, std::int32_t chaos_start, std::int32_t chaos_length)
{
    auto* chaos_array = reinterpret_cast<chaos_managed_array*>(chaos_array_value);
    if (chaos_array == nullptr ||
        chaos_array->element_type_shape != chaos_type_shape_value ||
        chaos_start < 0 ||
        chaos_length < 0 ||
        chaos_start > static_cast<std::int32_t>(chaos_array->length) ||
        chaos_length > static_cast<std::int32_t>(chaos_array->length) - chaos_start)
    {
        std::abort();
    }
    auto* chaos_entry = new chaos_memory_runtime_entry{};
    chaos_entry->array_handle = chaos_array_value;
    chaos_entry->start = chaos_start;
    chaos_entry->length = chaos_length;
    return reinterpret_cast<std::intptr_t>(chaos_entry);
}

std::intptr_t chaos_memory_int32_get_span(std::intptr_t chaos_memory_handle)
{
    auto* chaos_memory = chaos_require_memory_runtime_entry(chaos_memory_handle);
    return chaos_create_array_span_int32(chaos_memory->array_handle, chaos_memory->start, chaos_memory->length);
}

std::int32_t chaos_span_int32_get_length(std::intptr_t chaos_span_handle)
{
    return chaos_require_span_runtime_entry(chaos_span_handle)->length;
}

std::intptr_t chaos_span_int32_get_item_address(std::intptr_t chaos_span_handle, std::int32_t chaos_index)
{
    auto* chaos_span = chaos_require_span_runtime_entry(chaos_span_handle);
    if (chaos_index < 0 || chaos_index >= chaos_span->length)
    {
        std::abort();
    }
    switch (chaos_span->storage_kind)
    {
        case chaos_span_storage_kind::array:
        {
            auto* chaos_array = reinterpret_cast<chaos_managed_array*>(chaos_span->owner_handle);
            return reinterpret_cast<std::intptr_t>(&chaos_array->elements[static_cast<std::size_t>(chaos_span->start + chaos_index)]);
        }
        case chaos_span_storage_kind::rawInt32:
        {
            auto* chaos_item = reinterpret_cast<std::int32_t*>(chaos_span->data_handle) + chaos_index;
            return reinterpret_cast<std::intptr_t>(chaos_item) | chaos_raw_int32_pointer_tag;
        }
        default:
            std::abort();
    }
}

void chaos_initialize_array_from_field_data_int32(std::intptr_t chaos_array_value, std::intptr_t chaos_field_handle)
{
    auto* chaos_array = reinterpret_cast<chaos_managed_array*>(chaos_array_value);
    if (chaos_array == nullptr || chaos_array->element_type_shape != chaos_type_shape_value)
    {
        std::abort();
    }
    const std::uint8_t* chaos_bytes = nullptr;
    std::size_t chaos_size = 0;
    if (!chaos_try_get_static_field_data(chaos_field_handle, chaos_bytes, chaos_size) ||
        (chaos_size % sizeof(std::int32_t)) != 0)
    {
        std::abort();
    }
    const auto chaos_element_count = static_cast<std::int32_t>(chaos_size / sizeof(std::int32_t));
    if (chaos_element_count > static_cast<std::int32_t>(chaos_array->length))
    {
        std::abort();
    }
    for (std::int32_t chaos_index = 0; chaos_index < chaos_element_count; chaos_index++)
    {
        std::int32_t chaos_value = 0;
        std::memcpy(&chaos_value, chaos_bytes + (static_cast<std::size_t>(chaos_index) * sizeof(std::int32_t)), sizeof(chaos_value));
        chaos_array->elements[static_cast<std::size_t>(chaos_index)] = static_cast<std::intptr_t>(chaos_value);
    }
}

std::intptr_t chaos_create_field_data_span_int32(std::intptr_t chaos_field_handle)
{
    const std::uint8_t* chaos_bytes = nullptr;
    std::size_t chaos_size = 0;
    if (!chaos_try_get_static_field_data(chaos_field_handle, chaos_bytes, chaos_size) ||
        (chaos_size % sizeof(std::int32_t)) != 0)
    {
        std::abort();
    }
    return chaos_create_raw_span_int32(const_cast<std::uint8_t*>(chaos_bytes), static_cast<std::int32_t>(chaos_size / sizeof(std::int32_t)), true);
}
