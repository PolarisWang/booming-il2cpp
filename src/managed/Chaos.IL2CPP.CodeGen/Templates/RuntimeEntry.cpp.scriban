{{~ if entry_subject_id ~}}
// Forward declaration of the entry point function
extern "C" int {{ native_entry_function_name }}(int32_t);
{{~ end ~}}

int main(int argc, char** argv)
{
    // Step 1: Get the codegen bridge and register all modules
    auto* bridge = chaos_codegen_get_bridge_v0();
    if (!bridge)
