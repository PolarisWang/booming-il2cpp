    CHAOS_IL2CPP_INT32 worker_slot = 0;
    CHAOS_IL2CPP_SIZE worker_root_count = 0u;
    bool worker_ok = false;
    CHAOS_IL2CPP_THREAD worker([&]() {
        ThreadState* worker_thread = nullptr;
        if (abi->thread_attach(runtime, &worker_thread) != CHAOS_RUNTIME_STATUS_OK || worker_thread == nullptr) {
