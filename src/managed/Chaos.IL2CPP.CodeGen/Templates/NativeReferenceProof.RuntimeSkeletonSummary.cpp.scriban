// assembly-full-closure-runtime-skeleton
// generated executable skeleton for assembly-bound native-reference runtime emission
#include "bootstrap.h"
#include "codegen_bridge.h"
#include "memory_domain.h"
#include <cstddef>
#include <cstdint>
#include <cstring>

namespace chaos::il2cpp::generated
{
namespace runtime_skeleton
{
constexpr const char* kAssemblyName = {{ assembly_name_literal }};
constexpr const char* kPlanKind = {{ plan_kind_literal }};
constexpr const char* kRuntimeExecutionKind = {{ runtime_execution_kind_literal }};
constexpr const char* kTranslationUnitMode = {{ translation_unit_mode_literal }};
constexpr CHAOS_IL2CPP_SIZE translation_unit_method_count = {{ translation_unit_method_count }};
constexpr CHAOS_IL2CPP_SIZE translation_unit_page_size = {{ translation_unit_page_size }};
constexpr CHAOS_IL2CPP_SIZE translation_unit_page_count = {{ translation_unit_page_count }};
using NativeReferenceAssemblyPageDispatchFn = int32_t (CHAOS_RUNTIME_ABI_CALL*)(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 method_slot,
    void* managed_args);

struct NativeReferenceAssemblyDispatchRequest
{
    const char* subject_id;
    void* managed_args;
    CHAOS_IL2CPP_UINT32 method_id;
};

struct RuntimeSkeletonMethodDispatchCatalogEntry
{
    CHAOS_IL2CPP_UINT32 method_id;
    const char* subject_id;
    NativeReferenceAssemblyPageDispatchFn dispatch;
    CHAOS_IL2CPP_UINT32 method_slot;
};

{{~ if has_type_capability_entries ~}}
constexpr RuntimeTypeCapabilityEntryV0 kTypeCapabilityEntries[] =
{
{{~ for entry in type_capability_entries ~}}
{{ entry }}
{{ end ~}}
};
constexpr CHAOS_IL2CPP_SIZE kTypeCapabilityEntryCount = {{ type_capability_entry_count }};
{{~ else ~}}
constexpr CHAOS_IL2CPP_SIZE kTypeCapabilityEntryCount = 0;
{{~ end ~}}

{{~ for declaration in page_dispatch_declarations ~}}
{{ declaration }}
{{ end ~}}

{{~ if has_method_dispatch_entries ~}}
constexpr RuntimeSkeletonMethodDispatchCatalogEntry kMethodDispatchCatalog[] =
{
{{~ for entry in method_dispatch_catalog_entries ~}}
{{ entry }}
{{ end ~}}
};
constexpr CHAOS_IL2CPP_SIZE kMethodDispatchCatalogCount = sizeof(kMethodDispatchCatalog) / sizeof(kMethodDispatchCatalog[0]);
{{~ else ~}}
constexpr CHAOS_IL2CPP_SIZE kMethodDispatchCatalogCount = 0;
{{~ end ~}}

const RuntimeSkeletonMethodDispatchCatalogEntry* FindMethodDispatchCatalogEntry(const char* subject_id)
{
    if (subject_id == nullptr || subject_id[0] == '\0') {
        return nullptr;
    }

{{~ if !has_method_dispatch_entries ~}}
    return nullptr;
{{~ else ~}}

    CHAOS_IL2CPP_SIZE left = 0;
    CHAOS_IL2CPP_SIZE right = kMethodDispatchCatalogCount;
    while (left < right) {
        const CHAOS_IL2CPP_SIZE mid = left + ((right - left) / 2);
        const auto& entry = kMethodDispatchCatalog[mid];
        const int compare = CHAOS_IL2CPP_STRCMP(entry.subject_id, subject_id);
        if (compare < 0) {
            left = mid + 1;
            continue;
        }

        if (compare > 0) {
            right = mid;
            continue;
        }

        return &entry;
    }

    return nullptr;
{{~ end ~}}
}

const RuntimeSkeletonMethodDispatchCatalogEntry* FindMethodDispatchCatalogEntryByMethodId(CHAOS_IL2CPP_UINT32 method_id)
{
    if (method_id == 0) {
        return nullptr;
    }

{{~ if !has_method_dispatch_entries ~}}
    return nullptr;
{{~ else ~}}
    CHAOS_IL2CPP_SIZE left = 0;
    CHAOS_IL2CPP_SIZE right = kMethodDispatchCatalogCount;
    while (left < right) {
        const CHAOS_IL2CPP_SIZE mid = left + ((right - left) / 2);
        const auto& entry = kMethodDispatchCatalog[mid];
        if (entry.method_id < method_id) {
            left = mid + 1;
            continue;
        }

        if (entry.method_id > method_id) {
            right = mid;
            continue;
        }

        return &entry;
    }

    return nullptr;
{{~ end ~}}
}

int32_t DispatchAssemblySubject(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    const char* subject_id,
    void* managed_args)
{
    if (subject_id == nullptr || subject_id[0] == '\0') {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    const auto* method = FindMethodDispatchCatalogEntry(subject_id);
    if (method == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_FOUND;
    }

    return method->dispatch(
        bridge,
        code_registration,
        metadata_registration,
        options,
        runtime,
        thread,
        method->method_slot,
        managed_args);
}

int32_t DispatchAssemblyMethodId(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 method_id,
    void* managed_args)
{
    const auto* method = FindMethodDispatchCatalogEntryByMethodId(method_id);
    if (method == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_FOUND;
    }

    return method->dispatch(
        bridge,
        code_registration,
        metadata_registration,
        options,
        runtime,
        thread,
        method->method_slot,
        managed_args);
}
}  // namespace runtime_skeleton

int32_t CHAOS_RUNTIME_ABI_CALL {{ native_entry_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    (void)managed_args;
    if (bridge == nullptr || code_registration == nullptr || metadata_registration == nullptr || options == nullptr || runtime == nullptr || thread == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    // Push the memory domain for this assembly so marshal allocations
    // during bootstrap and method dispatch are attributed correctly.
    // Hot-update packages are registered under their assembly name by
    // LoadHotUpdatePackage; AOT assemblies fall back to the AOT root domain.
    namespace md = chaos::il2cpp::memory_domain;
    auto* domain = md::FindDomainByName(runtime_skeleton::kAssemblyName);
    if (domain == nullptr) {
        domain = md::FindDomainById(chaos::il2cpp::bootstrap::GetAotDomainId());
    }
    md::DomainScope domain_scope(domain);

    CodeRegistrationV0 local_code_registration = *code_registration;
{{~ if has_type_capability_entries ~}}
    local_code_registration.type_capabilities = kTypeCapabilityEntries;
    local_code_registration.type_capability_count = static_cast<CHAOS_IL2CPP_UINT32>(kTypeCapabilityEntryCount);
{{~ end ~}}
    const BridgeStatus register_status = bridge->register_codegen(&local_code_registration, metadata_registration, options);
    if (register_status != CHAOS_BRIDGE_STATUS_OK) {
        return register_status;
    }
    const BridgeStatus bootstrap_status = bridge->bootstrap_runtime();
    if (bootstrap_status != CHAOS_BRIDGE_STATUS_OK) {
        return bootstrap_status;
    }
    if (managed_args == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }
    const auto* request = static_cast<const runtime_skeleton::NativeReferenceAssemblyDispatchRequest*>(managed_args);
    if (request->method_id != 0) {
        return runtime_skeleton::DispatchAssemblyMethodId(
            bridge,
            &local_code_registration,
            metadata_registration,
            options,
            runtime,
            thread,
            request->method_id,
            request->managed_args);
    }
    return runtime_skeleton::DispatchAssemblySubject(
        bridge,
        &local_code_registration,
        metadata_registration,
        options,
        runtime,
        thread,
        request->subject_id,
        request->managed_args);
}

int32_t CHAOS_RUNTIME_ABI_CALL RunNativeReference(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    return {{ native_entry_function_name }}(bridge, code_registration, metadata_registration, options, runtime, thread, managed_args);
}
}  // namespace chaos::il2cpp::generated
