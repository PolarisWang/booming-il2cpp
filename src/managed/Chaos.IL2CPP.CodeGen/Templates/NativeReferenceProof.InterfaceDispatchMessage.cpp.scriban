#include "{{ include_header }}"
#include <chrono>
#include <cstdio>

namespace chaos::il2cpp::generated {

namespace {

using ConcatStringPairFn = void* (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* left_string,
    const void* right_string);
using WriteLineStringFn = CHAOS_IL2CPP_INT32 (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* string_object);

struct UnresolvedVirtualCallEntry {
    CHAOS_IL2CPP_UINT32 instance_type_token;
    CHAOS_IL2CPP_UINT32 declared_method_token;
    void* resolved_method;
};

constexpr CHAOS_IL2CPP_UINT32 kReferenceTypeToken = {{ reference_type_token }};
constexpr CHAOS_IL2CPP_UINT32 kCapturedFieldToken = {{ captured_field_token }};
constexpr CHAOS_IL2CPP_UINT32 kEntryMethodToken = {{ entry_method_token }};
constexpr CHAOS_IL2CPP_UINT32 kConstructorMethodToken = {{ constructor_method_token }};
constexpr CHAOS_IL2CPP_UINT32 kInstanceMethodToken = {{ instance_method_token }};
constexpr const char* kDefaultImageName = "{{ assembly_name }}";
constexpr const char* kConsoleWriteLineStringIcall = "{{ console_write_line_string_icall }}";
constexpr const char* kStringConcatPairIcall = "{{ string_concat_pair_icall }}";
constexpr bool kUseDevirtualizedDirect =
{{ if dispatch_strategy == "devirtualized-direct" }}true{{ else }}false{{ end }};
constexpr CHAOS_IL2CPP_UINT32 kProfileWarmupIterationCount = 4096u;
constexpr CHAOS_IL2CPP_UINT32 kProfileMeasurementIterationCount = 2000000u;

struct NativeReferenceContext {
    const RuntimeAbiV0* abi;
    const CodegenBridgeV0* bridge;
    ImageHandle image;
    TypeInfoHandle reference_type;
    FieldInfoHandle captured_field;
    MethodInfoHandle entry_method;
    MethodInfoHandle constructor_method;
    MethodInfoHandle instance_method;
    ConcatStringPairFn concat_string_pair;
    WriteLineStringFn write_line_string;
};

NativeReferenceContext g_native_reference_context = {};

ImageHandle GetNativeReferenceImage(const CodegenRegistrationOptionsV0* options) {
    const char* image_name = options != nullptr && options->image_name_utf8 != nullptr
        ? options->image_name_utf8
        : kDefaultImageName;
    return reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
}

void ResetNativeReferenceContext() {
    g_native_reference_context = {};
}

bool InitializeNativeReferenceContext(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options) {
    if (bridge == nullptr) {
        return false;
    }

    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        return false;
    }

    g_native_reference_context.abi = abi;
    g_native_reference_context.bridge = bridge;
    g_native_reference_context.image = GetNativeReferenceImage(options);
    g_native_reference_context.reference_type = bridge->resolve_type_by_token(g_native_reference_context.image, kReferenceTypeToken);
    g_native_reference_context.captured_field = bridge->resolve_field_by_token(g_native_reference_context.image, kCapturedFieldToken);
    g_native_reference_context.entry_method = bridge->resolve_method_by_token(g_native_reference_context.image, kEntryMethodToken);
    g_native_reference_context.constructor_method = bridge->resolve_method_by_token(g_native_reference_context.image, kConstructorMethodToken);
    g_native_reference_context.instance_method = bridge->resolve_method_by_token(g_native_reference_context.image, kInstanceMethodToken);

    void* raw_concat_string_pair = bridge->resolve_icall(kStringConcatPairIcall);
    void* raw_write_line_string = bridge->resolve_icall(kConsoleWriteLineStringIcall);
    g_native_reference_context.concat_string_pair = reinterpret_cast<ConcatStringPairFn>(raw_concat_string_pair);
    g_native_reference_context.write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);

    return g_native_reference_context.image != nullptr
        && g_native_reference_context.reference_type != nullptr
        && g_native_reference_context.captured_field != nullptr
        && g_native_reference_context.entry_method != nullptr
        && g_native_reference_context.constructor_method != nullptr
        && g_native_reference_context.instance_method != nullptr
        && g_native_reference_context.concat_string_pair != nullptr
        && g_native_reference_context.write_line_string != nullptr;
}

bool EnsureNativeReferenceContextReady(
    RuntimeState* runtime,
    ThreadState* thread) {
    return runtime != nullptr
        && thread != nullptr
        && g_native_reference_context.abi != nullptr
        && g_native_reference_context.bridge != nullptr
        && g_native_reference_context.image != nullptr
        && g_native_reference_context.reference_type != nullptr
        && g_native_reference_context.captured_field != nullptr
        && g_native_reference_context.entry_method != nullptr
        && g_native_reference_context.constructor_method != nullptr
        && g_native_reference_context.instance_method != nullptr
        && g_native_reference_context.concat_string_pair != nullptr
        && g_native_reference_context.write_line_string != nullptr;
}

}  // namespace

extern "C" void CHAOS_RUNTIME_ABI_CALL {{ constructor_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* __this,
    void* arg0) {
    if (!EnsureNativeReferenceContextReady(runtime, thread) || __this == nullptr) {
        return;
    }

    if (g_native_reference_context.abi->field_set_value(
            runtime,
            thread,
            g_native_reference_context.captured_field,
            __this,
            &arg0,
            sizeof(arg0)) != CHAOS_RUNTIME_STATUS_OK) {
        return;
    }
}

extern "C" void* CHAOS_RUNTIME_ABI_CALL {{ instance_method_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* __this) {
    if (!EnsureNativeReferenceContextReady(runtime, thread) || __this == nullptr) {
        return nullptr;
    }

    void* captured_value = nullptr;
    if (g_native_reference_context.abi->field_get_value(
            runtime,
            thread,
            g_native_reference_context.captured_field,
            __this,
            &captured_value,
            sizeof(captured_value)) != CHAOS_RUNTIME_STATUS_OK) {
        return nullptr;
    }

#if defined(CHAOS_VARIANT_PROFILE)
    return captured_value;
#else
    void* message_prefix = g_native_reference_context.abi->string_new_utf8(
        runtime,
        thread,
        {{ message_prefix_literal }},
        {{ message_prefix_literal_byte_count }}u);
    if (message_prefix == nullptr) {
        return nullptr;
    }

    void* combined_message = g_native_reference_context.concat_string_pair(
        runtime,
        thread,
        message_prefix,
        captured_value);
    if (combined_message == nullptr) {
        return nullptr;
    }

    void* message_suffix = g_native_reference_context.abi->string_new_utf8(
        runtime,
        thread,
        {{ message_suffix_literal }},
        {{ message_suffix_literal_byte_count }}u);
    if (message_suffix == nullptr) {
        return nullptr;
    }

    return g_native_reference_context.concat_string_pair(runtime, thread, combined_message, message_suffix);
#endif
}

namespace {

MethodInfoHandle ResolveInstanceMessageMethod() {
    return g_native_reference_context.bridge->resolve_virtual_method(
        g_native_reference_context.reference_type,
        g_native_reference_context.instance_method);
}

bool InvokeResolvedInstanceMessage(
    RuntimeState* runtime,
    ThreadState* thread,
    void* instance,
    MethodInfoHandle resolved_method,
    void** return_value) {
    if (resolved_method == nullptr || return_value == nullptr) {
        return false;
    }

    *return_value = nullptr;
    return g_native_reference_context.bridge->invoke_virtual(
            runtime,
            thread,
            instance,
            resolved_method,
            nullptr,
            0u,
            return_value,
            sizeof(void*),
            nullptr) == CHAOS_BRIDGE_STATUS_OK
        && *return_value != nullptr;
}

void* InvokeInstanceMessage(
    RuntimeState* runtime,
    ThreadState* thread,
    void* instance) {
{{ if dispatch_strategy == "devirtualized-direct" }}
    return {{ instance_method_symbol }}(runtime, thread, instance);
{{ else }}
    MethodInfoHandle resolved_method = ResolveInstanceMessageMethod();
    if (resolved_method == nullptr) {
        return nullptr;
    }

    void* return_value = nullptr;
    if (!InvokeResolvedInstanceMessage(runtime, thread, instance, resolved_method, &return_value)) {
        return nullptr;
    }

    return return_value;
{{ end }}
}

#if defined(CHAOS_VARIANT_PROFILE)
double MeasureDirectDispatchTotalNanoseconds(
    RuntimeState* runtime,
    ThreadState* thread,
    void* instance,
    CHAOS_IL2CPP_UINT32 iterations) {
    const auto started = CHAOS_IL2CPP_CHRONO_STEADY_CLOCK::now();
    for (CHAOS_IL2CPP_UINT32 iteration = 0; iteration < iterations; ++iteration) {
        if ({{ instance_method_symbol }}(runtime, thread, instance) == nullptr) {
            return -1.0;
        }
    }

    return CHAOS_IL2CPP_CHRONO_DURATION(double, CHAOS_IL2CPP_NANO)(
        CHAOS_IL2CPP_CHRONO_STEADY_CLOCK::now() - started).count();
}

double MeasureVirtualDispatchTotalNanoseconds(
    RuntimeState* runtime,
    ThreadState* thread,
    void* instance,
    MethodInfoHandle resolved_method,
    CHAOS_IL2CPP_UINT32 iterations) {
    const auto started = CHAOS_IL2CPP_CHRONO_STEADY_CLOCK::now();
    for (CHAOS_IL2CPP_UINT32 iteration = 0; iteration < iterations; ++iteration) {
        void* return_value = nullptr;
        if (!InvokeResolvedInstanceMessage(runtime, thread, instance, resolved_method, &return_value)) {
            return -1.0;
        }
    }

    return CHAOS_IL2CPP_CHRONO_DURATION(double, CHAOS_IL2CPP_NANO)(
        CHAOS_IL2CPP_CHRONO_STEADY_CLOCK::now() - started).count();
}

bool WarmProfileDispatch(
    RuntimeState* runtime,
    ThreadState* thread,
    void* instance,
    MethodInfoHandle resolved_method) {
    if (resolved_method == nullptr) {
        return false;
    }

    for (CHAOS_IL2CPP_UINT32 iteration = 0; iteration < kProfileWarmupIterationCount; ++iteration) {
        if ({{ instance_method_symbol }}(runtime, thread, instance) == nullptr) {
            return false;
        }
    }

    for (CHAOS_IL2CPP_UINT32 iteration = 0; iteration < kProfileWarmupIterationCount; ++iteration) {
        void* return_value = nullptr;
        if (!InvokeResolvedInstanceMessage(runtime, thread, instance, resolved_method, &return_value)) {
            return false;
        }
    }

    return true;
}

CHAOS_IL2CPP_INT32 RunProfileDispatch(
    RuntimeState* runtime,
    ThreadState* thread,
    void* instance) {
    MethodInfoHandle resolved_method = ResolveInstanceMessageMethod();
    if (resolved_method == nullptr) {
        return 1;
    }

    if (!WarmProfileDispatch(runtime, thread, instance, resolved_method)) {
        return 1;
    }

    const double direct_total_nanoseconds = MeasureDirectDispatchTotalNanoseconds(
        runtime,
        thread,
        instance,
        kProfileMeasurementIterationCount);
    const double virtual_total_nanoseconds = MeasureVirtualDispatchTotalNanoseconds(
        runtime,
        thread,
        instance,
        resolved_method,
        kProfileMeasurementIterationCount);
    if (direct_total_nanoseconds < 0.0 || virtual_total_nanoseconds < 0.0) {
        return 1;
    }

    double dispatch_nanoseconds = (virtual_total_nanoseconds - direct_total_nanoseconds)
        / static_cast<double>(kProfileMeasurementIterationCount);
    if (dispatch_nanoseconds < 0.0) {
        dispatch_nanoseconds = 0.0;
    }

    const double elapsed_milliseconds = virtual_total_nanoseconds / 1000000.0;
    CHAOS_IL2CPP_PRINTF(
        "{\"elapsedMilliseconds\": %.3f, \"metrics\": {\"dispatchNanoseconds\": %.3f}}\n",
        elapsed_milliseconds,
        dispatch_nanoseconds);
    CHAOS_IL2CPP_FFLUSH(stdout);
    return 0;
}
#endif

}  // namespace

extern "C" CHAOS_IL2CPP_INT32 CHAOS_RUNTIME_ABI_CALL {{ entry_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    (void)managed_args;

    if (!EnsureNativeReferenceContextReady(runtime, thread)) {
        return 1;
    }

    if (g_native_reference_context.abi->class_init(runtime, g_native_reference_context.reference_type) != CHAOS_RUNTIME_STATUS_OK) {
        return 1;
    }

    void* constructor_argument = g_native_reference_context.abi->string_new_utf8(
        runtime,
        thread,
        {{ constructor_literal }},
        {{ constructor_literal_byte_count }}u);
    if (constructor_argument == nullptr) {
        return 1;
    }

    void* constructed_instance = g_native_reference_context.abi->object_new(
        runtime,
        thread,
        g_native_reference_context.reference_type);
    if (constructed_instance == nullptr) {
        return 1;
    }

    {{ constructor_symbol }}(runtime, thread, constructed_instance, constructor_argument);
#if defined(CHAOS_VARIANT_PROFILE)
    return RunProfileDispatch(runtime, thread, constructed_instance);
#else
    void* message = InvokeInstanceMessage(runtime, thread, constructed_instance);
    if (message == nullptr) {
        return 1;
    }

    return g_native_reference_context.write_line_string(runtime, thread, message);
#endif
}

CHAOS_IL2CPP_INT32 {{ native_reference_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    ResetNativeReferenceContext();

    if (bridge == nullptr
        || code_registration == nullptr
        || metadata_registration == nullptr
        || options == nullptr
        || runtime == nullptr
        || thread == nullptr) {
        return 1;
    }

    const UnresolvedVirtualCallEntry unresolved_virtual_calls[] = {
        { kReferenceTypeToken, kInstanceMethodToken, reinterpret_cast<void*>(&{{ instance_method_symbol }}) },
    };

    CodeRegistrationV0 registered_code_registration = *code_registration;
    registered_code_registration.unresolved_virtual_calls = unresolved_virtual_calls;
    registered_code_registration.unresolved_virtual_call_count =
        static_cast<CHAOS_IL2CPP_UINT32>(sizeof(unresolved_virtual_calls) / sizeof(unresolved_virtual_calls[0]));

    if (bridge->register_codegen(&registered_code_registration, metadata_registration, options) != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (bridge->bootstrap_runtime() != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (!InitializeNativeReferenceContext(bridge, options)) {
        return 1;
    }

    (void)kUseDevirtualizedDirect;
    return {{ entry_symbol }}(runtime, thread, managed_args);
}

}  // namespace chaos::il2cpp::generated
