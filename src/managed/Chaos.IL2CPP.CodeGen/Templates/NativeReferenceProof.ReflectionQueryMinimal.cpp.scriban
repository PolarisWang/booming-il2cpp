struct NativeReferenceProofContext {
    const RuntimeAbiV0* abi;
    const CodegenBridgeV0* bridge;
    ImageHandle image;
    TypeInfoHandle closed_type;
    TypeInfoHandle generic_type_definition;
    FieldInfoHandle field;
    MethodInfoHandle method;
    WriteLineStringFn write_line_string;
};

NativeReferenceProofContext g_proof_context = {};

ImageHandle GetProofImage(const CodegenRegistrationOptionsV0* options) {
    (void)options;
    return EncodeReflectionQueryImageHandle(&kProofImage);
}

void ResetProofContext() {
    g_proof_context = {};
}

bool InitializeProofContext(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options) {
    if (bridge == nullptr) {
        return false;
    }

    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        return false;
    }

    g_proof_context.abi = abi;
    g_proof_context.bridge = bridge;
    g_proof_context.image = GetProofImage(options);
    g_proof_context.closed_type = bridge->resolve_type_by_token(g_proof_context.image, kClosedTypeToken);
    g_proof_context.generic_type_definition =
        bridge->resolve_type_by_token(g_proof_context.image, kGenericTypeDefinitionToken);
    g_proof_context.field = bridge->resolve_field_by_token(g_proof_context.image, kFieldToken);
    g_proof_context.method = bridge->resolve_method_by_token(g_proof_context.image, kMethodToken);

    void* raw_write_line_string = bridge->resolve_icall(kConsoleWriteLineStringIcall);
    g_proof_context.write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);

    return g_proof_context.image != nullptr
        && g_proof_context.closed_type != nullptr
        && g_proof_context.generic_type_definition != nullptr
        && g_proof_context.field != nullptr
        && g_proof_context.method != nullptr
        && g_proof_context.write_line_string != nullptr;
}

bool EnsureProofContextReady(
    RuntimeState* runtime,
    ThreadState* thread) {
    return runtime != nullptr
        && thread != nullptr
        && g_proof_context.abi != nullptr
        && g_proof_context.bridge != nullptr
        && g_proof_context.image != nullptr
        && g_proof_context.closed_type != nullptr
        && g_proof_context.generic_type_definition != nullptr
        && g_proof_context.field != nullptr
        && g_proof_context.method != nullptr
        && g_proof_context.write_line_string != nullptr;
}

}  // namespace

extern "C" int32_t CHAOS_RUNTIME_ABI_CALL {{ entry_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    (void)managed_args;
    (void)kProofMarker;

    if (!EnsureProofContextReady(runtime, thread)) {
        return 1;
    }

    FieldInfoHandle field = g_proof_context.abi->type_find_field(
        g_proof_context.closed_type,
        kFieldQueryName);
    if (field == nullptr || field != g_proof_context.field) {
        return 1;
    }

    PropertyInfoHandle property = g_proof_context.abi->type_find_property(
        g_proof_context.closed_type,
        kPropertyQueryName);
    if (property == nullptr) {
        return 1;
    }

    MethodInfoHandle method = g_proof_context.abi->type_find_method(
        g_proof_context.closed_type,
        kMethodQueryName,
        kMethodParameterCount);
    if (method == nullptr || method != g_proof_context.method) {
        return 1;
    }

    ParameterInfoHandle parameter = g_proof_context.abi->method_get_parameter(method, kParameterIndex);
    if (parameter == nullptr) {
        return 1;
    }

    TypeInfoHandle generic_type_definition =
        g_proof_context.abi->type_get_generic_type_definition(g_proof_context.closed_type);
    if (generic_type_definition == nullptr || generic_type_definition != g_proof_context.generic_type_definition) {
        return 1;
    }

    void* proof_output = g_proof_context.abi->string_new_utf8(
        runtime,
        thread,
        kExpectedOutput,
        {{ expected_output_byte_count }}u);
    if (proof_output == nullptr) {
        return 1;
    }

    return g_proof_context.write_line_string(runtime, thread, proof_output);
}

int32_t {{ proof_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    ResetProofContext();

    if (bridge == nullptr
        || code_registration == nullptr
        || metadata_registration == nullptr
        || options == nullptr
        || runtime == nullptr
        || thread == nullptr) {
        return 1;
    }

    if (bridge->register_codegen(code_registration, metadata_registration, options) != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (bridge->bootstrap_runtime() != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (!InitializeProofContext(bridge, options)) {
        return 1;
    }

    return {{ entry_symbol }}(runtime, thread, managed_args);
}

