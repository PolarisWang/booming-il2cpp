int32_t CHAOS_RUNTIME_ABI_CALL {{ stub_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args)
{
    (void)code_registration;
    (void)metadata_registration;
    (void)managed_args;
    if (bridge == nullptr || options == nullptr || runtime == nullptr || thread == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }
    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_READY;
    }
    const char* image_name = options->image_name_utf8 != nullptr
        ? options->image_name_utf8 : {{ assembly_name_literal }};
    ImageHandle image = reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
    TypeInfoHandle reference_type = bridge->resolve_type_by_token(image, {{ reference_type_token }});
    if (reference_type == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }
    if (abi->class_init(runtime, reference_type) != CHAOS_RUNTIME_STATUS_OK) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }
    using WriteLineStringFn = int32_t (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* string_object);
    void* raw_write_line_string = bridge->resolve_icall({{ console_write_line_string_icall_literal }});
    if (raw_write_line_string == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }
    const auto write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);
    void* harness = abi->object_new(runtime, thread, reference_type);
    if (harness == nullptr) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }
    (void)harness;
    void* message = nullptr;
    try {
        try {
            abi->raise_managed_exception(
                runtime,
                thread,
                reinterpret_cast<ExceptionHandle>(const_cast<char*>("nested-phase2-proof")));
            message = abi->string_new_utf8(runtime, thread, "unreachable-inner", 17u);
        } catch (const chaos::il2cpp::runtime_core::ManagedExceptionCarrier&) {
            message = abi->string_new_utf8(runtime, thread, {{ expected_output }}, {{ expected_output_byte_count }}u);
        }
        void* inner_finally_message = abi->string_new_utf8(runtime, thread, "Nested EH inner finally.", 24u);
        if (inner_finally_message == nullptr) {
            return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
        }
        const int32_t inner_finally_status = write_line_string(runtime, thread, inner_finally_message);
        if (inner_finally_status != CHAOS_BRIDGE_STATUS_OK) {
            return inner_finally_status;
        }
    } catch (const chaos::il2cpp::runtime_core::ManagedExceptionCarrier&) {
        message = abi->string_new_utf8(runtime, thread, "unreachable-outer", 17u);
    }
    void* outer_finally_message = abi->string_new_utf8(runtime, thread, {{ finally_literal }}, {{ finally_literal_byte_count }}u);
    if (outer_finally_message == nullptr || message == nullptr) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }
    const int32_t outer_finally_status = write_line_string(runtime, thread, outer_finally_message);
    if (outer_finally_status != CHAOS_BRIDGE_STATUS_OK) {
        return outer_finally_status;
    }
    return write_line_string(runtime, thread, message);
}
