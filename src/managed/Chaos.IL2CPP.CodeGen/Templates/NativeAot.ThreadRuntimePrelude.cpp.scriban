struct chaos_thread_runtime_entry
{
    std::mutex mutex{};
    std::unique_ptr<std::thread> worker{};
    std::intptr_t thread_start_delegate = 0;
    std::intptr_t name = 0;
    std::int32_t managed_thread_id = 0;
};

std::mutex& chaos_thread_runtime_table_mutex()
{
    static std::mutex chaos_mutex;
    return chaos_mutex;
}

std::unordered_map<std::intptr_t, std::unique_ptr<chaos_thread_runtime_entry>>& chaos_thread_runtime_table()
{
    static std::unordered_map<std::intptr_t, std::unique_ptr<chaos_thread_runtime_entry>> chaos_table;
    return chaos_table;
}

std::int32_t chaos_allocate_managed_thread_id()
{
    static std::mutex chaos_thread_id_mutex;
    static std::int32_t chaos_next_managed_thread_id = 2;
    std::lock_guard<std::mutex> chaos_guard(chaos_thread_id_mutex);
    return chaos_next_managed_thread_id++;
}

thread_local std::intptr_t chaos_current_thread_object = static_cast<std::intptr_t>(0);
thread_local std::int32_t chaos_current_managed_thread_id = 1;

chaos_thread_runtime_entry* chaos_try_get_thread_runtime_entry(std::intptr_t chaos_thread_object_value)
{
    if (chaos_thread_object_value == static_cast<std::intptr_t>(0))
    {
        return nullptr;
    }

    std::lock_guard<std::mutex> chaos_guard(chaos_thread_runtime_table_mutex());
    const auto chaos_entry_it = chaos_thread_runtime_table().find(chaos_thread_object_value);
    if (chaos_entry_it == chaos_thread_runtime_table().end())
    {
        return nullptr;
    }

    return chaos_entry_it->second.get();
}

chaos_thread_runtime_entry& chaos_require_thread_runtime_entry(std::intptr_t chaos_thread_object_value)
{
    if (chaos_thread_object_value == static_cast<std::intptr_t>(0))
    {
        std::abort();
    }

    std::lock_guard<std::mutex> chaos_guard(chaos_thread_runtime_table_mutex());
    auto& chaos_entry = chaos_thread_runtime_table()[chaos_thread_object_value];
    if (!chaos_entry)
    {
        chaos_entry = std::make_unique<chaos_thread_runtime_entry>();
    }

    return *chaos_entry;
}
