const RuntimeAbiV0* TryGetRuntimeSkeletonAbi(int32_t* status)
{
    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        *status = CHAOS_BRIDGE_STATUS_NOT_READY;
        return nullptr;
    }

    *status = CHAOS_BRIDGE_STATUS_OK;
    return abi;
}

const char* ResolveRuntimeSkeletonImageName(
    const CodegenRegistrationOptionsV0* options,
    const char* fallback_assembly_name)
{
    return options != nullptr && options->image_name_utf8 != nullptr
        ? options->image_name_utf8
        : fallback_assembly_name;
}

int32_t ResolveRuntimeSkeletonType(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options,
    RuntimeSkeletonTypeCacheEntry* cache,
    TypeInfoHandle* type_handle,
    const char* fallback_assembly_name)
{
    if (bridge == nullptr || options == nullptr || cache == nullptr || type_handle == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    const char* image_name = ResolveRuntimeSkeletonImageName(options, fallback_assembly_name);
    if (cache->image_name != nullptr &&
        CHAOS_IL2CPP_STRCMP(cache->image_name, image_name) == 0 &&
        cache->type_handle != nullptr) {
        *type_handle = cache->type_handle;
        return CHAOS_BRIDGE_STATUS_OK;
    }

    ImageHandle image = reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
    TypeInfoHandle resolved_type = bridge->resolve_type_by_token(image, cache->type_token);
    if (resolved_type == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }

    cache->image_name = image_name;
    cache->type_handle = resolved_type;
    *type_handle = resolved_type;
    return CHAOS_BRIDGE_STATUS_OK;
}

int32_t ResolveRuntimeSkeletonType(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options,
    CHAOS_IL2CPP_UINT32 descriptor_index,
    TypeInfoHandle* type_handle)
{
    if (bridge == nullptr || options == nullptr || type_handle == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    if (descriptor_index >= kPageTypeDescriptorCount) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    const auto& descriptor = kPageTypeDescriptors[descriptor_index];
    auto& state = gPageTypeStates[descriptor_index];
    const char* image_name = ResolveRuntimeSkeletonImageName(options, descriptor.fallback_assembly_name);
    const char* cached_image_name = state.image_name.load(CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    void* cached_type_handle = state.type_handle.load(CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    if (cached_image_name != nullptr &&
        CHAOS_IL2CPP_STRCMP(cached_image_name, image_name) == 0 &&
        cached_type_handle != nullptr) {
        *type_handle = reinterpret_cast<TypeInfoHandle>(cached_type_handle);
        return CHAOS_BRIDGE_STATUS_OK;
    }

    ImageHandle image = reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
    TypeInfoHandle resolved_type = bridge->resolve_type_by_token(image, descriptor.type_token);
    if (resolved_type == nullptr) {
        return CHAOS_BRIDGE_STATUS_METADATA_RESOLUTION_FAILED;
    }

    state.type_handle.store(reinterpret_cast<void*>(resolved_type), CHAOS_IL2CPP_MEMORY_ORDER_RELEASE);
    state.image_name.store(image_name, CHAOS_IL2CPP_MEMORY_ORDER_RELEASE);
    *type_handle = resolved_type;
    return CHAOS_BRIDGE_STATUS_OK;
}

int32_t ResolveRuntimeSkeletonFieldBinding(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options,
    RuntimeSkeletonFieldBindingCacheEntry* cache,
    TypeInfoHandle* reference_type,
    FieldInfoHandle* captured_field,
    const char* fallback_assembly_name)
{
    if (bridge == nullptr || options == nullptr || cache == nullptr || reference_type == nullptr || captured_field == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    const char* image_name = ResolveRuntimeSkeletonImageName(options, fallback_assembly_name);
    if (cache->image_name != nullptr &&
        CHAOS_IL2CPP_STRCMP(cache->image_name, image_name) == 0 &&
        cache->reference_type != nullptr &&
        cache->captured_field != nullptr) {
        *reference_type = cache->reference_type;
        *captured_field = cache->captured_field;
        return CHAOS_BRIDGE_STATUS_OK;
    }

    ImageHandle image = reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
    TypeInfoHandle resolved_reference_type = bridge->resolve_type_by_token(image, cache->reference_type_token);
    FieldInfoHandle resolved_captured_field = bridge->resolve_field_by_token(image, cache->captured_field_token);
    if (resolved_reference_type == nullptr || resolved_captured_field == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }

    cache->image_name = image_name;
    cache->reference_type = resolved_reference_type;
    cache->captured_field = resolved_captured_field;
    *reference_type = resolved_reference_type;
    *captured_field = resolved_captured_field;
    return CHAOS_BRIDGE_STATUS_OK;
}

int32_t ResolveRuntimeSkeletonFieldBinding(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options,
    CHAOS_IL2CPP_UINT32 descriptor_index,
    TypeInfoHandle* reference_type,
    FieldInfoHandle* captured_field)
{
    if (bridge == nullptr || options == nullptr || reference_type == nullptr || captured_field == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    if (descriptor_index >= kPageFieldBindingDescriptorCount) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    const auto& descriptor = kPageFieldBindingDescriptors[descriptor_index];
    auto& state = gPageFieldBindingStates[descriptor_index];
    const char* image_name = ResolveRuntimeSkeletonImageName(options, descriptor.fallback_assembly_name);
    const char* cached_image_name = state.image_name.load(CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    void* cached_reference_type = state.reference_type.load(CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    void* cached_captured_field = state.captured_field.load(CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    if (cached_image_name != nullptr &&
        CHAOS_IL2CPP_STRCMP(cached_image_name, image_name) == 0 &&
        cached_reference_type != nullptr &&
        cached_captured_field != nullptr) {
        *reference_type = reinterpret_cast<TypeInfoHandle>(cached_reference_type);
        *captured_field = reinterpret_cast<FieldInfoHandle>(cached_captured_field);
        return CHAOS_BRIDGE_STATUS_OK;
    }

    ImageHandle image = reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
    TypeInfoHandle resolved_reference_type = bridge->resolve_type_by_token(image, descriptor.reference_type_token);
    FieldInfoHandle resolved_captured_field = bridge->resolve_field_by_token(image, descriptor.captured_field_token);
    if (resolved_reference_type == nullptr || resolved_captured_field == nullptr) {
        return CHAOS_BRIDGE_STATUS_METADATA_RESOLUTION_FAILED;
    }

    state.reference_type.store(reinterpret_cast<void*>(resolved_reference_type), CHAOS_IL2CPP_MEMORY_ORDER_RELEASE);
    state.captured_field.store(reinterpret_cast<void*>(resolved_captured_field), CHAOS_IL2CPP_MEMORY_ORDER_RELEASE);
    state.class_init_status.store(0, CHAOS_IL2CPP_MEMORY_ORDER_RELEASE);
    state.image_name.store(image_name, CHAOS_IL2CPP_MEMORY_ORDER_RELEASE);
    *reference_type = resolved_reference_type;
    *captured_field = resolved_captured_field;
    return CHAOS_BRIDGE_STATUS_OK;
}

int32_t EnsureRuntimeSkeletonClassInitialized(
    const RuntimeAbiV0* abi,
    RuntimeState* runtime,
    TypeInfoHandle reference_type)
{
    if (abi == nullptr || runtime == nullptr || reference_type == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    return abi->class_init(runtime, reference_type) == CHAOS_RUNTIME_STATUS_OK
        ? CHAOS_BRIDGE_STATUS_OK
        : CHAOS_BRIDGE_STATUS_CLASS_INIT_FAILED;
}

int32_t EnsureRuntimeSkeletonFieldBindingClassInitialized(
    const RuntimeAbiV0* abi,
    RuntimeState* runtime,
    CHAOS_IL2CPP_UINT32 descriptor_index,
    TypeInfoHandle reference_type)
{
    if (abi == nullptr || runtime == nullptr || reference_type == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    if (descriptor_index >= kPageFieldBindingDescriptorCount) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    auto& state = gPageFieldBindingStates[descriptor_index];
    const int32_t cached_status = state.class_init_status.load(CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    if (cached_status != 0) {
        return cached_status;
    }

    const int32_t class_init_status = abi->class_init(runtime, reference_type) == CHAOS_RUNTIME_STATUS_OK
        ? CHAOS_BRIDGE_STATUS_OK
        : CHAOS_BRIDGE_STATUS_CLASS_INIT_FAILED;
    int32_t expected = 0;
    state.class_init_status.compare_exchange_strong(
        expected,
        class_init_status,
        CHAOS_IL2CPP_MEMORY_ORDER_RELEASE,
        CHAOS_IL2CPP_MEMORY_ORDER_ACQUIRE);
    return expected == 0
        ? class_init_status
        : expected;
}

int32_t ExecuteRuntimeSkeletonConstructorFieldSetter(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 descriptor_index,
    void* instance,
    const void* value,
    CHAOS_IL2CPP_SIZE value_size)
{
    (void)code_registration;
    (void)metadata_registration;
    if (bridge == nullptr || options == nullptr || runtime == nullptr || thread == nullptr || instance == nullptr || value == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    int32_t abi_status = CHAOS_BRIDGE_STATUS_OK;
    const RuntimeAbiV0* abi = TryGetRuntimeSkeletonAbi(&abi_status);
    if (abi == nullptr) {
        return abi_status;
    }

    TypeInfoHandle reference_type = nullptr;
    FieldInfoHandle captured_field = nullptr;
    const int32_t binding_status = ResolveRuntimeSkeletonFieldBinding(
        bridge,
        options,
        descriptor_index,
        &reference_type,
        &captured_field);
    if (binding_status != CHAOS_BRIDGE_STATUS_OK) {
        return binding_status;
    }

    const int32_t class_init_status = EnsureRuntimeSkeletonFieldBindingClassInitialized(
        abi,
        runtime,
        descriptor_index,
        reference_type);
    if (class_init_status != CHAOS_BRIDGE_STATUS_OK) {
        return class_init_status;
    }

    return abi->field_set_value(runtime, thread, captured_field, instance, value, value_size) == CHAOS_RUNTIME_STATUS_OK
        ? CHAOS_BRIDGE_STATUS_OK
        : CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
}

int32_t ExecuteRuntimeSkeletonFieldGetterStringReturn(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 descriptor_index,
    void* instance,
    void** return_value)
{
    (void)code_registration;
    (void)metadata_registration;
    if (bridge == nullptr || options == nullptr || runtime == nullptr || thread == nullptr || instance == nullptr || return_value == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    int32_t abi_status = CHAOS_BRIDGE_STATUS_OK;
    const RuntimeAbiV0* abi = TryGetRuntimeSkeletonAbi(&abi_status);
    if (abi == nullptr) {
        return abi_status;
    }

    TypeInfoHandle reference_type = nullptr;
    FieldInfoHandle captured_field = nullptr;
    const int32_t binding_status = ResolveRuntimeSkeletonFieldBinding(
        bridge,
        options,
        descriptor_index,
        &reference_type,
        &captured_field);
    if (binding_status != CHAOS_BRIDGE_STATUS_OK) {
        return binding_status;
    }

    const int32_t class_init_status = EnsureRuntimeSkeletonFieldBindingClassInitialized(
        abi,
        runtime,
        descriptor_index,
        reference_type);
    if (class_init_status != CHAOS_BRIDGE_STATUS_OK) {
        return class_init_status;
    }

    void* captured_value = nullptr;
    if (abi->field_get_value(
            runtime,
            thread,
            captured_field,
            instance,
            &captured_value,
            sizeof(captured_value)) != CHAOS_RUNTIME_STATUS_OK || captured_value == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    *return_value = captured_value;
    return CHAOS_BRIDGE_STATUS_OK;
}

int32_t ExecuteRuntimeSkeletonFieldBackedStringReturn(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 descriptor_index,
    void* instance,
    void** return_value)
{
    (void)code_registration;
    (void)metadata_registration;
    if (bridge == nullptr || options == nullptr || runtime == nullptr || thread == nullptr || instance == nullptr || return_value == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    if (descriptor_index >= kPageFieldBackedStringReturnDescriptorCount) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    int32_t abi_status = CHAOS_BRIDGE_STATUS_OK;
    const RuntimeAbiV0* abi = TryGetRuntimeSkeletonAbi(&abi_status);
    if (abi == nullptr) {
        return abi_status;
    }

    const auto& descriptor = kPageFieldBackedStringReturnDescriptors[descriptor_index];
    TypeInfoHandle reference_type = nullptr;
    FieldInfoHandle captured_field = nullptr;
    const int32_t binding_status = ResolveRuntimeSkeletonFieldBinding(
        bridge,
        options,
        descriptor.field_binding_index,
        &reference_type,
        &captured_field);
    if (binding_status != CHAOS_BRIDGE_STATUS_OK) {
        return binding_status;
    }

    const int32_t class_init_status = EnsureRuntimeSkeletonFieldBindingClassInitialized(
        abi,
        runtime,
        descriptor.field_binding_index,
        reference_type);
    if (class_init_status != CHAOS_BRIDGE_STATUS_OK) {
        return class_init_status;
    }

    void* captured_value = nullptr;
    if (abi->field_get_value(
            runtime,
            thread,
            captured_field,
            instance,
            &captured_value,
            sizeof(captured_value)) != CHAOS_RUNTIME_STATUS_OK || captured_value == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    using ConcatStringPairFn = void* (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* left_string, const void* right_string);
    using ConcatStringTripleFn = void* (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* first_string, const void* second_string, const void* third_string);
    void* raw_concat_string = bridge->resolve_icall(descriptor.concat_icall);
    if (raw_concat_string == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }

    void* message_prefix = abi->string_new_utf8(runtime, thread, descriptor.message_prefix_literal, descriptor.message_prefix_literal_byte_count);
    if (message_prefix == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* message_suffix = abi->string_new_utf8(runtime, thread, descriptor.message_suffix_literal, descriptor.message_suffix_literal_byte_count);
    if (message_suffix == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* full_message = nullptr;
    if (CHAOS_IL2CPP_STRCMP(descriptor.concat_icall, descriptor.string_concat_triple_icall) == 0) {
        const auto concat_string_triple = reinterpret_cast<ConcatStringTripleFn>(raw_concat_string);
        full_message = concat_string_triple(runtime, thread, message_prefix, captured_value, message_suffix);
    } else {
        const auto concat_string_pair = reinterpret_cast<ConcatStringPairFn>(raw_concat_string);
        void* combined_message = concat_string_pair(runtime, thread, message_prefix, captured_value);
        if (combined_message == nullptr) {
            return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
        }

        full_message = concat_string_pair(runtime, thread, combined_message, message_suffix);
    }

    if (full_message == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    *return_value = full_message;
    return CHAOS_BRIDGE_STATUS_OK;
}

