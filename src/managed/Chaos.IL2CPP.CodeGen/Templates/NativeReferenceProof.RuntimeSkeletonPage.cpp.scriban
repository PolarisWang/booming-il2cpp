int32_t ExecuteRuntimeSkeletonArrayClearReferenceArray(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 descriptor_index)
{
    (void)code_registration;
    (void)metadata_registration;

    if (bridge == nullptr || options == nullptr || runtime == nullptr || thread == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    if (descriptor_index >= kPageArrayClearReferenceArrayDescriptorCount) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    int32_t abi_status = CHAOS_BRIDGE_STATUS_OK;
    const RuntimeAbiV0* abi = TryGetRuntimeSkeletonAbi(&abi_status);
    if (abi == nullptr) {
        return abi_status;
    }

    const auto& descriptor = kPageArrayClearReferenceArrayDescriptors[descriptor_index];
    TypeInfoHandle string_type = nullptr;
    const int32_t type_status = ResolveRuntimeSkeletonType(
        bridge,
        options,
        descriptor.string_type_index,
        &string_type);
    if (type_status != CHAOS_BRIDGE_STATUS_OK) {
        return type_status;
    }

    if (abi->class_init(runtime, string_type) != CHAOS_RUNTIME_STATUS_OK) {
        return CHAOS_BRIDGE_STATUS_CLASS_INIT_FAILED;
    }

    using ConcatStringPairFn = void* (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* left_string, const void* right_string);
    using WriteLineStringFn = int32_t (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* string_object);
    void* raw_concat_string = bridge->resolve_icall(descriptor.concat_icall);
    void* raw_write_line_string = bridge->resolve_icall(descriptor.console_write_line_string_icall);
    if (raw_concat_string == nullptr || raw_write_line_string == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }

    const auto concat_string_pair = reinterpret_cast<ConcatStringPairFn>(raw_concat_string);
    const auto write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);

    void* array_instance = abi->array_new(runtime, thread, string_type, descriptor.array_length);
    if (array_instance == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* stored_value = abi->string_new_utf8(runtime, thread, descriptor.stored_literal, descriptor.stored_literal_byte_count);
    if (stored_value == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    if (!chaos::il2cpp::runtime_core::ArrayStoreReference(array_instance, descriptor.array_store_index, stored_value)) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    if (!chaos::il2cpp::runtime_core::ArrayClearReferenceRange(
            array_instance,
            descriptor.clear_start_index,
            descriptor.clear_length)) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* cleared_value = chaos::il2cpp::runtime_core::ArrayLoadReference(array_instance, descriptor.array_read_index);
    if (cleared_value == nullptr) {
        cleared_value = abi->string_new_utf8(runtime, thread, "", 0u);
        if (cleared_value == nullptr) {
            return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
        }
    }

    void* message_prefix = abi->string_new_utf8(runtime, thread, descriptor.message_prefix_literal, descriptor.message_prefix_literal_byte_count);
    if (message_prefix == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* full_message = concat_string_pair(runtime, thread, message_prefix, cleared_value);
    if (full_message == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    return write_line_string(runtime, thread, full_message) == CHAOS_RUNTIME_STATUS_OK
        ? CHAOS_BRIDGE_STATUS_OK
        : CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
}

{{~ for stub_declaration in method_stub_declarations ~}}
{{ stub_declaration }}
{{ end ~}}

{{~ for external_stub_declaration in external_method_stub_declarations ~}}
{{ external_stub_declaration }}
{{ end ~}}

{{~ for stub_definition in method_stub_definitions ~}}
{{ stub_definition }}

{{ end ~}}
constexpr NativeReferenceAssemblyStubFn kPageMethodDispatch[] =
{
{{~ for dispatch_entry in dispatch_entries ~}}
{{ dispatch_entry }}
{{ end ~}}
};

int32_t CHAOS_RUNTIME_ABI_CALL {{ page_dispatch_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 method_slot,
    void* managed_args)
{
    if (method_slot >= (sizeof(kPageMethodDispatch) / sizeof(kPageMethodDispatch[0]))) {
        return CHAOS_BRIDGE_STATUS_NOT_FOUND;
    }

    // Domain is already pushed by the summary entry point.
    return kPageMethodDispatch[method_slot](
        bridge,
        code_registration,
        metadata_registration,
        options,
        runtime,
        thread,
        managed_args);
}
}  // namespace chaos::il2cpp::generated::runtime_skeleton
