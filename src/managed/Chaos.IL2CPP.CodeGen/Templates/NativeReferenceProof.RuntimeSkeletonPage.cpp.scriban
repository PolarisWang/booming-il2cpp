int32_t ExecuteRuntimeSkeletonDelegateClosedTargetRelay(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    CHAOS_IL2CPP_UINT32 descriptor_index)
{
    if (bridge == nullptr || options == nullptr || runtime == nullptr || thread == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    if (descriptor_index >= kPageDelegateClosedTargetRelayDescriptorCount) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    int32_t abi_status = CHAOS_BRIDGE_STATUS_OK;
    const RuntimeAbiV0* abi = TryGetRuntimeSkeletonAbi(&abi_status);
    if (abi == nullptr) {
        return abi_status;
    }

    const auto& descriptor = kPageDelegateClosedTargetRelayDescriptors[descriptor_index];
    TypeInfoHandle reference_type = nullptr;
    FieldInfoHandle captured_field = nullptr;
    const int32_t binding_status = ResolveRuntimeSkeletonFieldBinding(
        bridge,
        options,
        descriptor.field_binding_index,
        &reference_type,
        &captured_field);
    if (binding_status != CHAOS_BRIDGE_STATUS_OK) {
        return binding_status;
    }

    const int32_t class_init_status = EnsureRuntimeSkeletonFieldBindingClassInitialized(
        abi,
        runtime,
        descriptor.field_binding_index,
        reference_type);
    if (class_init_status != CHAOS_BRIDGE_STATUS_OK) {
        return class_init_status;
    }

    using ConcatStringPairFn = void* (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* left_string, const void* right_string);
    using WriteLineStringFn = int32_t (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* string_object);
    void* raw_concat_string = bridge->resolve_icall(descriptor.concat_icall);
    void* raw_write_line_string = bridge->resolve_icall(descriptor.console_write_line_string_icall);
    if (raw_concat_string == nullptr || raw_write_line_string == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }

    const auto concat_string_pair = reinterpret_cast<ConcatStringPairFn>(raw_concat_string);
    const auto write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);
    void* constructor_argument = abi->string_new_utf8(runtime, thread, descriptor.constructor_literal, descriptor.constructor_literal_byte_count);
    if (constructor_argument == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* prefix = abi->string_new_utf8(runtime, thread, descriptor.message_prefix_literal, descriptor.message_prefix_literal_byte_count);
    if (prefix == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* message_suffix = abi->string_new_utf8(runtime, thread, descriptor.message_suffix_literal, descriptor.message_suffix_literal_byte_count);
    if (message_suffix == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* banner = abi->object_new(runtime, thread, reference_type);
    if (banner == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    const int32_t setter_status = ExecuteRuntimeSkeletonConstructorFieldSetter(
        bridge,
        code_registration,
        metadata_registration,
        options,
        runtime,
        thread,
        descriptor.field_binding_index,
        banner,
        &constructor_argument,
        sizeof(constructor_argument));
    if (setter_status != CHAOS_BRIDGE_STATUS_OK) {
        return setter_status;
    }

    void* captured_value = nullptr;
    const int32_t getter_status = ExecuteRuntimeSkeletonFieldGetterStringReturn(
        bridge,
        code_registration,
        metadata_registration,
        options,
        runtime,
        thread,
        descriptor.field_binding_index,
        banner,
        &captured_value);
    if (getter_status != CHAOS_BRIDGE_STATUS_OK) {
        return getter_status;
    }

    void* formatted = concat_string_pair(runtime, thread, prefix, captured_value);
    if (formatted == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* suffixed_message = concat_string_pair(runtime, thread, formatted, message_suffix);
    if (suffixed_message == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* trailing = abi->string_new_utf8(runtime, thread, descriptor.trailing_literal, descriptor.trailing_literal_byte_count);
    if (trailing == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    void* final_message = concat_string_pair(runtime, thread, suffixed_message, trailing);
    if (final_message == nullptr) {
        return CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
    }

    return write_line_string(runtime, thread, final_message) == CHAOS_RUNTIME_STATUS_OK
        ? CHAOS_BRIDGE_STATUS_OK
        : CHAOS_BRIDGE_STATUS_RUNTIME_CALL_FAILED;
}

