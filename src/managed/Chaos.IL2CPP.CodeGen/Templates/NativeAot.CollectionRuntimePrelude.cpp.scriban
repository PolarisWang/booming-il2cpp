template <typename TValue>
struct chaos_list_runtime_storage
{
    std::vector<TValue> items{};
};

template <typename TValue>
chaos_list_runtime_storage<TValue>* chaos_require_list_runtime_storage(std::intptr_t chaos_handle)
{
    if (chaos_handle == static_cast<std::intptr_t>(0))
    {
        std::abort();
    }

    static std::unordered_map<std::intptr_t, std::unique_ptr<chaos_list_runtime_storage<TValue>>> chaos_storage_by_handle;
    auto& chaos_storage = chaos_storage_by_handle[chaos_handle];
    if (chaos_storage == nullptr)
    {
        chaos_storage = std::make_unique<chaos_list_runtime_storage<TValue>>();
    }

    return chaos_storage.get();
}

template <typename TKey, typename TValue>
struct chaos_dictionary_runtime_storage
{
    std::vector<std::pair<TKey, TValue>> entries{};
};

template <typename TKey, typename TValue>
chaos_dictionary_runtime_storage<TKey, TValue>* chaos_require_dictionary_runtime_storage(std::intptr_t chaos_handle)
{
    if (chaos_handle == static_cast<std::intptr_t>(0))
    {
        std::abort();
    }

    static std::unordered_map<std::intptr_t, std::unique_ptr<chaos_dictionary_runtime_storage<TKey, TValue>>> chaos_storage_by_handle;
    auto& chaos_storage = chaos_storage_by_handle[chaos_handle];
    if (chaos_storage == nullptr)
    {
        chaos_storage = std::make_unique<chaos_dictionary_runtime_storage<TKey, TValue>>();
    }

    return chaos_storage.get();
}
