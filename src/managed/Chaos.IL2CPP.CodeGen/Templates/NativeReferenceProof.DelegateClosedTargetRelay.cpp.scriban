#include "{{ include_header }}"

namespace chaos::il2cpp::generated {

namespace {

using ConcatStringPairFn = void* (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* left_string,
    const void* right_string);
using WriteLineStringFn = int32_t (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* string_object);

struct MethodPointerEntry {
    uint32_t method_token;
    void* method_pointer;
};

constexpr uint32_t kReferenceTypeToken = {{ reference_type_token }};
constexpr uint32_t kCapturedFieldToken = {{ captured_field_token }};
constexpr uint32_t kEntryMethodToken = {{ entry_method_token }};
constexpr uint32_t kConstructorMethodToken = {{ constructor_method_token }};
constexpr uint32_t kInstanceMethodToken = {{ instance_method_token }};
constexpr uint32_t kStaticMethodToken = {{ static_method_token }};
constexpr const char* kDefaultImageName = "{{ assembly_name }}";
constexpr const char* kConsoleWriteLineStringIcall = "{{ console_write_line_string_icall }}";
constexpr const char* kStringConcatPairIcall = "{{ string_concat_pair_icall }}";

struct NativeReferenceProofContext {
    const RuntimeAbiV0* abi;
    const CodegenBridgeV0* bridge;
    ImageHandle image;
    TypeInfoHandle reference_type;
    FieldInfoHandle captured_field;
    MethodInfoHandle instance_method;
    MethodInfoHandle static_method;
    ConcatStringPairFn concat_string_pair;
    WriteLineStringFn write_line_string;
};

NativeReferenceProofContext g_proof_context = {};

ImageHandle GetProofImage(const CodegenRegistrationOptionsV0* options) {
    const char* image_name = options != nullptr && options->image_name_utf8 != nullptr
        ? options->image_name_utf8
        : kDefaultImageName;
    return reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
}

void ResetProofContext() {
    g_proof_context = {};
}

bool InitializeProofContext(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options) {
    if (bridge == nullptr) {
        return false;
    }

    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        return false;
    }

    g_proof_context.abi = abi;
    g_proof_context.bridge = bridge;
    g_proof_context.image = GetProofImage(options);
    g_proof_context.reference_type = bridge->resolve_type_by_token(g_proof_context.image, kReferenceTypeToken);
    g_proof_context.captured_field = bridge->resolve_field_by_token(g_proof_context.image, kCapturedFieldToken);
    g_proof_context.instance_method = bridge->resolve_method_by_token(g_proof_context.image, kInstanceMethodToken);
    g_proof_context.static_method = bridge->resolve_method_by_token(g_proof_context.image, kStaticMethodToken);

    void* raw_concat_string_pair = bridge->resolve_icall(kStringConcatPairIcall);
    void* raw_write_line_string = bridge->resolve_icall(kConsoleWriteLineStringIcall);
    g_proof_context.concat_string_pair = reinterpret_cast<ConcatStringPairFn>(raw_concat_string_pair);
    g_proof_context.write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);

    return g_proof_context.image != nullptr
        && g_proof_context.reference_type != nullptr
        && g_proof_context.captured_field != nullptr
        && g_proof_context.instance_method != nullptr
        && g_proof_context.static_method != nullptr
        && g_proof_context.concat_string_pair != nullptr
        && g_proof_context.write_line_string != nullptr;
}

bool EnsureProofContextReady(
    RuntimeState* runtime,
    ThreadState* thread) {
    return runtime != nullptr
        && thread != nullptr
        && g_proof_context.abi != nullptr
        && g_proof_context.bridge != nullptr
        && g_proof_context.reference_type != nullptr
        && g_proof_context.captured_field != nullptr
        && g_proof_context.instance_method != nullptr
        && g_proof_context.static_method != nullptr
        && g_proof_context.concat_string_pair != nullptr
        && g_proof_context.write_line_string != nullptr;
}

void* CreateManagedString(
    RuntimeState* runtime,
    ThreadState* thread,
    const char* utf8_bytes,
    uint32_t byte_count) {
    return g_proof_context.abi->string_new_utf8(runtime, thread, utf8_bytes, byte_count);
}

}  // namespace

extern "C" void CHAOS_RUNTIME_ABI_CALL {{ constructor_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* __this,
    void* arg0) {
    if (!EnsureProofContextReady(runtime, thread) || __this == nullptr) {
        return;
    }

    (void)g_proof_context.abi->field_set_value(
        runtime,
        thread,
        g_proof_context.captured_field,
        __this,
        &arg0,
        sizeof(arg0));
}

extern "C" void* CHAOS_RUNTIME_ABI_CALL {{ instance_method_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* __this,
    void* arg0) {
    if (!EnsureProofContextReady(runtime, thread) || __this == nullptr) {
        return nullptr;
    }

    void* captured_value = nullptr;
    if (g_proof_context.abi->field_get_value(
            runtime,
            thread,
            g_proof_context.captured_field,
            __this,
            &captured_value,
            sizeof(captured_value)) != CHAOS_RUNTIME_STATUS_OK) {
        return nullptr;
    }

    void* combined_message = g_proof_context.concat_string_pair(runtime, thread, arg0, captured_value);
    if (combined_message == nullptr) {
        return nullptr;
    }

    void* message_suffix = CreateManagedString(
        runtime,
        thread,
        {{ message_suffix_literal }},
        {{ message_suffix_literal_byte_count }}u);
    if (message_suffix == nullptr) {
        return nullptr;
    }

    return g_proof_context.concat_string_pair(runtime, thread, combined_message, message_suffix);
}

extern "C" void* CHAOS_RUNTIME_ABI_CALL {{ static_method_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* arg0) {
    if (!EnsureProofContextReady(runtime, thread)) {
        return nullptr;
    }

    void* suffix = CreateManagedString(runtime, thread, "!", 1u);
    if (suffix == nullptr) {
        return nullptr;
    }

    return g_proof_context.concat_string_pair(runtime, thread, arg0, suffix);
}

extern "C" int32_t CHAOS_RUNTIME_ABI_CALL {{ entry_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    (void)managed_args;

    if (!EnsureProofContextReady(runtime, thread)) {
        return 1;
    }

    if (g_proof_context.abi->class_init(runtime, g_proof_context.reference_type) != CHAOS_RUNTIME_STATUS_OK) {
        return 1;
    }

    void* constructor_argument = CreateManagedString(
        runtime,
        thread,
        {{ constructor_literal }},
        {{ constructor_literal_byte_count }}u);
    if (constructor_argument == nullptr) {
        return 1;
    }

    void* prefix = CreateManagedString(
        runtime,
        thread,
        {{ message_prefix_literal }},
        {{ message_prefix_literal_byte_count }}u);
    if (prefix == nullptr) {
        return 1;
    }

    void* banner = g_proof_context.abi->object_new(runtime, thread, g_proof_context.reference_type);
    if (banner == nullptr) {
        return 1;
    }

    {{ constructor_symbol }}(runtime, thread, banner, constructor_argument);

    void* formatter_delegate = g_proof_context.bridge->create_delegate(
        runtime,
        thread,
        g_proof_context.instance_method,
        banner);
    void* tail_delegate = g_proof_context.bridge->create_delegate(
        runtime,
        thread,
        g_proof_context.static_method,
        nullptr);
    if (formatter_delegate == nullptr || tail_delegate == nullptr) {
        return 1;
    }

    void* formatter_argv[] = { prefix };
    void* formatted = nullptr;
    if (g_proof_context.bridge->delegate_invoke(
            runtime,
            thread,
            formatter_delegate,
            formatter_argv,
            1u,
            &formatted,
            sizeof(formatted),
            nullptr) != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    void* tail_argv[] = { formatted };
    void* final_message = nullptr;
    if (g_proof_context.bridge->delegate_invoke(
            runtime,
            thread,
            tail_delegate,
            tail_argv,
            1u,
            &final_message,
            sizeof(final_message),
            nullptr) != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    return g_proof_context.write_line_string(runtime, thread, final_message);
}

int32_t {{ proof_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    ResetProofContext();

    if (bridge == nullptr
        || code_registration == nullptr
        || metadata_registration == nullptr
        || options == nullptr
        || runtime == nullptr
        || thread == nullptr) {
        return 1;
    }

    const MethodPointerEntry method_pointers[] = {
        { kConstructorMethodToken, reinterpret_cast<void*>(&{{ constructor_symbol }}) },
        { kInstanceMethodToken, reinterpret_cast<void*>(&{{ instance_method_symbol }}) },
        { kStaticMethodToken, reinterpret_cast<void*>(&{{ static_method_symbol }}) },
        { kEntryMethodToken, reinterpret_cast<void*>(&{{ entry_symbol }}) },
    };

    CodeRegistrationV0 registered_code_registration = *code_registration;
    registered_code_registration.method_pointers = method_pointers;
    registered_code_registration.method_pointer_count =
        static_cast<uint32_t>(sizeof(method_pointers) / sizeof(method_pointers[0]));

    if (bridge->register_codegen(&registered_code_registration, metadata_registration, options) != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (bridge->bootstrap_runtime() != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (!InitializeProofContext(bridge, options)) {
        return 1;
    }

    return {{ entry_symbol }}(runtime, thread, managed_args);
}

}  // namespace chaos::il2cpp::generated
