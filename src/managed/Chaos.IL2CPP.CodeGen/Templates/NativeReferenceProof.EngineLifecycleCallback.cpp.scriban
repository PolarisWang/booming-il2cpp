#include "{{ include_header }}"
#include "runtime_core.h"

#include <cstring>

namespace chaos::il2cpp::generated {

namespace {

struct CallbackTrace {
    const char* phases[3] = { nullptr, nullptr, nullptr };
    int phase_count = 0;
    bool on_main_thread = true;
};

void RecordLifecyclePhase(const char* phase_utf8, void* user_data) {
    auto* trace = static_cast<CallbackTrace*>(user_data);
    if (trace == nullptr || phase_utf8 == nullptr || trace->phase_count >= 3) {
        return;
    }

    trace->phases[trace->phase_count++] = phase_utf8;
    trace->on_main_thread = trace->on_main_thread && chaos::il2cpp::runtime_core::IsMainThreadLane();
}

bool MatchesExpectedOrder(const CallbackTrace& trace) {
    return trace.phase_count == 3
        && trace.phases[0] != nullptr
        && trace.phases[1] != nullptr
        && trace.phases[2] != nullptr
        && std::strcmp(trace.phases[0], "init") == 0
        && std::strcmp(trace.phases[1], "tick") == 0
        && std::strcmp(trace.phases[2], "shutdown") == 0
        && trace.on_main_thread;
}

}  // namespace

int32_t {{ native_reference_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    (void)bridge;
    (void)code_registration;
    (void)metadata_registration;
    (void)options;
    (void)runtime;
    (void)thread;
    (void)managed_args;

    CallbackTrace trace = {};
    if (!chaos::il2cpp::runtime_core::RegisterEngineLifecycleCallback("init", &RecordLifecyclePhase, &trace)) {
        return 1;
    }

    if (!chaos::il2cpp::runtime_core::RegisterEngineLifecycleCallback("tick", &RecordLifecyclePhase, &trace)) {
        return 1;
    }

    if (!chaos::il2cpp::runtime_core::RegisterEngineLifecycleCallback("shutdown", &RecordLifecyclePhase, &trace)) {
        return 1;
    }

    if (!chaos::il2cpp::runtime_core::DispatchEngineLifecycleCallbacks("init")) {
        return 1;
    }

    if (!chaos::il2cpp::runtime_core::DispatchEngineLifecycleCallbacks("tick")) {
        return 1;
    }

    if (!chaos::il2cpp::runtime_core::DispatchEngineLifecycleCallbacks("shutdown")) {
        return 1;
    }

    if (!MatchesExpectedOrder(trace)) {
        return 1;
    }

    return chaos::il2cpp::runtime_core::EngineLogWrite("lifecycle-callback", {{ expected_output_literal }});
}

}  // namespace chaos::il2cpp::generated
