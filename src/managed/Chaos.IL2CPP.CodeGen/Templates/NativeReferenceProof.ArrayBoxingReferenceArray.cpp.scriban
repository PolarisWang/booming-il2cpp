#include "{{ include_header }}"
#include "runtime_core.h"

namespace chaos::il2cpp::generated {

namespace {

using ConcatStringPairFn = void* (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* left_string,
    const void* right_string);
using WriteLineStringFn = int32_t (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* string_object);

constexpr uint32_t kReferenceTypeToken = {{ reference_type_token }};
constexpr uint32_t kCapturedFieldToken = {{ captured_field_token }};
constexpr uint32_t kEntryMethodToken = {{ entry_method_token }};
constexpr uint32_t kConstructorMethodToken = {{ constructor_method_token }};
constexpr uint32_t kInstanceMethodToken = {{ instance_method_token }};
constexpr uint32_t kBoxedValueTypeToken = {{ boxed_value_type_token }};
constexpr int32_t kBoxedInt32Value = {{ boxed_int32_value }};
constexpr const char* kDefaultImageName = "{{ assembly_name }}";
constexpr const char* kConsoleWriteLineStringIcall = "{{ console_write_line_string_icall }}";
constexpr const char* kStringConcatPairIcall = "{{ string_concat_pair_icall }}";

struct NativeReferenceContext {
    const RuntimeAbiV0* abi;
    const CodegenBridgeV0* bridge;
    ImageHandle image;
    TypeInfoHandle reference_type;
    TypeInfoHandle boxed_value_type;
    FieldInfoHandle captured_field;
    MethodInfoHandle entry_method;
    MethodInfoHandle constructor_method;
    MethodInfoHandle instance_method;
    ConcatStringPairFn concat_string_pair;
    WriteLineStringFn write_line_string;
};

NativeReferenceContext g_native_reference_context = {};

ImageHandle GetNativeReferenceImage(const CodegenRegistrationOptionsV0* options) {
    const char* image_name = options != nullptr && options->image_name_utf8 != nullptr
        ? options->image_name_utf8
        : kDefaultImageName;
    return reinterpret_cast<ImageHandle>(const_cast<char*>(image_name));
}

void ResetNativeReferenceContext() {
    g_native_reference_context = {};
}

bool InitializeNativeReferenceContext(
    const CodegenBridgeV0* bridge,
    const CodegenRegistrationOptionsV0* options) {
    if (bridge == nullptr) {
        return false;
    }

    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        return false;
    }

    g_native_reference_context.abi = abi;
    g_native_reference_context.bridge = bridge;
    g_native_reference_context.image = GetNativeReferenceImage(options);
    g_native_reference_context.reference_type = bridge->resolve_type_by_token(g_native_reference_context.image, kReferenceTypeToken);
    g_native_reference_context.boxed_value_type = bridge->resolve_type_by_token(g_native_reference_context.image, kBoxedValueTypeToken);
    g_native_reference_context.captured_field = bridge->resolve_field_by_token(g_native_reference_context.image, kCapturedFieldToken);
    g_native_reference_context.entry_method = bridge->resolve_method_by_token(g_native_reference_context.image, kEntryMethodToken);
    g_native_reference_context.constructor_method = bridge->resolve_method_by_token(g_native_reference_context.image, kConstructorMethodToken);
    g_native_reference_context.instance_method = bridge->resolve_method_by_token(g_native_reference_context.image, kInstanceMethodToken);

    void* raw_concat_string_pair = bridge->resolve_icall(kStringConcatPairIcall);
    void* raw_write_line_string = bridge->resolve_icall(kConsoleWriteLineStringIcall);
    g_native_reference_context.concat_string_pair = reinterpret_cast<ConcatStringPairFn>(raw_concat_string_pair);
    g_native_reference_context.write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);

    return g_native_reference_context.image != nullptr
        && g_native_reference_context.reference_type != nullptr
        && g_native_reference_context.boxed_value_type != nullptr
        && g_native_reference_context.captured_field != nullptr
        && g_native_reference_context.entry_method != nullptr
        && g_native_reference_context.constructor_method != nullptr
        && g_native_reference_context.instance_method != nullptr
        && g_native_reference_context.concat_string_pair != nullptr
        && g_native_reference_context.write_line_string != nullptr;
}

bool EnsureNativeReferenceContextReady(
    RuntimeState* runtime,
    ThreadState* thread) {
    return runtime != nullptr
        && thread != nullptr
        && g_native_reference_context.abi != nullptr
        && g_native_reference_context.bridge != nullptr
        && g_native_reference_context.image != nullptr
        && g_native_reference_context.reference_type != nullptr
        && g_native_reference_context.boxed_value_type != nullptr
        && g_native_reference_context.captured_field != nullptr
        && g_native_reference_context.entry_method != nullptr
        && g_native_reference_context.constructor_method != nullptr
        && g_native_reference_context.instance_method != nullptr
        && g_native_reference_context.concat_string_pair != nullptr
        && g_native_reference_context.write_line_string != nullptr;
}

}  // namespace

extern "C" void CHAOS_RUNTIME_ABI_CALL {{ constructor_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* __this,
    void* arg0) {
    if (!EnsureNativeReferenceContextReady(runtime, thread) || __this == nullptr) {
        return;
    }

    if (g_native_reference_context.abi->field_set_value(
            runtime,
            thread,
            g_native_reference_context.captured_field,
            __this,
            &arg0,
            sizeof(arg0)) != CHAOS_RUNTIME_STATUS_OK) {
        return;
    }
}

extern "C" void* CHAOS_RUNTIME_ABI_CALL {{ instance_method_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* __this) {
    if (!EnsureNativeReferenceContextReady(runtime, thread) || __this == nullptr) {
        return nullptr;
    }

    void* captured_value = nullptr;
    if (g_native_reference_context.abi->field_get_value(
            runtime,
            thread,
            g_native_reference_context.captured_field,
            __this,
            &captured_value,
            sizeof(captured_value)) != CHAOS_RUNTIME_STATUS_OK) {
        return nullptr;
    }

    void* message_prefix = g_native_reference_context.abi->string_new_utf8(
        runtime,
        thread,
        {{ message_prefix_literal }},
        {{ message_prefix_literal_byte_count }}u);
    if (message_prefix == nullptr) {
        return nullptr;
    }

    void* combined_message = g_native_reference_context.concat_string_pair(
        runtime,
        thread,
        message_prefix,
        captured_value);
    if (combined_message == nullptr) {
        return nullptr;
    }

    void* message_suffix = g_native_reference_context.abi->string_new_utf8(
        runtime,
        thread,
        {{ message_suffix_literal }},
        {{ message_suffix_literal_byte_count }}u);
    if (message_suffix == nullptr) {
        return nullptr;
    }

    return g_native_reference_context.concat_string_pair(runtime, thread, combined_message, message_suffix);
}

extern "C" int32_t CHAOS_RUNTIME_ABI_CALL {{ entry_symbol }}(
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    (void)managed_args;

    if (!EnsureNativeReferenceContextReady(runtime, thread)) {
        return 1;
    }

    if (g_native_reference_context.abi->class_init(runtime, g_native_reference_context.reference_type) != CHAOS_RUNTIME_STATUS_OK) {
        return 1;
    }

    void* boxed_value = g_native_reference_context.bridge->box_value(
        runtime,
        thread,
        g_native_reference_context.boxed_value_type,
        &kBoxedInt32Value,
        sizeof(kBoxedInt32Value));
    if (boxed_value == nullptr) {
        return 1;
    }

    void* banner_array = g_native_reference_context.abi->array_new(
        runtime,
        thread,
        g_native_reference_context.reference_type,
        1u);
    if (banner_array == nullptr) {
        return 1;
    }

    void* constructor_argument = g_native_reference_context.abi->string_new_utf8(
        runtime,
        thread,
        {{ constructor_literal }},
        {{ constructor_literal_byte_count }}u);
    if (constructor_argument == nullptr) {
        return 1;
    }

    void* banner = g_native_reference_context.abi->object_new(
        runtime,
        thread,
        g_native_reference_context.reference_type);
    if (banner == nullptr) {
        return 1;
    }

    {{ constructor_symbol }}(runtime, thread, banner, constructor_argument);
    if (!chaos::il2cpp::runtime_core::ArrayStoreReference(banner_array, 0u, banner)) {
        return 1;
    }

    void* loaded_banner = chaos::il2cpp::runtime_core::ArrayLoadReference(banner_array, 0u);
    if (loaded_banner == nullptr) {
        return 1;
    }

    void* message = {{ instance_method_symbol }}(runtime, thread, loaded_banner);
    if (message == nullptr) {
        return 1;
    }

    (void)boxed_value;
    return g_native_reference_context.write_line_string(runtime, thread, message);
}

int32_t {{ native_reference_function_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args) {
    ResetNativeReferenceContext();

    if (bridge == nullptr
        || code_registration == nullptr
        || metadata_registration == nullptr
        || options == nullptr
        || runtime == nullptr
        || thread == nullptr) {
        return 1;
    }

    if (bridge->register_codegen(code_registration, metadata_registration, options) != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (bridge->bootstrap_runtime() != CHAOS_BRIDGE_STATUS_OK) {
        return 1;
    }

    if (!InitializeNativeReferenceContext(bridge, options)) {
        return 1;
    }

    return {{ entry_symbol }}(runtime, thread, managed_args);
}

}  // namespace chaos::il2cpp::generated
