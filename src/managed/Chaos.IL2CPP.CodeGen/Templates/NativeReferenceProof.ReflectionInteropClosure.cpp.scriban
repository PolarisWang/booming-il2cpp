    nullptr,
    0u,
};

const chaos::il2cpp::runtime_core::ReflectionQueryTypeDescriptor kClosedType = {
    kClosedTypeToken,
    {{ closed_type_subject_id_literal }},
    {{ generic_type_definition_subject_id_literal }},
    {{ closed_type_namespace_name_literal }},
    {{ closed_type_name_literal }},
    {{ closed_type_display_name_literal }},
    &kGenericTypeDefinition,
    kClosedTypeFields,
