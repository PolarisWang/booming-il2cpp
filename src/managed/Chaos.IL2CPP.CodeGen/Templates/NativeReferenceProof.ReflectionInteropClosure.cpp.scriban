using chaos::il2cpp::runtime_core::EncodeReflectionQueryImageHandle;
using ImportedGetTickCount64Fn = ULONGLONG (WINAPI*)(void);
using WriteLineStringFn = CHAOS_IL2CPP_INT32 (CHAOS_RUNTIME_ABI_CALL*)(
    RuntimeState* runtime,
    ThreadState* thread,
    const void* string_object);

constexpr CHAOS_IL2CPP_UINT32 kClosedTypeToken = {{ closed_type_token }};
constexpr CHAOS_IL2CPP_UINT32 kGenericTypeDefinitionToken = {{ generic_type_definition_token }};
constexpr CHAOS_IL2CPP_UINT32 kFieldToken = {{ captured_field_token }};
constexpr CHAOS_IL2CPP_UINT32 kMethodToken = {{ instance_method_token }};
constexpr const char* kConsoleWriteLineStringIcall = "{{ console_write_line_string_icall }}";
constexpr const char* kFieldQueryName = {{ field_query_name_literal }};
constexpr const char* kMethodQueryName = {{ method_query_name_literal }};
constexpr CHAOS_IL2CPP_INT32 kMethodParameterCount = {{ method_parameter_count }};
constexpr CHAOS_IL2CPP_UINT32 kParameterIndex = {{ parameter_index }}u;
constexpr const char* kExpectedOutput = {{ expected_output_literal }};
constexpr const char* kImportModuleName = {{ import_module_name_literal }};
constexpr const char* kImportEntryPointName = {{ import_entry_point_name_literal }};

const chaos::il2cpp::runtime_core::ReflectionQueryParameterDescriptor kMethodParameters[] = {
    {
        {{ parameter_subject_id_literal }},
        "input",
        kParameterIndex,
        "",
    },
};

const chaos::il2cpp::runtime_core::ReflectionQueryFieldDescriptor kClosedTypeFields[] = {
    {
        kFieldToken,
        {{ field_subject_id_literal }},
        {{ field_query_name_literal }},
        "",
    },
};

const chaos::il2cpp::runtime_core::ReflectionQueryMethodDescriptor kClosedTypeMethods[] = {
    {
        kMethodToken,
        {{ method_subject_id_literal }},
        {{ method_query_name_literal }},
        "",
        kMethodParameterCount,
        kMethodParameters,
        static_cast<CHAOS_IL2CPP_UINT32>(sizeof(kMethodParameters) / sizeof(kMethodParameters[0])),
    },
};

const chaos::il2cpp::runtime_core::ReflectionQueryTypeDescriptor kGenericTypeDefinition = {
    kGenericTypeDefinitionToken,
    {{ generic_type_definition_subject_id_literal }},
    {{ generic_type_definition_subject_id_literal }},
    {{ closed_type_namespace_name_literal }},
    {{ generic_type_definition_name_literal }},
    {{ generic_type_definition_name_literal }},
    nullptr,
    nullptr,
    0u,
