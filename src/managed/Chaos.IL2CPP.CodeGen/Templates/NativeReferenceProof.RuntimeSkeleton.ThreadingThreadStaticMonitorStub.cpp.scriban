namespace {

CHAOS_IL2CPP_ATOMIC(CHAOS_IL2CPP_INT32) {{ stub_name }}_g_finalized_count = 0;

void {{ stub_name }}_RecordFinalizer(void* object_instance)
{
    if (object_instance != nullptr) {
        {{ stub_name }}_g_finalized_count.fetch_add(1);
    }
}

}  // namespace

CHAOS_IL2CPP_INT32 CHAOS_RUNTIME_ABI_CALL {{ stub_name }}(
    const CodegenBridgeV0* bridge,
    const CodeRegistrationV0* code_registration,
    const MetadataRegistrationV0* metadata_registration,
    const CodegenRegistrationOptionsV0* options,
    RuntimeState* runtime,
    ThreadState* thread,
    void* managed_args)
{
    (void)code_registration;
    (void)metadata_registration;
    (void)options;
    (void)managed_args;

    if (bridge == nullptr || runtime == nullptr || thread == nullptr) {
        return CHAOS_BRIDGE_STATUS_INVALID_ARGUMENT;
    }

    const RuntimeAbiV0* abi = chaos_runtime_get_abi_v0();
    if (abi == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_READY;
    }

    using WriteLineStringFn = CHAOS_IL2CPP_INT32 (CHAOS_RUNTIME_ABI_CALL*)(RuntimeState* runtime, ThreadState* thread, const void* string_object);
    void* raw_write_line_string = bridge->resolve_icall({{ console_write_line_string_icall_literal }});
    if (raw_write_line_string == nullptr) {
        return CHAOS_BRIDGE_STATUS_NOT_SUPPORTED;
    }

    const auto write_line_string = reinterpret_cast<WriteLineStringFn>(raw_write_line_string);
    constexpr const char* kThreadStaticSlotKey = "ThreadingProof.thread-slot";
    int gate_object = 0;
    void* gate = &gate_object;
    CHAOS_IL2CPP_INT32 shared_total = 0;
    CHAOS_IL2CPP_INT32 main_slot = 0;
    if (!chaos::il2cpp::runtime_core::ThreadStaticInt32Add(runtime, thread, kThreadStaticSlotKey, 1, &main_slot) ||
        main_slot != 1) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if (!chaos::il2cpp::runtime_core::ThreadStaticInt32Add(runtime, thread, kThreadStaticSlotKey, 1, &main_slot) ||
        main_slot != 2) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if (!chaos::il2cpp::runtime_core::MonitorEnter(gate)) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    shared_total += 1;

    if (!chaos::il2cpp::runtime_core::MonitorExit(gate)) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    CHAOS_IL2CPP_INT32 main_root = 7;
    if (chaos::il2cpp::runtime_core::ReportThreadRoot(runtime, thread, &main_root, sizeof(main_root)) != 1u) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if (!chaos::il2cpp::runtime_core::GcSafepoint(runtime, thread)) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    {{ stub_name }}_g_finalized_count.store(0);

    CHAOS_IL2CPP_INT32 worker_slot = 0;
    CHAOS_IL2CPP_SIZE worker_root_count = 0u;
    bool worker_ok = false;
    CHAOS_IL2CPP_THREAD worker([&]() {
        ThreadState* worker_thread = nullptr;
        if (abi->thread_attach(runtime, &worker_thread) != CHAOS_RUNTIME_STATUS_OK || worker_thread == nullptr) {
            return;
        }

        CHAOS_IL2CPP_INT32 worker_root = 11;
        if (!chaos::il2cpp::runtime_core::ThreadStaticInt32Add(runtime, worker_thread, kThreadStaticSlotKey, 1, &worker_slot) ||
            worker_slot != 1) {
            abi->thread_detach(runtime, worker_thread);
            return;
        }

        if (!chaos::il2cpp::runtime_core::MonitorEnter(gate)) {
            abi->thread_detach(runtime, worker_thread);
            return;
        }

        shared_total += 1;

        if (!chaos::il2cpp::runtime_core::MonitorExit(gate)) {
            abi->thread_detach(runtime, worker_thread);
            return;
        }

        worker_root_count =
            chaos::il2cpp::runtime_core::ReportThreadRoot(runtime, worker_thread, &worker_root, sizeof(worker_root));
        if (worker_root_count != 1u) {
            abi->thread_detach(runtime, worker_thread);
            return;
        }

        if (!chaos::il2cpp::runtime_core::GcSafepoint(runtime, worker_thread)) {
            abi->thread_detach(runtime, worker_thread);
            return;
        }

        worker_ok = true;
        abi->thread_detach(runtime, worker_thread);
    });
    worker.join();

    if (!worker_ok || worker_slot != 1 || worker_root_count != 1u) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if (shared_total != 2) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if (!chaos::il2cpp::runtime_core::EnqueueFinalizer(runtime, gate, &{{ stub_name }}_RecordFinalizer)) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if (chaos::il2cpp::runtime_core::DrainFinalizerQueue(runtime) != 1u) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    if ({{ stub_name }}_g_finalized_count.load() != 1) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    void* message = abi->string_new_utf8(runtime, thread, {{ expected_output }}, {{ expected_output_byte_count }}u);
    if (message == nullptr) {
        return CHAOS_BRIDGE_STATUS_INTERNAL_ERROR;
    }

    return write_line_string(runtime, thread, message);
}
