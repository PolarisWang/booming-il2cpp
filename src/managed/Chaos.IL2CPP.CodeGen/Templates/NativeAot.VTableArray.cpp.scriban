{{ indentation }}{{ tab }}CHAOS_IL2CPP_UINT64_C({{ entry.stable_id }}),
{{ indentation }}{{ tab }}{{ entry.symbol }},
{{ indentation }}{{ tab }}{{ entry.count }}u), 0);
{{~ end ~}}
