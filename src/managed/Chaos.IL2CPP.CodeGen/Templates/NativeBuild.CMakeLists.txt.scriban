cmake_minimum_required(VERSION 3.20)
set(CMAKE_CXX_FLAGS_INIT "/DWIN32 /D_WINDOWS")
set(CMAKE_MSVC_EXCEPTION_HANDLING "Sync")
project(chaos_gen LANGUAGES CXX)

set(REPO_ROOT "{{ repo_root }}")
set(CHAOS_GEN_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(NATIVE_LIB_DIR "{{ native_lib_dir }}")
set(CFG "{{ build_config }}")

set(NATIVE_LIBS
{{~ for lib in native_libs ~}}
    "${NATIVE_LIB_DIR}/{{ lib }}"
{{~ end ~}}
)

set(COMMON_INCLUDE_DIRS
{{~ for dir in include_dirs ~}}
    "${REPO_ROOT}/{{ dir }}"
{{~ end ~}}
)

set(COMMON_COMPILE_OPTIONS "{{ compile_options }}")

{{~ for asm in assemblies ~}}
# Assembly: {{ asm.name }}
add_library({{ asm.target }} STATIC
{{~ for src in asm.sources ~}}
    {{ src }}
{{~ end ~}}
)

target_include_directories({{ asm.target }} PUBLIC ${COMMON_INCLUDE_DIRS})
target_compile_features({{ asm.target }} PUBLIC cxx_std_20)
target_compile_options({{ asm.target }} PUBLIC ${COMMON_COMPILE_OPTIONS})

{{~ end ~}}

# Entry executable — links generated code + native runtime
add_executable({{ target_name }}
{{~ for src in extra_sources ~}}
    {{ src }}
{{~ end ~}}
)

target_link_libraries({{ target_name }} PRIVATE
{{~ for t in static_targets ~}}
    {{ t }}
{{~ end ~}}
    ${NATIVE_LIBS}
)

target_include_directories({{ target_name }} PRIVATE ${COMMON_INCLUDE_DIRS})
target_compile_options({{ target_name }} PRIVATE ${COMMON_COMPILE_OPTIONS})