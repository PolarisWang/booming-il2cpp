<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- dotnet tool metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>chaos-il2cpp</ToolCommandName>
    <PackageId>chaos-il2cpp</PackageId>
    <PackageDescription>chaos-il2cpp - IL2CPP toolchain CLI. Translates .NET assemblies to C++ and produces native executables.</PackageDescription>
    <PackageTags>il2cpp;native;aot;codegen</PackageTags>
    <PackageProjectUrl>https://github.com/PolarisWang/booming-il2cpp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PolarisWang/booming-il2cpp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Chaos.IL2CPP.Driver.Tests" />
    <InternalsVisibleTo Include="Chaos.IL2CPP.Tools.TestProjectGenerator" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chaos.IL2CPP.Generator\Chaos.IL2CPP.Generator.csproj" />
    <ProjectReference Include="..\Chaos.IL2CPP.Contracts\Chaos.IL2CPP.Contracts.csproj" />
    <ProjectReference Include="..\Chaos.IL2CPP.Diagnostics\Chaos.IL2CPP.Diagnostics.csproj" />
    <ProjectReference Include="..\Chaos.IL2CPP.ProjectGraph\Chaos.IL2CPP.ProjectGraph.csproj" />
    <ProjectReference Include="..\Chaos.IL2CPP.Pipeline\Chaos.IL2CPP.Pipeline.csproj" />
  </ItemGroup>
</Project>
