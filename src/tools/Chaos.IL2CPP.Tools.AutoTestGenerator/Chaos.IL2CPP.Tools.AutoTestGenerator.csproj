<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chaos.IL2CPP.Tools.AutoTestGenerator</AssemblyName>
    <RootNamespace>Chaos.IL2CPP.Tools.AutoTestGenerator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="output/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The exception-reproduction whitelist (TestEmitter.ExceptionReproductionTable)
         is internal, so the guard test that asserts every entry names a real native
         symbol and a non-overlapping method set can reach it. -->
    <InternalsVisibleTo Include="Chaos.IL2CPP.Tools.AutoTestGenerator.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Chaos.IL2CPP.Tools.ApiSurfaceScanner\Chaos.IL2CPP.Tools.ApiSurfaceScanner.csproj" />
    <ProjectReference Include="..\..\managed\Chaos.IL2CPP.Generator\Chaos.IL2CPP.Generator.csproj" />
  </ItemGroup>
</Project>
