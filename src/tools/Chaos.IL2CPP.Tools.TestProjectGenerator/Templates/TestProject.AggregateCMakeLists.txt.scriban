cmake_minimum_required(VERSION 3.20)
project({{ assembly_name }} CXX)
set(CMAKE_CXX_STANDARD 20)

# ── Compiler settings ──
if(MSVC)
  add_compile_options(/utf-8 /GS- /FS /bigobj /wd4716 /MP)
  set(CHAOS_EHA_FLAG "/EHa")
  set(CHAOS_FORCE_MULTIPLE /FORCE:MULTIPLE)
else()
  add_compile_options(-Wall -Wextra -Wno-unused-parameter -fpermissive)
  set(CHAOS_EHA_FLAG -fexceptions)
  set(CHAOS_FORCE_MULTIPLE "-Wl,--allow-multiple-definition")
endif()

# ── Config tier ──
if(NOT DEFINED CHAOS_IL2CPP_CONFIG_TIER)
  set(CHAOS_IL2CPP_CONFIG_TIER "{{ config_tier }}")
endif()
# Config defines — common to all chunks
if(CHAOS_IL2CPP_CONFIG_TIER STREQUAL "profile")
  add_compile_definitions(CHAOS_IL2CPP_CONFIG_TIER={{ defines.config_tier_value }})
  add_compile_definitions({{ defines.config_tier_macro }})
  add_compile_definitions(CHAOS_IL2CPP_LOG_LEVEL={{ defines.log_level }})
  add_compile_definitions(CHAOS_IL2CPP_RUNTIME_CONFIG_FILE="runtime-config/desktop.h")
  add_compile_definitions(CHAOS_IL2CPP_PROFILE_ENABLED=1)
elseif(CHAOS_IL2CPP_CONFIG_TIER STREQUAL "ship")
  add_compile_definitions(CHAOS_IL2CPP_CONFIG_TIER={{ defines.config_tier_value }})
  add_compile_definitions({{ defines.config_tier_macro }})
  add_compile_definitions(CHAOS_IL2CPP_LOG_LEVEL={{ defines.log_level }})
  add_compile_definitions(CHAOS_IL2CPP_RUNTIME_CONFIG_FILE="runtime-config/desktop.h")
else()
  add_compile_definitions(CHAOS_IL2CPP_CONFIG_TIER={{ defines.config_tier_value }})
  add_compile_definitions({{ defines.config_tier_macro }})
  add_compile_definitions(CHAOS_IL2CPP_LOG_LEVEL={{ defines.log_level }})
  add_compile_definitions(CHAOS_IL2CPP_RUNTIME_CONFIG_FILE="runtime-config/test-only.h")
endif()

{{ if is_jit }}
add_compile_definitions(CHAOS_IL2CPP_JIT_MODE)
{{ end }}

add_compile_definitions(CHAOS_IL2CPP_HAS_TIER_MANAGER=1)

if(NOT DEFINED CHAOS_IL2CPP_VERIFICATION_ENABLED)
  set(CHAOS_IL2CPP_VERIFICATION_ENABLED "{{ verification_enabled }}")
endif()
add_compile_definitions(CHAOS_IL2CPP_VERIFICATION_ENABLED=${CHAOS_IL2CPP_VERIFICATION_ENABLED})

# ── Shared paths (cache variables used by subdirectory CMakeLists) ──
# The first chunk's native dir serves as the SDK reference for all chunks.
# Subdirectory CMakeLists use these as cached parent variables.
set(CHAOS_FOUNDATION_DIR "${CMAKE_CURRENT_SOURCE_DIR}" CACHE INTERNAL "")
set(CHAOS_SDK_DIR "${CMAKE_CURRENT_SOURCE_DIR}/{{ first_chunk_slug }}/native/codegen" CACHE INTERNAL "")
set(CHAOS_PROJECT_ROOT "{{ project_root }}" CACHE INTERNAL "")
set(CHAOS_CODEGEN_DIR "${CMAKE_CURRENT_SOURCE_DIR}/{{ first_chunk_slug }}/native/codegen" CACHE INTERNAL "")

# Find chaos SDK once for all chunks
find_package(chaos REQUIRED PATHS "${CHAOS_SDK_DIR}")

