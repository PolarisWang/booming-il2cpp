// runtime-patchdata.cpp — Auto-generated
// Provides kPatchData[], kPatchDataSize, kPatchDataHostClassName
// plus sentinel kPatchDataHost{Namespace,TypeNames,MethodNames,Count}.
// Sentinel: no embedded patch data (default state for TPG builds).
// The hotupdate pipeline replaces this file with real embedded patch data
// and triggers an incremental cmake rebuild.
#include <cstddef>
#include <cstdint>

// Weak linkage sentinel symbols allow patch-host-arrays.cpp (generated by the
// hotupdate pipeline) to override these with strong definitions at link time.
// MSVC: __declspec(selectany) makes the sentinel a COMDAT that the linker
// can discard when a non-selectany definition exists from patch-host-arrays.cpp.
// GCC/Clang: __attribute__((weak)) creates a true weak symbol.
#ifdef __GNUC__
#define CHAOS_SENTINEL_WEAK __attribute__((weak))
#elif defined(_MSC_VER)
#define CHAOS_SENTINEL_WEAK __declspec(selectany)
#else
#define CHAOS_SENTINEL_WEAK
#endif

// ── Sentinel (no embedded patch data) ──
extern const uint8_t kPatchData[1] = { 0 };
extern const size_t kPatchDataSize = 0;
extern const char* const kPatchDataHostClassName = nullptr;

// Per-method host arrays are defined in patch-host-arrays.cpp (generated by
// the TPG and later regenerated by the hotupdate pipeline).  This file
// deliberately omits them to avoid duplicate-definition linker conflicts.
// The kPatchDataHost* symbols are always provided by patch-host-arrays.cpp.
