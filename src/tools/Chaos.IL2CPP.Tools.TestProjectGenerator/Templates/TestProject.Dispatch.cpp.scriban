    CHAOS_IL2CPP_INT32 failures = 0;
    for (int32_t si = 0; si < kSubjectEntryCount; si++) {
        int32_t i = kSubjectSlotMap[si];
        try {
            ChaosDispatchMethod(entries, kAotMethodCount, i, CHAOS_DISPATCH_THUNKS);
