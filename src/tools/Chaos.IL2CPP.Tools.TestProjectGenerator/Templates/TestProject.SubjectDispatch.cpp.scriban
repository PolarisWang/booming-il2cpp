// Direct dispatch table for fact verification.
// Bypasses hotpatch dispatch to avoid MSVC SEH RAX clobbering.

#include <cstdint>
#include <cstddef>
#include "subject_dispatch.h"

// Direct dispatch table — {{ fact_count }} entries
// Function pointers cast from the hotpatch entries to avoid name mismatch.

// Minimal HotpatchEntryV0 definition (stable ABI from codegen_bridge.h).
// Avoids pulling in <chaos/hotpatch_dispatch.h> which has transitive include
// dependencies (CHAOS_IL2CPP_LIKELY from compiler_hints.h, etc.).
struct HotpatchEntryV0 {
    void*       direct_ptr;
    void*       interrupt_ptr;
    uintptr_t   method_key;
    uint32_t    flags;
    uint32_t    version;
};

extern "C" const HotpatchEntryV0* GetHotpatchEntries() noexcept;
extern "C" const int kSubjectSlotMap[];
extern "C" const int kSubjectEntryCount;

static int64_t (*GetSubjectDirect(int si))(int64_t) {
    if (si < 0 || si >= {{ fact_count }}) return nullptr;
    int i = kSubjectSlotMap[si];
    auto* entries = GetHotpatchEntries();
    if (!entries || !entries[i].direct_ptr) return nullptr;
    return reinterpret_cast<int64_t(*)(int64_t)>(entries[i].direct_ptr);
}

int64_t SubjectDispatchDirect(int si, int64_t arg0) {
    auto fn = GetSubjectDirect(si);
    if (!fn) return 0;
    try {
        return fn(arg0);
    } catch (...) {
        return 0;
    }
}
