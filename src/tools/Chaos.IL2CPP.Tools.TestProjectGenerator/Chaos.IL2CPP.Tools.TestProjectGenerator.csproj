<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chaos.IL2CPP.Tools.TestProjectGenerator</AssemblyName>
    <RootNamespace>Chaos.IL2CPP.Tools.TestProjectGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\managed\Chaos.IL2CPP.Driver\Chaos.IL2CPP.Driver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*.scriban">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Copy Scriban templates from Generator project to TPG output -->
  <Target Name="CopyGeneratorTemplates" AfterTargets="Build">
    <ItemGroup>
      <_GeneratorTemplates Include="..\..\managed\Chaos.IL2CPP.Generator\Templates\**\*.scriban" />
    </ItemGroup>
    <Copy SourceFiles="@(_GeneratorTemplates)"
          DestinationFolder="$(OutDir)Templates\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
