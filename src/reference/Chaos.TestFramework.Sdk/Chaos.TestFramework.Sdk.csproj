<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>Chaos.TestFramework.Sdk</AssemblyName>
    <RootNamespace>Chaos.TestFramework</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Chaos.TestFramework.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>Chaos IL2CPP Test Framework SDK — assertion and test infrastructure for managed verification families.</Description>
    <Authors>Chaos IL2CPP</Authors>
    <PackageProjectUrl>https://github.com/chaos-il2cpp</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/chaos-il2cpp</RepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\..\testing\_packages\</PackageOutputPath>
    <!--
      VERIFY must be defined here, in the SDK's OWN compilation.

      Every assertion in Assert.cs carries [Conditional("VERIFY")] — and so does
      Assert.Fail itself.  [Conditional] is evaluated at the CALL SITE's compile
      unit, so when this assembly was compiled without VERIFY, the compiler
      deleted every `Fail(...)` call INSIDE the assertion bodies.  What shipped
      was `if (expected != actual) { /* empty */ }` — the assertions could never
      fail, never threw, and never set s_exitCode.

      Verified by disassembling the built DLL: Assert.AreEqual(int,int) has
      Code size 13, ending in `brfalse.s IL_000c` followed directly by `ret`,
      with no `call Fail` anywhere.

      Defining VERIFY here (not just in the generated subjects csproj, which
      already does) is what makes the assertion bodies non-empty.  Without it,
      no amount of downstream work — removing inline shapes, reading
      Assert_Complete(), adding counters — can observe an assertion failure.
    -->
    <DefineConstants>$(DefineConstants);VERIFY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Chaos.TestFramework.Runtime</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
