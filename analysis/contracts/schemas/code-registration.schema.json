{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis/contracts/schemas/code-registration.schema.json",
  "title": "code-registration v0",
  "description": "code registration 的最小 contract，冻结 module 与 registration 条目的定位字段，用于表达代码侧注册结果。",
  "type": "object",
  "required": [
    "formatVersion",
    "artifactKind",
    "modules"
  ],
  "properties": {
    "formatVersion": {
      "const": "v0"
    },
    "artifactKind": {
      "const": "codeRegistration"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "moduleName",
          "registrations"
        ],
        "properties": {
          "moduleName": {
            "type": "string",
            "minLength": 1
          },
          "registrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "registrationKind",
                "slot",
                "symbol",
                "subjectId"
              ],
              "properties": {
                "registrationKind": {
                  "type": "string",
                  "enum": [
                    "methodPointer",
                    "invoker",
                    "reversePInvoke",
                    "genericMethodPointer"
                  ]
                },
                "slot": {
                  "type": "integer",
                  "minimum": 0
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "subjectId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
