{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/artifacts/v0/schemas/metadata-graph.schema.json",
  "title": "metadata-graph v0",
  "description": "metadata graph 的最小稳定骨架。只冻结顶层版本、产物类型以及 assembly、type、member 的主层级，不冻结更细的元数据细节。",
  "type": "object",
  "required": [
    "formatVersion",
    "artifactKind",
    "assemblies"
  ],
  "properties": {
    "formatVersion": {
      "const": "v0",
      "description": "顶层 contract 版本固定为 v0。"
    },
    "artifactKind": {
      "const": "metadataGraph",
      "description": "稳定产物标识。"
    },
    "assemblies": {
      "type": "array",
      "description": "按程序集分组的元数据骨架。",
      "items": {
        "type": "object",
        "required": [
          "assemblyName",
          "types"
        ],
        "properties": {
          "assemblyName": {
            "type": "string",
            "minLength": 1
          },
          "types": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "typeName"
              ],
              "properties": {
                "typeName": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "memberKind",
                      "memberName"
                    ],
                    "properties": {
                      "memberKind": {
                        "type": "string",
                        "enum": [
                          "method",
                          "field",
                          "property",
                          "event",
                          "nestedType",
                          "custom"
                        ]
                      },
                      "memberName": {
                        "type": "string",
                        "minLength": 1
                      },
                      "signature": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
