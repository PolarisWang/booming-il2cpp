{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native Reference Runtime Skeleton Coverage v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "artifactKind", "assemblyName", "planKind",
    "translationUnitMode", "requestedMethodCount", "emittedMethodCount",
    "uncoveredMethodCount", "uncoveredMethodSubjectIds"
  ],
  "properties": {
    "formatVersion": { "type": "string" },
    "artifactKind": { "type": "string", "const": "nativeReferenceRuntimeSkeletonCoverage" },
    "assemblyName": { "type": "string" },
    "planKind": { "type": "string", "const": "assembly-full-closure-runtime-skeleton" },
    "translationUnitMode": { "type": "string", "const": "runtime-skeleton" },
    "requestedMethodCount": { "type": "integer" },
    "emittedMethodCount": { "type": "integer" },
    "uncoveredMethodCount": { "type": "integer" },
    "uncoveredMethodSubjectIds": { "type": "array" }
  }
}
