{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/artifacts/v0/schemas/optimization-facts.schema.json",
  "title": "optimization-facts v0",
  "description": "Linker to CodeGen optimization-facing closed-world facts.",
  "type": "object",
  "required": [
    "formatVersion",
    "artifactKind",
    "closedWorldSpecializations",
    "dispatchFacts",
    "layoutFacts",
    "exceptionFacts"
  ],
  "properties": {
    "formatVersion": {
      "const": "v0"
    },
    "artifactKind": {
      "const": "optimizationFacts"
    },
    "closedWorldSpecializations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subjectKind",
          "subjectId",
          "reason"
        ],
        "properties": {
          "subjectKind": {
            "type": "string",
            "minLength": 1
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "dispatchFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "methodSubjectId",
          "dispatchKind",
          "targetSubjectId"
        ],
        "properties": {
          "methodSubjectId": {
            "type": "string",
            "minLength": 1
          },
          "dispatchKind": {
            "type": "string",
            "minLength": 1
          },
          "targetSubjectId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "layoutFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subjectKind",
          "subjectId",
          "dataKind"
        ],
        "properties": {
          "subjectKind": {
            "type": "string",
            "minLength": 1
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "dataKind": {
            "type": "string",
            "minLength": 1
          },
          "elementType": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "exceptionFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "methodSubjectId",
          "handlingKind"
        ],
        "properties": {
          "methodSubjectId": {
            "type": "string",
            "minLength": 1
          },
          "handlingKind": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
