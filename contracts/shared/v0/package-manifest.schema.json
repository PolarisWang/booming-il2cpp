{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chaos Shared Hot Update Package Manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "packageId",
    "targetAotVersion",
    "assemblies",
    "supplementalMetadata",
    "signature"
  ],
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "v0"
    },
    "packageId": {
      "type": "string"
    },
    "targetAotVersion": {
      "type": "string"
    },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "hash",
          "size",
          "entryPoint"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "entryPoint": {
            "type": "string"
          }
        }
      }
    },
    "supplementalMetadata": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    }
  }
}
