{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "packageId", "targetAotVersion", "assemblies",
    "supplementalMetadata", "signature"
  ],
  "properties": {
    "formatVersion": { "type": "string", "const": "v0" },
    "packageId": { "type": "string" },
    "targetAotVersion": { "type": "string" },
    "assemblies": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "supplementalMetadata": { "type": "string" },
    "signature": { "type": "string" }
  }
}
