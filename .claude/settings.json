{
  "promptTemplate": [
    ".ai/skills/discovery/skill-index.md",
    ".ai/skills/discovery/expert-registry.json",
    "wiki/INDEX.md"
  ],
  "projectPrompt": "",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Skill|Workflow",
        "hooks": [
          {
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/skills/hooks/check_classification.py\"",
            "statusMessage": "Checking classification...",
            "timeout": 2,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|Glob|Grep|Read|Skill",
        "hooks": [
          {
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/skills/hooks/hook_track_all.py\"",
            "statusMessage": "Tracking tool outcome + skill usage...",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/skills/hooks/hook_evaluate_session.py\"",
            "statusMessage": "Evaluating session quality + evolution...",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "python \"$(git rev-parse --show-toplevel)/.ai/skills/hooks/hook_track_session_outcomes.py\"",
            "statusMessage": "Recording session outcome...",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ]
  }
}
