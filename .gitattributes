# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.c text diff=cpp
*.h text diff=cpp
*.cpp text diff=cpp
*.hpp text diff=cpp

# SIMD stubs must stay LF (MSVC C2733 sensitivity to CRLF in extern "C" noexcept blocks)
src/native/runtime-core/runtime_stubs/simd_stubs.cpp text eol=lf
src/native/runtime-core/runtime_stubs/simd_stubs.h text eol=lf
*.cs text diff=csharp
*.py text diff=python
*.xml text
*.json text
*.yaml text
*.yml text
*.md text
*.cmake text
*.txt text
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.obj binary
*.lib binary
*.dll binary
*.exe binary
*.pdb binary

# Git LFS (recommended for large binary assets)
# *.dll filter=lfs diff=lfs merge=lfs -text
# *.exe filter=lfs diff=lfs merge=lfs -text
# *.pdb filter=lfs diff=lfs merge=lfs -text
# *.lib filter=lfs diff=lfs merge=lfs -text