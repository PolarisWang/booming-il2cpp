<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <ExcludeByFile>**/obj/**/*.cs,**/ReferenceProof/**/*.cs,**/PatchData*.cs,**/NativeReferenceProofEmitter*.cs,**/RuntimeSkeleton*.cs,**/NativeReferenceLoweringPlanner.PlanBuilders*.cs,**/NativeReferenceLoweringPlanner.GeneratedPluginExports*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
